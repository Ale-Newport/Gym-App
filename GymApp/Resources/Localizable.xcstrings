    "onboarding.result.nutrition.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A starting point. It adjusts as your weight trend moves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto de partida. Se ajusta según se mueva tu tendencia de peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un point de départ. Il s’ajuste à mesure que ta tendance de poids évolue."
