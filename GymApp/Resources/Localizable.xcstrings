    "nutritionLibrary.food.deleteBlockedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld saved meal or recipe uses this food. Without it, that one cannot work out its own nutrition."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
