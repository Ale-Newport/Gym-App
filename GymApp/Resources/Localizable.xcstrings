    "settings.goals.emptyExplainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "With nothing chosen, Forge plans for general fitness."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin nada elegido, Forge planifica para forma física general."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans rien de choisi, Forge planifie pour une forme générale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ न चुनने पर Forge सामान्य फ़िटनेस के लिए योजना बनाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza nulla di scelto, Forge pianifica per la forma generale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey seçilmezse Forge genel form için plan yapar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有选择目标时，Forge 会按一般健身来规划。"
          }
        }
      }
    },
    "settings.goals.experience": {
      "extractionState": "manual",
      "localizations": {
        "en": {
