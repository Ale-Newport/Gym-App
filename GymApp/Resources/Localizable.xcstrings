    "home.today.noProgramMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tell Forge nothing more than you already have — it will lay out your week from your goals, equipment and available days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hace falta que le cuentes a Forge nada más de lo que ya sabe: montará tu semana con tus objetivos, tu material y tus días disponibles."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n’as rien de plus à dire à Forge que ce que tu as déjà donné — il construira ta semaine à partir de tes objectifs, de ton matériel et de tes jours disponibles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge को इससे ज़्यादा कुछ बताने की ज़रूरत नहीं — यह आपके लक्ष्यों, इक्विपमेंट और उपलब्ध दिनों से आपका हफ़्ता तैयार कर देगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A Forge basta quello che gli hai già detto: comporrà la settimana dai tuoi obiettivi, dall'attrezzatura e dai giorni disponibili."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 알려 준 것만으로 충분해요. 목표와 장비, 가능한 요일로 한 주를 짜 드릴게요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge nie potrzebuje niczego więcej, niż już podałeś — ułoży Twój tydzień z celów, sprzętu i dostępnych dni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge'a fazladan bir şey söylemene gerek yok — haftanı hedeflerinden, ekipmanından ve uygun günlerinden kurar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不用再补充什么，Forge 会用你的目标、器械和可用日子安排好这一周。"
          }
        }
      }
    },
