    "nutritionLog.scanner.createMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the food yourself and the barcode is saved with it, so the next scan finds it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tú el alimento y el código de barras se guarda con él, así el próximo escaneo lo encontrará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute l’aliment toi-même et le code-barres sera enregistré avec lui, pour que le prochain scan le retrouve."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ूड खुद जोड़ दें, बारकोड उसके साथ सेव हो जाएगा, ताकि अगली बार स्कैन करने पर वह मिल जाए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi tu l'alimento e il codice a barre viene salvato con lui, così la prossima scansione lo trova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 추가하면 바코드가 함께 저장돼서 다음 스캔부터 바로 찾아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj produkt samodzielnie, a kod kreskowy zapisze się razem z nim — kolejne skanowanie go znajdzie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besini kendin ekle; barkod da onunla kaydedilsin, bir dahaki okutmada bulunsun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自己把食物添加进来，条形码会一起保存，下次扫描就能找到它。"
          }
        }
      }
    },
