    "program.editor.deleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session and the exercises in it are removed from this program. Workouts you have already logged are not affected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión y sus ejercicios se quitan de este programa. Los entrenamientos que ya registraste no se ven afectados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La séance et les exercices qu’elle contient sont retirés de ce programme. Les séances que tu as déjà enregistrées ne sont pas touchées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेशन और उसकी एक्सरसाइज़ इस प्रोग्राम से हट जाएँगी। पहले दर्ज किए गए वर्कआउट पर कोई असर नहीं पड़ेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione e gli esercizi che contiene vengono rimossi da questo programma. Gli allenamenti già registrati non vengono toccati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션과 그 안의 운동이 이 프로그램에서 사라져요. 이미 기록한 운동은 그대로예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja i jej ćwiczenia znikną z tego programu. Zapisane wcześniej treningi zostają bez zmian."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seans ve içindeki egzersizler bu programdan kaldırılır. Daha önce kaydettiğin antrenmanlar etkilenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这节训练课及其中的动作会从这份计划中移除。已经记录的训练不受影响。"
          }
        }
      }
    },
    "program.editor.deleteProgramMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The program and its version history are removed. Workouts you logged from it are kept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El programa y su historial de versiones se eliminan. Los entrenamientos que registraste con él se conservan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le programme et son historique de versions sont supprimés. Les séances que tu as enregistrées à partir de lui sont conservées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोग्राम और उसकी वर्शन हिस्ट्री हट जाएगी। इससे दर्ज किए गए वर्कआउट बने रहेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il programma e la sua cronologia delle versioni vengono rimossi. Gli allenamenti che hai registrato restano."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로그램과 버전 기록이 사라져요. 이 프로그램으로 기록한 운동은 그대로 남아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Program i jego historia wersji zostaną usunięte. Treningi zapisane na jego podstawie zostają."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Program ve sürüm geçmişi kaldırılır. Ondan kaydettiğin antrenmanlar korunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练计划及其版本历史会被移除。你依据它记录的训练会保留。"
          }
        }
      }
    },
