    "active.substitute.equipmentFailedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The equipment change could not be saved. Try again, or swap the exercise for today only."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar el cambio de material. Inténtalo de nuevo, o cambia el ejercicio solo por hoy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le changement de matériel n’a pas pu être enregistré. Réessaie, ou remplace l’exercice pour aujourd’hui seulement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इक्विपमेंट का बदलाव सेव नहीं हो सका। फिर कोशिश करें, या एक्सरसाइज़ सिर्फ़ आज के लिए बदल लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile salvare la modifica all'attrezzatura. Riprova, oppure sostituisci l'esercizio solo per oggi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存器械变更。请重试，或只替换今天的动作。"
          }
        }
      }
    },
