    "settings.health.privacy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health data is read into memory to work out what is on screen. It is never sent anywhere, and Forge has no account and no server."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los datos de Salud se leen en memoria para calcular lo que ves en pantalla. Nunca se envían a ninguna parte, y Forge no tiene cuenta ni servidor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données Santé sont lues en mémoire pour calculer ce qui s’affiche à l’écran. Elles ne sont envoyées nulle part, et Forge n’a ni compte ni serveur."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्क्रीन पर क्या दिखाना है, यह तय करने के लिए Health डेटा मेमोरी में पढ़ा जाता है। यह कहीं नहीं भेजा जाता, और Forge का न कोई अकाउंट है न सर्वर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I dati di Salute vengono letti in memoria per calcolare quello che vedi a schermo. Non vengono mai inviati da nessuna parte, e Forge non ha né account né server."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlık verileri, ekranda ne olacağını hesaplamak için belleğe okunur. Hiçbir yere gönderilmez; Forge'un hesabı da sunucusu da yoktur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康数据只会读入内存，用于计算屏幕上的内容。它不会被发送到任何地方，Forge 也没有账号和服务器。"
          }
        }
      }
    },
