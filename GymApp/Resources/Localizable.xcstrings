          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी किसी सर्वर से नहीं आता। Forge के पास न पुश सेवा है, न रिमोट नोटिफ़िकेशन।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non arriva nulla da un server. Forge non ha un servizio push né notifiche remote."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey sunucudan gelmez. Forge'un push servisi ve uzak bildirimi yoktur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有任何内容来自服务器。Forge 没有推送服务，也没有远程通知。"
          }
        }
      }
    },
