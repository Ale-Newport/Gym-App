    "onboarding.step.experience.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This sets how hard and how varied your first block is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto marca lo duro y lo variado que será tu primer bloque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela définit la difficulté et la variété de ton premier bloc."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे तय होता है कि आपका पहला ब्लॉक कितना कठिन और कितना विविध होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da qui dipende quanto sarà impegnativo e vario il tuo primo blocco."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "첫 블록의 강도와 다양성을 정해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ustala, jak ciężki i jak urozmaicony będzie Twój pierwszy blok."
