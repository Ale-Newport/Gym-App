    "onboarding.availability.cardio.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Whether conditioning goes with your lifting or on its own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si el acondicionamiento va con las pesas o por su cuenta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si le cardio accompagne ta musculation ou se fait à part."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंडीशनिंग आपकी लिफ़्टिंग के साथ चले या अलग से।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se il condizionamento va insieme ai pesi o per conto suo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "컨디셔닝을 웨이트와 함께 할지, 따로 할지 정해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Czy kondycja idzie razem z siłowym, czy osobno."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kondisyon çalışması ağırlık antrenmanınla mı yoksa ayrı mı olsun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有氧是跟着力量训练做，还是单独安排。"
          }
        }
      }
    },
