            "value": "%@ par jour actuellement, %@ par jour si tu acceptes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी रोज़ %@, मंज़ूर करने पर रोज़ %@।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ora %@ al giorno, %@ al giorno se accetti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금은 하루 %@, 받아들이면 하루 %@이 돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Teraz %@ dziennie, %@ dziennie po akceptacji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu an günde %@, kabul edersen günde %@."
          }
        },
        "zh-Hans": {
