          }
        }
      }
    },
    "food.error.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The food service could not be reached. Showing offline results."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido conectar con el servicio de alimentos. Mostrando resultados sin conexión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d’aliments n’a pas pu être joint. Affichage des résultats hors ligne."
          }
