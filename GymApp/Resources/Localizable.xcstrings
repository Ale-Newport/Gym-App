            "value": "जैसा चल रहा है वैसा ही रखें"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Continua così"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금대로 유지"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rób dalej to, co robisz"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Böyle devam et"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持现在的做法"
          }
        }
      }
    },
    "nutrition.adjustAction.increase": {
      "extractionState": "manual",
      "localizations": {
