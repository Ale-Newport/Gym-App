    "program.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge can build one from your goals, your schedule and the equipment you have. Every part of it stays yours to change afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge puede montar uno con tus objetivos, tu horario y el material que tienes. Después, todo sigue siendo tuyo para cambiarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge peut en construire un à partir de tes objectifs, de ton emploi du temps et du matériel dont tu disposes. Chaque partie reste ensuite modifiable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge आपके लक्ष्यों, शेड्यूल और इक्विपमेंट से एक प्रोग्राम बना सकता है। उसका हर हिस्सा बाद में आपके बदलने के लिए खुला रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge può costruirne uno dai tuoi obiettivi, dai tuoi impegni e dall'attrezzatura che hai. Ogni sua parte resta tua da cambiare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge가 목표와 일정, 가진 장비로 만들어 드릴 수 있어요. 만든 뒤에도 무엇이든 바꿀 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge zbuduje go z Twoich celów, grafiku i sprzętu, jaki masz. Każdy element zostaje potem do Twojej zmiany."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge; hedeflerine, takvimine ve ekipmanına göre bir program kurabilir. Sonrasında her parçasını değiştirmek sana kalmış."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge 可以根据你的目标、日程和现有器械生成一份。生成之后，每一部分你都能自己改。"
          }
        }
      }
    },
