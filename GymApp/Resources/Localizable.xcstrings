    "onboarding.availability.length.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most time you have in one session, rest between sets included."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El máximo tiempo que tienes en una sesión, descansos entre series incluidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le temps maximum dont tu disposes pour une séance, repos entre les séries compris."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सेशन में आपके पास ज़्यादा से ज़्यादा कितना समय है, सेट के बीच के आराम सहित।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tempo massimo che hai in una sessione, recupero tra le serie incluso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세트 사이 휴식을 포함해 한 번에 쓸 수 있는 최대 시간이에요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najwięcej czasu, jaki masz na jedną sesję, razem z przerwami między seriami."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Setler arası dinlenme dahil, bir seansa ayırabileceğin en fazla süre."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一次训练最多能用多少时间，包含组间休息。"
          }
        }
      }
    },
    "onboarding.availability.length.short": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Short sessions work well. Expect fewer exercises in each one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones cortas funcionan bien. Espera menos ejercicios en cada una."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séances courtes fonctionnent bien. Attends-toi à moins d’exercices dans chacune."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छोटे सेशन भी अच्छे चलते हैं। हर सेशन में कम एक्सरसाइज़ रहेंगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni brevi funzionano bene. Aspettati meno esercizi in ciascuna."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "짧은 세션도 충분히 좋아요. 대신 한 세션에 들어가는 운동 수가 줄어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Krótkie sesje działają dobrze. Licz się z mniejszą liczbą ćwiczeń w każdej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısa seanslar iyi işler. Her birinde daha az egzersiz olacağını bekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短时训练同样有效，只是每次的动作会少一些。"
          }
        }
      }
    },
