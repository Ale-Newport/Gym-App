    "progress.weight.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weigh yourself at the same time of day — first thing, before eating — and the trend becomes readable within a fortnight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pésate siempre a la misma hora —nada más levantarte, antes de comer— y en un par de semanas la tendencia ya se lee."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pèse-toi au même moment de la journée — au réveil, à jeun — et la tendance devient lisible en une quinzaine de jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर दिन एक ही समय पर वज़न लें — सुबह उठते ही, कुछ खाने से पहले — और दो हफ़्तों में ट्रेंड पढ़ने लायक हो जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesati sempre alla stessa ora — appena sveglio, prima di mangiare — e la tendenza diventa leggibile nel giro di due settimane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendini günün aynı saatinde tart — sabah ilk iş, aç karnına — trend iki hafta içinde okunur hâle gelir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天在同一时间称重，起床后、进食前，两周左右趋势就能看清了。"
          }
        }
      }
    },
