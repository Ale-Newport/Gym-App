    "nutritionLibrary.food.gramsPerPieceHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used when you log this food by the piece. Leave it blank if it does not come in pieces."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa cuando registras este alimento por unidades. Déjalo en blanco si no viene por unidades."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé quand tu enregistres cet aliment à la pièce. Laisse vide s’il ne se compte pas en pièces."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तब काम आता है जब आप इस फ़ूड को टुकड़ों में दर्ज करते हैं। अगर यह टुकड़ों में नहीं आता तो खाली छोड़ दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato quando registri questo alimento a pezzi. Lascialo vuoto se non si conta a pezzi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 음식을 개수로 기록할 때 써요. 개수로 세지 않는다면 비워 두세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używane, gdy zapisujesz ten produkt na sztuki. Zostaw puste, jeśli nie występuje w sztukach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu besini adetle kaydettiğinde kullanılır. Adetle ölçülmüyorsa boş bırak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按个记录这种食物时会用到。如果它不是按个算的，留空即可。"
