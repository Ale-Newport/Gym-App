    "workoutHub.today.noProgramMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a program and Forge will plan every session, pick the exercises and set the loads for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea un programa y Forge planificará cada sesión, elegirá los ejercicios y te fijará las cargas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construis un programme et Forge planifiera chaque séance, choisira les exercices et fixera les charges pour toi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक प्रोग्राम बनाएँ और Forge हर सेशन तय करेगा, एक्सरसाइज़ चुनेगा और आपके लोड भी सेट करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci un programma e Forge pianificherà ogni sessione, sceglierà gli esercizi e imposterà i carichi per te."
          }
        },
        "zh-Hans": {
          "stringUnit": {
