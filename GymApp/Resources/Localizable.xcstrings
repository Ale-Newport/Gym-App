    "onboarding.summary.ready.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirming saves these answers, makes this your active program and opens the app. Anything here can be changed later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al confirmar se guardan estas respuestas, este pasa a ser tu programa activo y se abre la app. Todo esto se puede cambiar después en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmer enregistre ces réponses, fait de ceci ton programme actif et ouvre l’app. Tout peut être modifié plus tard dans les Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पक्का करने पर ये जवाब सेव होंगे, यह आपका सक्रिय प्रोग्राम बनेगा और ऐप खुल जाएगा। यहाँ की कोई भी बात बाद में Settings में बदली जा सकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Confermando salvi queste risposte, rendi attivo questo programma e apri l'app. Tutto ciò che vedi qui si può cambiare più avanti nelle Impostazioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "확인하면 답변이 저장되고, 이 프로그램이 활성화되면서 앱이 열려요. 여기 있는 내용은 나중에 설정에서 바꿀 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Potwierdzenie zapisuje te odpowiedzi, ustawia ten program jako aktywny i otwiera aplikację. Wszystko tutaj zmienisz później w Ustawieniach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Onaylamak bu yanıtları kaydeder, bunu etkin programın yapar ve uygulamayı açar. Buradaki her şey sonradan Ayarlar'dan değiştirilebilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "确认后会保存这些回答，把它设为你的当前训练计划并进入 App。这里的任何内容之后都能在设置中修改。"
          }
        }
      }
    },
