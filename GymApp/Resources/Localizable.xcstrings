    "program.settings.noDays": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No days are selected. Until you pick some, Forge plans your week around three."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún día seleccionado. Hasta que elijas alguno, Forge planifica tu semana con tres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun jour n’est sélectionné. Tant que tu n’en choisis pas, Forge planifie ta semaine sur trois jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दिन नहीं चुना गया। जब तक आप न चुनें, Forge तीन दिनों के हिसाब से हफ़्ता बनाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai selezionato nessun giorno. Finché non ne scegli qualcuno, Forge pianifica la settimana su tre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택한 요일이 없어요. 고르기 전까지 Forge는 주 3일 기준으로 한 주를 짜요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie wybrano żadnych dni. Dopóki tego nie zrobisz, Forge planuje tydzień na trzy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir gün seçilmedi. Sen seçene kadar Forge haftanı üç güne göre planlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有选择日期。在你选择之前，Forge 会按每周三天安排。"
          }
        }
      }
    },
    "program.settings.noProgramNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have no program yet. These settings are what the first one will be built from."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no tienes ningún programa. Estos ajustes son la base con la que se montará el primero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n’as pas encore de programme. Ces réglages serviront à construire le premier."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास अभी कोई प्रोग्राम नहीं है। पहला प्रोग्राम इन्हीं सेटिंग्स से बनेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora un programma. Queste impostazioni sono quelle da cui verrà costruito il primo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 프로그램이 없어요. 이 설정이 첫 프로그램의 바탕이 돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz jeszcze programu. Z tych ustawień powstanie pierwszy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir programın yok. Bu ayarlar, ilk programın kurulacağı temeldir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有训练计划。第一份计划会依据这些设置生成。"
          }
        }
      }
    },
    "program.settings.prioritiesFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritised groups get extra sets and an earlier slot in the session, taken from the groups you have not prioritised."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los grupos prioritarios reciben series extra y un hueco más temprano en la sesión, a costa de los que no has priorizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les groupes prioritaires reçoivent des séries en plus et une place plus tôt dans la séance, prises sur les groupes non prioritaires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राथमिकता वाले ग्रुप को अतिरिक्त सेट और सेशन में पहले की जगह मिलती है, जो बिना प्राथमिकता वाले ग्रुप से ली जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I gruppi prioritari ricevono serie extra e un posto più avanti nella sessione, prese dai gruppi che non hai reso prioritari."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우선한 그룹은 세트를 더 받고 세션에서 앞자리에 놓여요. 그 몫은 우선하지 않은 그룹에서 가져와요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorytetowe grupy dostają dodatkowe serie i wcześniejsze miejsce w sesji, kosztem grup bez priorytetu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öncelikli gruplar, öncelik vermediğin gruplardan alınan fazladan setleri ve seansta daha erken bir sırayı alır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先肌群会获得更多组数，并被排在训练课更靠前的位置，这些额外组数取自未被优先的肌群。"
          }
        }
      }
    },
    "program.settings.prioritiesMany": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioritising this many groups spreads the extra sets thin. Two or three has more effect."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorizar tantos grupos reparte demasiado las series extra. Con dos o tres se nota más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prioriser autant de groupes dilue les séries supplémentaires. Deux ou trois ont plus d’effet."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इतने ग्रुप को प्राथमिकता देने पर अतिरिक्त सेट बहुत बँट जाते हैं। दो या तीन का असर ज़्यादा होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dare priorità a così tanti gruppi distribuisce le serie extra troppo sottili. Due o tre hanno più effetto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이렇게 많이 우선하면 추가 세트가 얇게 퍼져요. 두세 개일 때 효과가 더 커요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy tylu priorytetach dodatkowe serie rozchodzą się cienko. Dwie lub trzy grupy dają większy efekt."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kadar çok gruba öncelik vermek fazladan setleri inceltir. İki ya da üç grup daha etkili olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先这么多肌群会让额外组数被摊薄。两三个的效果更明显。"
          }
        }
      }
    },
    "program.settings.prioritiesNone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is prioritised, so volume is spread evenly across your muscle groups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada priorizado, así que el volumen se reparte por igual entre tus grupos musculares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est prioritaire, le volume est donc réparti équitablement entre tes groupes musculaires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई प्राथमिकता नहीं है, इसलिए वॉल्यूम आपके मसल ग्रुप में बराबर बँटता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è niente in priorità, quindi il volume è distribuito in modo uniforme tra i gruppi muscolari."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "우선한 그룹이 없어서 볼륨이 근육 그룹에 고르게 나뉘어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic nie ma priorytetu, więc objętość rozkłada się równo na wszystkie grupy mięśniowe."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şeye öncelik verilmedi, bu yüzden hacim kas gruplarına eşit dağıtılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有设置优先级，训练量会均匀分配到各个肌群。"
          }
        }
      }
    },
    "program.settings.progression": {
