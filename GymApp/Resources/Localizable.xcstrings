    "settings.legal.food.usda": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The built-in food database is compiled from USDA FoodData Central. Works of the United States Government are in the public domain, so no licence or credit is required — it is given here anyway."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La base de datos de alimentos integrada se ha compilado a partir de USDA FoodData Central. Las obras del Gobierno de los Estados Unidos son de dominio público, así que no hacen falta licencia ni crédito: se dan aquí de todos modos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base d’aliments intégrée est compilée à partir de USDA FoodData Central. Les œuvres du gouvernement des États-Unis sont dans le domaine public : aucune licence ni mention n’est exigée — elle est donnée ici quand même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बिल्ट-इन फ़ूड डेटाबेस USDA FoodData Central से बनाया गया है। अमेरिकी सरकार के काम सार्वजनिक डोमेन में होते हैं, इसलिए किसी लाइसेंस या श्रेय की ज़रूरत नहीं — फिर भी यहाँ दिया गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il database alimenti integrato è composto a partire da USDA FoodData Central. Le opere del governo degli Stati Uniti sono di pubblico dominio, quindi non serve nessuna licenza né credito: lo diamo comunque."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşik besin veritabanı USDA FoodData Central kaynağından derlenmiştir. Amerika Birleşik Devletleri Hükümeti'nin çalışmaları kamu malıdır, yani lisans ya da künye gerekmez — yine de burada verilmiştir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "内置食物库整理自 USDA FoodData Central。美国政府的作品属于公有领域，无需许可或署名，这里仍然写明。"
          }
        }
      }
    },
    "settings.legal.media.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The thumbnails and animations shown with every exercise are the property of Gym visual, used with permission at their original 180×180 size. This credit must travel with the artwork wherever it appears."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las miniaturas y animaciones que acompañan a cada ejercicio son propiedad de Gym visual y se usan con permiso en su tamaño original de 180×180. Este crédito debe acompañar a las imágenes allá donde aparezcan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les vignettes et animations affichées avec chaque exercice sont la propriété de Gym visual, utilisées avec autorisation à leur taille d’origine de 180×180. Ce crédit doit accompagner les illustrations partout où elles apparaissent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर एक्सरसाइज़ के साथ दिखने वाले थंबनेल और एनिमेशन Gym visual की संपत्ति हैं, जो उनकी अनुमति से मूल 180×180 आकार में इस्तेमाल किए गए हैं। यह श्रेय आर्टवर्क के साथ हर जगह जाना चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le miniature e le animazioni mostrate con ogni esercizio sono di proprietà di Gym visual, usate con autorizzazione nella loro dimensione originale di 180×180. Questo credito deve accompagnare le immagini ovunque compaiano."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her egzersizle gösterilen küçük görseller ve animasyonlar Gym visual'ın mülkiyetindedir ve izinle, özgün 180×180 boyutunda kullanılmaktadır. Bu künye, görseller nerede görünürse görünsün onlarla birlikte taşınmalıdır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个动作配的缩略图和动画均为 Gym visual 的财产，经许可以原始 180×180 尺寸使用。这项署名必须随图示一同出现在任何地方。"
          }
        }
      }
    },
    "settings.legal.media.notMit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The artwork is not covered by the MIT licence below. Gym visual's own terms apply to it instead."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las imágenes no están cubiertas por la licencia MIT de abajo. A ellas se aplican los términos propios de Gym visual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les illustrations ne sont pas couvertes par la licence MIT ci-dessous. Ce sont les conditions propres à Gym visual qui s’appliquent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आर्टवर्क नीचे दिए MIT लाइसेंस के दायरे में नहीं आता। उस पर Gym visual की अपनी शर्तें लागू होती हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le immagini non sono coperte dalla licenza MIT qui sotto. Valgono invece i termini di Gym visual."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Görseller aşağıdaki MIT lisansı kapsamında değildir. Onlar için Gym visual'ın kendi koşulları geçerlidir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些图示不适用下方的 MIT 许可证，而是适用 Gym visual 自己的条款。"
          }
        }
      }
    },
