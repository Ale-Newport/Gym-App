    "progress.weight.noiseNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Day-to-day changes are water, food and salt, not fat or muscle. Read the average line; a single morning is never a trend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los cambios del día a día son agua, comida y sal, no grasa ni músculo. Fíjate en la línea media; una sola mañana nunca es una tendencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les variations d’un jour à l’autre viennent de l’eau, de la nourriture et du sel, pas du gras ni du muscle. Lis la courbe moyenne : un seul matin n’est jamais une tendance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रोज़-रोज़ के बदलाव पानी, खाने और नमक के होते हैं, फैट या मसल के नहीं। औसत रेखा देखें; एक सुबह कभी ट्रेंड नहीं होती।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le variazioni da un giorno all'altro sono acqua, cibo e sale, non grasso o muscolo. Leggi la linea media: una singola mattina non è mai una tendenza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günden güne değişim su, yemek ve tuzdur; yağ ya da kas değil. Ortalama çizgisini oku; tek bir sabah asla trend olmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每天的波动来自水分、食物和盐分，不是脂肪或肌肉。看平均线，单独一个早晨从来都不是趋势。"
          }
        }
      }
    },
