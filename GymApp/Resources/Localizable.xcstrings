        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu respuesta cambia la frecuencia con la que se te programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta réponse change la fréquence à laquelle il t’est programmé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जवाब से तय होता है कि यह कितनी बार आपके प्रोग्राम में आएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua risposta cambia la frequenza con cui te lo proponiamo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답에 따라 이 운동이 얼마나 자주 계획에 들어갈지 달라져요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja odpowiedź zmienia, jak często trafia ono do Twoich planów."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cevabın, bu egzersizin sana ne sıklıkta verileceğini değiştirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回答会影响它被安排的频率。"
          }
        }
      }
    },
