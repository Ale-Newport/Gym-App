    "program.settings.rirOverride.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Otherwise the target follows your experience level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si no, el objetivo sigue tu nivel de experiencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sinon l’objectif suit ton niveau d’expérience."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वरना लक्ष्य आपके अनुभव स्तर के हिसाब से चलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Altrimenti l'obiettivo segue il tuo livello di esperienza."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정하지 않으면 경력 수준을 따라가요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W przeciwnym razie cel wynika z Twojego poziomu doświadczenia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aksi hâlde hedef, deneyim düzeyini izler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "否则目标会跟随你的经验水平。"
          }
        }
      }
    },
    "program.settings.scheduleFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many days you train decides which splits fit, and how long a session can run decides how much fits inside one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántos días entrenas decide qué splits encajan, y cuánto puede durar una sesión decide cuánto cabe dentro de ella."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre de jours où tu t’entraînes détermine les splits possibles, et la durée d’une séance détermine ce qui tient dedans."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप कितने दिन ट्रेनिंग करते हैं, इससे तय होता है कि कौन से स्प्लिट फ़िट बैठेंगे, और एक सेशन कितना लंबा चल सकता है, इससे तय होता है कि उसमें कितना समाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanti giorni ti alleni decide quali split sono possibili, e quanto può durare una sessione decide quanto ci sta dentro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 일수에 따라 어떤 분할이 맞는지 정해지고, 세션 길이에 따라 한 세션에 얼마나 들어갈지 정해져요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczba dni treningowych decyduje, które splity pasują, a długość sesji — ile się w niej zmieści."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaç gün antrenman yaptığın hangi split'lerin uyacağını, bir seansın ne kadar sürebileceği de içine ne kadarının sığacağını belirler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练天数决定哪些分化适合你，单次时长决定一节训练课能装下多少内容。"
          }
        }
      }
    },
