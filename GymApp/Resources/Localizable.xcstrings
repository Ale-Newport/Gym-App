    },
    "program.templates.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A template is a session you have kept — its exercises, sets, reps, rest and effort target — ready to drop into any program."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una plantilla es una sesión que has guardado —sus ejercicios, series, repeticiones, descanso y objetivo de esfuerzo— lista para meterla en cualquier programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modèle est une séance que tu as gardée — ses exercices, séries, répétitions, repos et objectif d’effort — prête à être déposée dans n’importe quel programme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टेम्पलेट वह सेशन है जिसे आपने संभाल रखा है — उसकी एक्सरसाइज़, सेट, रेप्स, आराम और मेहनत लक्ष्य के साथ — किसी भी प्रोग्राम में डालने के लिए तैयार।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un modello è una sessione che hai conservato — i suoi esercizi, serie, ripetizioni, recupero e obiettivo di sforzo — pronta da inserire in qualsiasi programma."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "템플릿은 운동과 세트, 횟수, 휴식, 강도 목표까지 저장해 둔 세션이에요. 어떤 프로그램에든 넣을 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szablon to zachowana sesja — jej ćwiczenia, serie, powtórzenia, przerwy i cel wysiłku — gotowa do wstawienia w dowolny program."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şablon, sakladığın bir seanstır — egzersizleri, setleri, tekrarları, dinlenmesi ve zorlanma hedefiyle birlikte, herhangi bir programa eklenmeye hazır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模板就是你保存下来的一节训练课，包含动作、组数、次数、休息和强度目标，随时可以放进任何训练计划。"
          }
        }
      }
    },
