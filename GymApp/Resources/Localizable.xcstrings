    "progression.explain.holdForMargin": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep %@ at %@. You reached %@ reps on every set, but finished closer to failure than the target of %@ reps in reserve, so the load waits until those reps come back with a little more left in the tank."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %@ en %@. Llegaste a %@ repeticiones en todas las series, pero terminaste más cerca del fallo que el objetivo de %@ repeticiones en reserva, así que la carga espera a que esas reps vuelvan con algo más de margen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde %@ à %@. Tu as atteint %@ répétitions sur chaque série, mais tu as fini plus près de l’échec que l’objectif de %@ répétitions en réserve : la charge attend que ces répétitions reviennent avec un peu plus de marge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को %@ पर रखें। आपने हर सेट में %@ रेप्स किए, पर %@ रिज़र्व रेप्स के लक्ष्य से ज़्यादा फेल्योर के करीब पहुँचे, इसलिए लोड तब तक रुकेगा जब तक वे रेप्स थोड़ा और दम बचाकर न आ जाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni %@ a %@. Hai raggiunto %@ ripetizioni in ogni serie, ma hai chiuso più vicino al cedimento dell'obiettivo di %@ ripetizioni di riserva, quindi il carico aspetta che quelle ripetizioni tornino con un po' più di margine."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ağırlığını %@ değerinde tut. Her sette %@ tekrara ulaştın ama %@ tekrar yedekte kalma hedefinden daha çok zorlandın; bu yüzden o tekrarlar biraz daha rahat gelene kadar ağırlık bekliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 保持在 %@。你每组都做到了 %@ 次，但结束时离力竭比目标的保留 %@ 次更近，因此先等这些次数在更有余力的情况下重现，再加负重。"
          }
        }
      }
    },
    "progression.explain.increasedLoad": {
      "extractionState": "manual",
      "localizations": {
