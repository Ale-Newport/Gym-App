    "progress.adherence.encourage.building": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are building the habit, and every session you finish is on this chart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás creando el hábito, y cada sesión que terminas está en este gráfico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu construis l’habitude, et chaque séance que tu termines est sur ce graphique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप आदत बना रहे हैं, और आपका पूरा किया हर सेशन इस चार्ट पर है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai costruendo l'abitudine, e ogni sessione che finisci finisce su questo grafico."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alışkanlığı kuruyorsun ve bitirdiğin her seans bu grafikte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你正在养成习惯，每一次完成的训练都会出现在这张图上。"
          }
        }
      }
    },
    "progress.adherence.encourage.excellent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have shown up almost every time. That is what makes the difference."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Has aparecido casi siempre. Eso es lo que marca la diferencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as répondu présent presque à chaque fois. C’est ce qui fait la différence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप लगभग हर बार आए हैं। यही फ़र्क बनाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci sei stato quasi sempre. È questo che fa la differenza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neredeyse her seferinde geldin. Farkı yaratan da bu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你几乎每次都到场了，这正是差别所在。"
          }
        }
      }
    },
    "progress.adherence.encourage.start": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every session counts. The first one is the whole trick."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sesión cuenta. La primera es el verdadero truco."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque séance compte. La première est tout le secret."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सेशन मायने रखता है। पहला सेशन ही असली कमाल है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni sessione conta. La prima è tutto il trucco."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her seansın değeri var. Zor olan ilkini yapmak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一次训练都算数，最难的是第一次。"
          }
        }
      }
    },
    "progress.adherence.encourage.steady": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Steady going. Sessions finished beat sessions planned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vas constante. Las sesiones terminadas valen más que las planificadas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ça avance bien. Une séance terminée vaut mieux qu’une séance prévue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अच्छा चल रहा है। तय किए सेशन से पूरे किए सेशन ज़्यादा मायने रखते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si procede bene. Le sessioni finite valgono più di quelle previste."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstikrarlı gidiyor. Bitirilen seans, planlanan seansı yener."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稳步推进。完成的训练课比计划的更有意义。"
          }
        }
      }
    },
    "progress.adherence.encourage.strong": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Strong run — you are hitting most of what you planned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buena racha: estás cumpliendo casi todo lo que planificaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belle régularité — tu tiens l’essentiel de ce que tu avais prévu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बढ़िया दौर — आप अपनी योजना का ज़्यादातर हिस्सा पूरा कर रहे हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bel ritmo: stai centrando gran parte di quello che avevi previsto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İyi gidiyorsun — planladığının çoğunu tutturuyorsun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "状态不错，计划中的大部分你都完成了。"
          }
        }
      }
    },
    "progress.adherence.noPlanFootnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no active program to compare against, so this is simply what you did."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún programa activo con el que comparar, así que esto es simplemente lo que hiciste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas de programme actif pour servir de comparaison : c’est simplement ce que tu as fait."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुलना के लिए कोई सक्रिय प्रोग्राम नहीं है, इसलिए यह बस वही है जो आपने किया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è un programma attivo con cui confrontarsi, quindi questo è semplicemente ciò che hai fatto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Karşılaştırılacak etkin bir program yok, bu yüzden burada yalnızca yaptıkların var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有启用中的训练计划可供对照，因此这里只呈现你实际做了什么。"
          }
        }
      }
    },
    "progress.adherence.noProgramNote": {
      "extractionState": "manual",
      "localizations": {
