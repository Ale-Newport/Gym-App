    "settings.goals.prioritiesFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorities receive more weekly sets. Everything else still gets enough to keep progressing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las prioridades reciben más series semanales. Todo lo demás sigue recibiendo lo suficiente para seguir progresando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les priorités reçoivent plus de séries par semaine. Tout le reste en garde assez pour continuer à progresser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राथमिकता वाले ग्रुप को हफ़्ते में ज़्यादा सेट मिलते हैं। बाकी सबको भी प्रगति बनाए रखने लायक काम मिलता रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le priorità ricevono più serie a settimana. Tutto il resto ne riceve comunque abbastanza per continuare a progredire."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öncelikli olanlar haftada daha çok set alır. Kalan her şey yine de ilerlemeye yetecek kadarını alır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "优先项会获得更多的每周组数。其余部分仍会得到足够的量来保持进步。"
          }
        }
      }
    },
    "settings.goals.priorityMuscles": {
