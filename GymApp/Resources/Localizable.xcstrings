          "stringUnit": {
            "state": "translated",
            "value": "इस मील में दर्ज करने लायक कुछ नहीं बचा। इसके फ़ूड अब आपकी लाइब्रेरी में नहीं हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo pasto non è rimasto nulla da registrare. I suoi alimenti non sono più nella tua libreria."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 식사에 기록할 것이 남아 있지 않아요. 담긴 음식이 내 목록에 더 이상 없어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W tym posiłku nie zostało nic do zapisania. Jego produktów nie ma już w Twojej bibliotece."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğünde kaydedilecek bir şey kalmamış. İçindeki besinler artık kütüphanende değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一餐已经没有可记录的内容，它的食物都不在你的食物库里了。"
          }
        }
      }
    },
