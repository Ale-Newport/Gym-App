        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aujourd’hui ressemble à une journée déjà enregistrée, copie-la plutôt que de tout ressaisir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आज का दिन किसी पहले दर्ज किए दिन जैसा है, तो दोबारा टाइप करने के बजाय उसे कॉपी कर लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Se oggi assomiglia a un giorno che hai già registrato, copialo invece di riscriverlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘이 이미 기록한 어떤 날과 비슷하다면, 다시 입력하지 말고 복사해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli dziś wygląda jak dzień, który już zapisałeś, skopiuj go zamiast wpisywać wszystko od nowa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün daha önce kaydettiğin bir güne benziyorsa, hepsini yeniden yazmak yerine kopyala."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果今天和你记录过的某一天差不多，直接复制比重新输入更快。"
          }
        }
      }
    },
