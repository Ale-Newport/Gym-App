    "autoreg.addSet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session felt easy and this muscle group is below its weekly target, so one set is being added."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión se te hizo fácil y este grupo muscular está por debajo de su objetivo semanal, así que se añade una serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La séance a paru facile et ce groupe musculaire est sous son objectif hebdomadaire, donc une série est ajoutée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेशन आसान लगा और यह मसल ग्रुप अपने साप्ताहिक लक्ष्य से नीचे है, इसलिए एक सेट जोड़ा जा रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione è sembrata facile e questo gruppo muscolare è sotto il suo obiettivo settimanale, quindi aggiungiamo una serie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seans kolay geldi ve bu kas grubu haftalık hedefinin altında, bu yüzden bir set ekleniyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次训练感觉轻松，而这个肌群低于每周目标，因此增加一组。"
          }
        }
      }
    },
    "autoreg.noChange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is on track. Your next session stays as planned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo va según lo previsto. Tu próxima sesión se queda tal cual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout est sur les rails. Ta prochaine séance reste telle quelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सब कुछ पटरी पर है। आपका अगला सेशन योजना के मुताबिक ही रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È tutto in linea. La prossima sessione resta come previsto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şey yolunda. Sonraki seansın planlandığı gibi kalıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一切正常，下一次训练维持原计划。"
          }
        }
      }
    },
    "autoreg.reduceLoad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ came up short of its rep targets, so it starts a little lighter next time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se quedó corto en sus objetivos de repeticiones, así que la próxima vez empieza algo más ligero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est resté en dessous de ses objectifs de répétitions, donc il repartira un peu plus léger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अपने रेप लक्ष्य से थोड़ा पीछे रहा, इसलिए अगली बार यह थोड़ा हल्का शुरू होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è rimasto sotto le ripetizioni obiettivo, quindi la prossima volta parte un po' più leggero."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tekrar hedeflerinin altında kaldı, bu yüzden bir dahakine biraz daha hafif başlıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 没有达到目标次数，下次会从稍轻一点开始。"
          }
        }
      }
    },
    "autoreg.reduceLoad.severe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ missed its rep targets by a wide margin. Dropping the load to get the reps back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se quedó muy lejos de sus objetivos de repeticiones. Bajamos la carga para recuperar las reps."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est loin de ses objectifs de répétitions. La charge baisse pour retrouver les répétitions."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अपने रेप लक्ष्य से काफ़ी पीछे रहा। रेप्स वापस पाने के लिए लोड घटाया जा रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ha mancato le ripetizioni obiettivo di parecchio. Abbassiamo il carico per recuperare le ripetizioni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ tekrar hedeflerinin epey altında kaldı. Tekrarları geri getirmek için ağırlık düşürülüyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 与目标次数差距较大，降低负重把次数找回来。"
          }
        }
      }
    },
    "autoreg.removeSet.fatigue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This muscle group is still carrying a lot of fatigue, so one set is coming off."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este grupo muscular sigue con bastante fatiga, así que se quita una serie."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce groupe musculaire porte encore beaucoup de fatigue, donc une série est retirée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मसल ग्रुप में अब भी काफ़ी थकान है, इसलिए एक सेट कम किया जा रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo gruppo muscolare porta ancora molta fatica, quindi togliamo una serie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kas grubu hâlâ epey yorgunluk taşıyor, bu yüzden bir set çıkarılıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个肌群仍带着较多疲劳，因此减少一组。"
          }
        }
      }
    },
    "autoreg.restLonger": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reps dropped away sharply between sets on %@. A longer rest should hold performance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las repeticiones cayeron mucho entre series en %@. Un descanso más largo debería sostener el rendimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les répétitions ont chuté nettement d’une série à l’autre sur %@. Un repos plus long devrait maintenir la performance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में सेट-दर-सेट रेप्स तेज़ी से गिरे। ज़्यादा आराम से प्रदर्शन बना रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@ le ripetizioni sono calate bruscamente tra una serie e l'altra. Un recupero più lungo dovrebbe tenere la prestazione."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketinde setler arasında tekrarlar hızla düştü. Daha uzun bir dinlenme performansı korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 的次数在组间下降得很快，延长休息有助于维持表现。"
          }
        }
      }
    },
    "autoreg.shortenSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session ran about %@ minutes past your time cap, so it is being trimmed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión se pasó unos %@ minutos de tu límite de tiempo, así que se recorta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La séance a dépassé ta limite de temps d’environ %@ minutes, elle est donc raccourcie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेशन आपकी समय सीमा से करीब %@ मिनट आगे चला गया, इसलिए इसे छोटा किया जा रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione ha superato il tuo limite di tempo di circa %@ minuti, quindi viene accorciata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seans, süre sınırını yaklaşık %@ dakika aştı, bu yüzden kısaltılıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这次训练超出你的时间上限约 %@ 分钟，因此会做精简。"
          }
        }
      }
    },
    "autoreg.swap.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fell short on every set and there is no load to take off. A different exercise may fit better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se quedó corto en todas las series y ya no hay carga que quitar. Quizá te encaje mejor otro ejercicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ est resté court sur toutes les séries et il n’y a pas de charge à retirer. Un autre exercice conviendrait peut-être mieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ हर सेट में पीछे रहा और घटाने को कोई लोड नहीं है। कोई दूसरी एक्सरसाइज़ ज़्यादा जँच सकती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è rimasto sotto in ogni serie e non c'è carico da togliere. Un altro esercizio potrebbe funzionare meglio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ her sette yetersiz kaldı ve düşürülecek ağırlık yok. Farklı bir egzersiz daha iyi oturabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 每组都没完成，而且没有负重可以再减。换一个动作可能更合适。"
          }
        }
      }
    },
    "autoreg.swap.substituted": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You swapped %@ out during the session. A permanent replacement may suit you better."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cambiaste %@ durante la sesión. Puede que te venga mejor una sustitución permanente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as remplacé %@ pendant la séance. Un remplacement définitif te conviendrait peut-être mieux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने सेशन के दौरान %@ बदल दिया था। शायद कोई स्थायी विकल्प आपको ज़्यादा जँचे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Durante la sessione hai sostituito %@. Un cambio definitivo potrebbe starti meglio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seans sırasında %@ hareketini değiştirdin. Kalıcı bir alternatif sana daha uygun olabilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你在训练中把 %@ 换掉了。换成固定的替代动作也许更合适。"
          }
        }
      }
    },
