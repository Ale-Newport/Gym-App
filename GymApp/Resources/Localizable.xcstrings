    "settings.legal.dataset.body": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercise names, categories, equipment, target muscles and the step-by-step instructions come from an open dataset by Hasan Emir Yıldırım, released under the MIT licence."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los nombres, categorías, material, músculos objetivo e instrucciones paso a paso de los ejercicios proceden de un conjunto de datos abierto de Hasan Emir Yıldırım, publicado bajo licencia MIT."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms d’exercices, catégories, matériels, muscles ciblés et consignes étape par étape proviennent d’un jeu de données ouvert de Hasan Emir Yıldırım, publié sous licence MIT."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सरसाइज़ के नाम, श्रेणियाँ, इक्विपमेंट, मुख्य मसल और चरण-दर-चरण निर्देश Hasan Emir Yıldırım के एक ओपन डेटासेट से आते हैं, जो MIT लाइसेंस के तहत जारी हुआ है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomi degli esercizi, categorie, attrezzatura, muscoli bersaglio e istruzioni passo passo provengono da un dataset aperto di Hasan Emir Yıldırım, pubblicato con licenza MIT."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersiz adları, kategoriler, ekipman, hedef kaslar ve adım adım açıklamalar, Hasan Emir Yıldırım'ın MIT lisansıyla yayımladığı açık bir veri setinden gelir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作名称、分类、器械、目标肌肉和分步说明来自 Hasan Emir Yıldırım 的开源数据集，以 MIT 许可证发布。"
          }
        }
      }
    },
