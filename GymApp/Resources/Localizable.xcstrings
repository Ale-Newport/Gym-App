    "program.session.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add exercises and the weekly volume below keeps up with them as you go."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade ejercicios y el volumen semanal de abajo se irá actualizando con ellos."
