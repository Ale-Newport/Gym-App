    "program.templates.previewFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Adding this makes a copy. Editing the new session does not change the template, and editing the template does not change sessions you have already built."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al añadirla se hace una copia. Editar la sesión nueva no cambia la plantilla, y editar la plantilla no cambia las sesiones que ya has montado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’ajouter en fait une copie. Modifier la nouvelle séance ne change pas le modèle, et modifier le modèle ne change pas les séances déjà construites."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़ने पर एक कॉपी बनती है। नए सेशन को एडिट करने से टेम्पलेट नहीं बदलता, और टेम्पलेट एडिट करने से पहले बनाए सेशन नहीं बदलते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungendolo ne crei una copia. Modificare la nuova sessione non cambia il modello, e modificare il modello non cambia le sessioni che hai già costruito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추가하면 사본이 만들어져요. 새 세션을 수정해도 템플릿은 바뀌지 않고, 템플릿을 수정해도 이미 만든 세션은 바뀌지 않아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodanie tworzy kopię. Edycja nowej sesji nie zmienia szablonu, a edycja szablonu nie zmienia sesji, które już zbudowałeś."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu eklemek bir kopya oluşturur. Yeni seansı düzenlemek şablonu, şablonu düzenlemek de daha önce kurduğun seansları değiştirmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "加入时会创建一份副本。修改新的训练课不会改变模板，修改模板也不会改变你已经建好的训练课。"
          }
        }
      }
    },
