        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganar músculo mientras pierdes grasa funciona mejor con un déficit pequeño, de unas %@ kcal al día, y proteína de sobra, así que tu objetivo es de %@ kcal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prendre du muscle en perdant du gras marche le mieux avec un petit déficit d’environ %@ kcal par jour et beaucoup de protéines : ton objectif est donc de %@ kcal."
          }
