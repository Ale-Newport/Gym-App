        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중을 입력하면 주 단위 수치로 볼 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj swoją wagę, żeby zobaczyć to jako wartość tygodniową."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu haftalık bir rakam olarak görmek için kilonu ekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填上体重就能看到每周的具体数值。"
          }
        }
      }
    },
