    "workoutHub.calendar.missedExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A missed day does not break your plan. Forge can re-seat the rest of the week so nothing is dropped and no muscle group gets trained twice in a row."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un día perdido no rompe tu plan. Forge puede recolocar el resto de la semana para que no se caiga nada y ningún grupo muscular se entrene dos días seguidos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un jour manqué ne casse pas ton plan. Forge peut replacer le reste de la semaine pour que rien ne saute et qu’aucun groupe musculaire ne soit travaillé deux fois d’affilée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक दिन छूटने से आपका प्लान नहीं टूटता। Forge बाकी हफ़्ते को फिर से जमा सकता है, ताकि कुछ छूटे नहीं और एक ही मसल ग्रुप लगातार दो दिन न पड़े।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un giorno saltato non rompe il piano. Forge può risistemare il resto della settimana in modo che non si perda nulla e nessun gruppo muscolare venga allenato due volte di fila."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "漏掉一天并不会打乱你的计划。Forge 可以把这一周剩下的安排重新排布，既不丢掉任何内容，也不会让同一肌群连续两天被训练。"
          }
        }
      }
    },
    "workoutHub.calendar.monthSummary": {
      "extractionState": "manual",
