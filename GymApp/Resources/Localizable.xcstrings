    "nutritionLibrary.recipes.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a recipe once and log it by the serving, without listing every ingredient again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una receta una vez y regístrala por raciones, sin volver a listar cada ingrediente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construis une recette une fois et enregistre-la à la portion, sans relister chaque ingrédient."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेसिपी एक बार बनाएँ और फिर हर बार सामग्री गिनाए बिना सर्विंग के हिसाब से दर्ज करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci una ricetta una volta e registrala a porzioni, senza dover elencare ogni ingrediente ogni volta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레시피를 한 번 만들어 두면 재료를 다시 적지 않고 회분 단위로 기록할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbuduj przepis raz i zapisuj go na porcje, bez wypisywania za każdym razem wszystkich składników."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarifi bir kez oluştur, sonra her malzemeyi tekrar yazmadan porsiyonla kaydet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食谱建一次，以后按份记录，不用每次重新列出所有配料。"
          }
        }
      }
    },
