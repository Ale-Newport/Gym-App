    "nutritionLibrary.food.deleteMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It goes from your library. Anything you have already logged keeps its numbers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desaparece de tu biblioteca. Lo que ya hayas registrado conserva sus números."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il quitte ta bibliothèque. Ce que tu as déjà enregistré garde ses valeurs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपकी लाइब्रेरी से हट जाएगा। जो आप पहले दर्ज कर चुके हैं, उसके आँकड़े वैसे ही रहेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparisce dalla tua libreria. Quello che hai già registrato mantiene i suoi numeri."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 목록에서 사라져요. 이미 기록한 내용의 수치는 그대로 남아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zniknie z Twojej biblioteki. To, co już zapisałeś, zachowa swoje liczby."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kütüphanenden çıkar. Daha önce kaydettiklerin rakamlarıyla birlikte kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它会从你的食物库中消失。已经记录过的内容会保留原有数字。"
          }
        }
      }
    },
