          "stringUnit": {
            "state": "translated",
            "value": "Couvre environ %@ g de protéines, %@ g de glucides et %@ g de lipides."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें करीब %@ g प्रोटीन, %@ g कार्ब्स और %@ g फैट मिलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copre circa %@ g di proteine, %@ g di carboidrati e %@ g di grassi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단백질 약 %@ g, 탄수화물 %@ g, 지방 %@ g을 채워요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokrywa około %@ g białka, %@ g węglowodanów i %@ g tłuszczu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık %@ g protein, %@ g karbonhidrat ve %@ g yağ karşılar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约含 %@ g 蛋白质、%@ g 碳水和 %@ g 脂肪。"
          }
        }
      }
    },
    "meal.reason.micronutrients": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Brings some fibre and micronutrients to the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aporta algo de fibra y de micronutrientes al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apporte des fibres et des micronutriments à la journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिन में थोड़ा फ़ाइबर और माइक्रोन्यूट्रिएंट जोड़ता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
