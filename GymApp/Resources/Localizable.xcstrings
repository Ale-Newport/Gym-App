    "workoutHub.reschedule.applied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your week has been rebuilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu semana se ha reorganizado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta semaine a été reconstruite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका हफ़्ता दोबारा जम गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua settimana è stata ricostruita."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的一周已经重新排布。"
          }
        }
      }
    },
    "workoutHub.reschedule.footnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These changes apply to the weekday your program schedules each session on, so next week follows the new order too."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos cambios se aplican al día de la semana en el que tu programa coloca cada sesión, así que la semana que viene también seguirá el nuevo orden."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces changements s’appliquent au jour de la semaine où ton programme place chaque séance : la semaine prochaine suivra donc aussi le nouvel ordre."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये बदलाव उस दिन पर लागू होते हैं जिस दिन आपका प्रोग्राम हर सेशन रखता है, इसलिए अगला हफ़्ता भी इसी नए क्रम पर चलेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste modifiche valgono per il giorno della settimana in cui il tuo programma colloca ogni sessione, quindi anche la settimana prossima seguirà il nuovo ordine."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些改动会作用于你的计划把每节训练课安排在星期几，因此下周也会按新的顺序进行。"
          }
        }
      }
    },
