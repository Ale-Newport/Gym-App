    "onboarding.emptyCatalog.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exercise library came back empty, so there is nothing to build a program from yet. Try loading it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca de ejercicios ha venido vacía, así que todavía no hay con qué montar un programa. Prueba a cargarla de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque d’exercices est revenue vide, il n’y a donc rien pour construire un programme. Essaie de la recharger."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सरसाइज़ लाइब्रेरी खाली आई, इसलिए अभी प्रोग्राम बनाने के लिए कुछ नहीं है। इसे फिर से लोड करके देखें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La libreria esercizi è risultata vuota, quindi per ora non c'è nulla con cui costruire un programma. Prova a ricaricarla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 목록이 비어 있어서 프로그램을 만들 수 없어요. 다시 불러와 주세요."
          }
