    "nutritionLibrary.micros.unknownNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld nutrient is not in the food data for what you logged, so it shows as unknown rather than as zero."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld nutrients are not in the food data for what you logged, so they show as unknown rather than as zero."
                }
              }
            }
          }
        },
        "es": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld nutrientes no aparecen en los datos de lo que registraste, así que se muestran como desconocidos y no como cero."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld nutriente no aparece en los datos de lo que registraste, así que se muestra como desconocido y no como cero."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld nutrientes no aparecen en los datos de lo que registraste, así que se muestran como desconocidos y no como cero."
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld nutriments ne figurent pas dans les données des aliments enregistrés : ils apparaissent comme inconnus plutôt que comme zéro."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld nutriment ne figure pas dans les données des aliments enregistrés : il apparaît comme inconnu plutôt que comme zéro."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld nutriments ne figurent pas dans les données des aliments enregistrés : ils apparaissent comme inconnus plutôt que comme zéro."
                }
              }
            }
          }
        },
        "hi": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "आपने जो दर्ज किया उसके फ़ूड डेटा में %lld पोषक तत्व नहीं है, इसलिए वह शून्य नहीं, अज्ञात दिखता है।"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "आपने जो दर्ज किया उसके फ़ूड डेटा में %lld पोषक तत्व नहीं हैं, इसलिए वे शून्य नहीं, अज्ञात दिखते हैं।"
                }
              }
            }
          }
        },
        "it": {
          "variations": {
            "plural": {
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld nutrienti non sono presenti nei dati degli alimenti che hai registrato, quindi risultano sconosciuti e non zero."
                }
              },
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld nutriente non è presente nei dati degli alimenti che hai registrato, quindi risulta sconosciuto e non zero."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld nutrienti non sono presenti nei dati degli alimenti che hai registrato, quindi risultano sconosciuti e non zero."
                }
              }
            }
          }
        },
        "ko": {
          "variations": {
            "plural": {
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "기록한 음식의 데이터에 영양소 %lld개가 없어서 0이 아니라 모름으로 표시돼요."
                }
              }
            }
          }
        },
        "pl": {
          "variations": {
            "plural": {
              "few": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld składniki nie występują w danych o tym, co zapisałeś, więc pokazują się jako nieznane, a nie jako zero."
                }
              },
              "many": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld składników nie występuje w danych o tym, co zapisałeś, więc pokazują się jako nieznane, a nie jako zero."
                }
