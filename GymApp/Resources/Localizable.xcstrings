          "stringUnit": {
            "state": "translated",
            "value": "Start %@ at %@ to %@ reps a set. We will adjust from what you log."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empieza %@ con %@-%@ repeticiones por serie. Lo ajustaremos con lo que registres."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commence %@ à %@ à %@ répétitions par série. On ajustera à partir de ce que tu enregistres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की शुरुआत हर सेट %@ से %@ रेप्स पर करें। आप जो दर्ज करेंगे, उसी से हम आगे समायोजित करेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inizia %@ con %@-%@ ripetizioni per serie. Regoleremo in base a quello che registri."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketine set başına %@ ile %@ tekrarla başla. Kaydettiklerine göre ayarlayacağız."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 从每组 %@ 到 %@ 次开始。我们会根据你的记录进行调整。"
          }
        }
      }
    },
