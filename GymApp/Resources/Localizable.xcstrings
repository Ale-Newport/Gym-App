    "nutritionLog.saveMeal.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Give it a name and you can log the whole thing again in one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ponle un nombre y podrás registrarla entera con un solo toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Donne-lui un nom et tu pourras réenregistrer l’ensemble d’un seul geste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे एक नाम दें और पूरा मील दोबारा एक टैप में दर्ज हो जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dagli un nome e potrai registrare tutto di nuovo con un tocco."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름을 붙이면 다음부터 한 번에 전체를 기록할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadaj mu nazwę, a zapiszesz całość ponownie jednym dotknięciem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ad ver; tamamını tek dokunuşla yeniden kaydedebilesin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "起个名字，以后就能一键记录整份餐食。"
          }
        }
      }
    },
