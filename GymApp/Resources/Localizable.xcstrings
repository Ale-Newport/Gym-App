    "workoutHub.calendar.movePersists": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Moving a session changes which weekday your program schedules it on from now on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mover una sesión cambia el día de la semana en el que tu programa la coloca de ahora en adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Déplacer une séance change le jour de la semaine où ton programme la place, à partir de maintenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेशन खिसकाने से यह बदल जाता है कि आपका प्रोग्राम आगे से उसे हफ़्ते के किस दिन रखेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spostare una sessione cambia da qui in avanti il giorno della settimana in cui il tuo programma la colloca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移动一节训练课，会改变今后你的计划把它安排在星期几。"
          }
        }
      }
    },
