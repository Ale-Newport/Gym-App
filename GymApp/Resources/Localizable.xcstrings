    "onboarding.nutrition.intolerances.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Treated exactly like an allergy: left out entirely."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se tratan igual que una alergia: se dejan fuera por completo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Traitées exactement comme une allergie : entièrement écartées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एलर्जी की तरह ही माना जाता है: पूरी तरह बाहर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trattate esattamente come un'allergia: escluse del tutto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알레르기와 똑같이 완전히 제외해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Traktowane dokładnie jak alergia: pomijane całkowicie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam olarak alerji gibi ele alınır: tümüyle dışarıda bırakılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "处理方式与过敏完全相同：彻底排除。"
          }
        }
      }
    },
    "onboarding.nutrition.meals": {
