    "workoutHub.today.deloadWeek": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is the last week of a %@-week block, so loads and sets are pulled back on purpose. Next week starts fresh."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es la última semana de un bloque de %@ semanas, así que las cargas y las series se recortan a propósito. La semana que viene empieza de cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est la dernière semaine d’un bloc de %@ semaines : les charges et les séries sont volontairement réduites. La semaine prochaine repart à neuf."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह %@ हफ़्ते के ब्लॉक का आखिरी हफ़्ता है, इसलिए लोड और सेट जानबूझकर कम रखे गए हैं। अगला हफ़्ता ताज़ा शुरू होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è l'ultima settimana di un blocco da %@ settimane, quindi carichi e serie sono ridotti di proposito. La prossima settimana si riparte."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是 %@ 周周期的最后一周，因此负重和组数被有意收紧。下周会重新开始。"
          }
        }
      }
    },
