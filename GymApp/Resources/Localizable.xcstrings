    "nutritionLibrary.food.energyMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The label says %@, but the protein, carbs and fat add up to %@. Packets round their own numbers, so a small gap is normal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La etiqueta pone %@, pero la proteína, los hidratos y la grasa suman %@. Los envases redondean sus propias cifras, así que una diferencia pequeña es normal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’étiquette indique %@, mais les protéines, glucides et lipides totalisent %@. Les emballages arrondissent leurs chiffres, un petit écart est donc normal."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेबल पर %@ लिखा है, पर प्रोटीन, कार्ब्स और फैट जोड़कर %@ बनते हैं। पैकेट अपने आँकड़े गोल कर देते हैं, इसलिए थोड़ा फ़र्क सामान्य है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'etichetta indica %@, ma proteine, carboidrati e grassi sommano %@. Le confezioni arrotondano i loro numeri, quindi una piccola differenza è normale."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "라벨에는 %@이라고 되어 있는데, 단백질과 탄수화물, 지방을 더하면 %@이에요. 포장에 적힌 값은 반올림되기 때문에 작은 차이는 정상이에요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Etykieta podaje %@, ale białko, węglowodany i tłuszcz sumują się do %@. Producenci zaokrąglają swoje liczby, więc mała różnica jest normalna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etikette %@ yazıyor ama protein, karbonhidrat ve yağ toplamı %@ ediyor. Paketler kendi rakamlarını yuvarlar, küçük bir fark normaldir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标签写的是 %@，但蛋白质、碳水和脂肪加起来是 %@。包装上的数字本来就会取整，小的差距很正常。"
          }
        }
      }
    },
