    "settings.notifications.mealsEmpty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a time and Forge will remind you to log that meal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una hora y Forge te recordará que registres esa comida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une heure et Forge te rappellera d’enregistrer ce repas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक समय जोड़ें और Forge आपको वह मील दर्ज करने की याद दिलाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi un orario e Forge ti ricorderà di registrare quel pasto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir saat ekle; Forge o öğünü kaydetmeni hatırlatsın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加一个时间，Forge 就会提醒你记录那一餐。"
          }
        }
      }
    },
