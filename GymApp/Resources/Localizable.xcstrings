        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido conectar con la base de datos en línea, así que este código solo se ha comprobado con los alimentos de tu dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La base en ligne n’a pas pu être jointe, ce code n’a donc été comparé qu’aux aliments présents sur ton appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन डेटाबेस तक नहीं पहुँचा जा सका, इसलिए यह कोड सिर्फ़ आपके डिवाइस के फ़ूड से मिलाया गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile raggiungere il database online, quindi questo codice è stato confrontato solo con gli alimenti sul tuo dispositivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 데이터베이스에 연결하지 못해서 이 기기에 있는 음식만 대조했어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z bazą online, więc kod sprawdziliśmy tylko wśród produktów na Twoim urządzeniu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimiçi veritabanına ulaşılamadı, bu yüzden bu kod yalnızca cihazındaki besinlerle karşılaştırıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接在线数据库，因此只在本机的食物中核对了这个条形码。"
          }
        }
      }
    },
