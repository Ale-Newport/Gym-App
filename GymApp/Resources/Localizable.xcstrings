    "onboarding.nutrition.enable.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counting food suits some people and not others. Your call."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Contar la comida le va bien a unos y a otros no. Tú decides."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compter ce qu’on mange convient à certains et pas à d’autres. À toi de voir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाना गिनना कुछ लोगों को जँचता है, कुछ को नहीं। फ़ैसला आपका।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Contare quello che si mangia va bene per alcuni e non per altri. Decidi tu."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음식을 세는 방식이 맞는 사람도, 아닌 사람도 있어요. 선택은 사용자 몫이에요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Liczenie jedzenia jednym pasuje, innym nie. Twoja decyzja."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yediklerini saymak kimine uyar, kimine uymaz. Karar senin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录饮食适合一部分人，也不适合另一部分人。由你决定。"
          }
        }
      }
    },
    "onboarding.nutrition.enable.off": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No daily target will be set and the nutrition tab stays hidden. You can turn it on later in Settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se fijará ningún objetivo diario y la pestaña de nutrición quedará oculta. Puedes activarla más adelante en Ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun objectif quotidien ne sera défini et l’onglet nutrition reste masqué. Tu pourras l’activer plus tard dans les Réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दैनिक लक्ष्य तय नहीं होगा और न्यूट्रिशन टैब छिपा रहेगा। आप इसे बाद में Settings में चालू कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non verrà impostato nessun obiettivo giornaliero e la scheda nutrizione resterà nascosta. Puoi attivarla più avanti nelle Impostazioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 목표를 정하지 않고 식단 탭도 숨겨요. 나중에 설정에서 켤 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ustawimy dziennego celu, a zakładka diety zostanie ukryta. Możesz ją włączyć później w Ustawieniach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük hedef belirlenmez ve beslenme sekmesi gizli kalır. Sonradan Ayarlar'dan açabilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会设定每日目标，饮食标签页也会隐藏。之后可以在设置中随时打开。"
          }
        }
      }
    },
