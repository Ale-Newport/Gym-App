        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 제공량이 없어요. 무게로는 그대로 기록할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak porcji. Ten produkt możesz nadal zapisywać wagowo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz porsiyon yok. Bu besini yine de ağırlıkla kaydedebilirsin."
