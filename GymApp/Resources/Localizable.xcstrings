    "nutritionLog.custom.servingNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a serving if you would rather log this food by the pot or the scoop than by weight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una ración si prefieres registrar este alimento por tarrinas o cacitos en vez de por peso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une portion si tu préfères enregistrer cet aliment au pot ou à la dosette plutôt qu’au poids."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप इस फ़ूड को वज़न की जगह पॉट या स्कूप से दर्ज करना चाहें तो एक सर्विंग जोड़ लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una porzione se preferisci registrare questo alimento a vasetti o misurini invece che a peso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "무게 대신 통이나 스쿱 단위로 기록하고 싶다면 제공량을 추가해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj porcję, jeśli wolisz zapisywać ten produkt na kubeczki albo miarki niż wagowo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu besini ağırlıkla değil de kapla ya da ölçekle kaydetmek istiyorsan bir porsiyon ekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你更想按盒或按勺记录这种食物，而不是按重量，就添加一种份量。"
          }
        }
      }
    },
