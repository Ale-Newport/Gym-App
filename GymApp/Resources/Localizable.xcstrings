    "onboarding.goals.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick up to four. The first one you choose leads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige hasta cuatro. El primero que elijas manda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisis-en jusqu’à quatre. Le premier choisi mène la danse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चार तक चुनें। जो पहले चुनेंगे वही आगे रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegline fino a quattro. Il primo che scegli guida."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최대 4개까지 고를 수 있어요. 가장 먼저 고른 것이 중심이 돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz do czterech. Pierwszy wybrany prowadzi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En fazla dört tane seç. İlk seçtiğin belirleyici olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最多选四个。最先选的那个起主导作用。"
          }
        }
      }
    },
    "onboarding.goals.limit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Four goals is the most a single program can serve well."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuatro objetivos es lo máximo que un solo programa puede atender bien."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quatre objectifs, c’est le maximum qu’un seul programme peut bien servir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक प्रोग्राम अधिकतम चार लक्ष्य ही ठीक से साध सकता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quattro obiettivi sono il massimo che un solo programma può servire bene."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하나의 프로그램이 제대로 담을 수 있는 목표는 4개까지예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cztery cele to maksimum, jakie jeden program obsłuży dobrze."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek bir programın iyi hizmet edebileceği en fazla hedef sayısı dörttür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一份训练计划最多能兼顾四个目标。"
          }
        }
      }
    },
