    "settings.equipment.outOfServiceFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Mark anything broken or taken. Forge picks alternatives until you switch it back."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca lo que esté roto u ocupado. Forge elegirá alternativas hasta que vuelvas a activarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signale ce qui est cassé ou occupé. Forge choisit des alternatives jusqu’à ce que tu le remettes en service."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो कुछ टूटा हो या किसी और के पास हो, उसे यहाँ चिह्नित करें। जब तक आप वापस न करें, Forge विकल्प चुनता रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Segna quello che è rotto od occupato. Forge sceglie alternative finché non lo riattivi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bozuk ya da dolu olanı işaretle. Sen geri açana kadar Forge alternatif seçer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "标记出损坏或被占用的器械。在你改回之前，Forge 会挑选替代方案。"
          }
        }
      }
    },
