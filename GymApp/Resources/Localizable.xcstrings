    "program.settings.restFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are your defaults. Applying them sets the rest time on every exercise in your program, using the compound or isolation figure to match the movement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estos son tus valores por defecto. Al aplicarlos se fija el descanso de todos los ejercicios de tu programa, usando la cifra de compuesto o de aislamiento según el movimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sont tes valeurs par défaut. Les appliquer fixe le temps de repos de chaque exercice de ton programme, en prenant la valeur polyarticulaire ou isolation selon le mouvement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये आपके डिफ़ॉल्ट हैं। लागू करने पर आपके प्रोग्राम की हर एक्सरसाइज़ का आराम समय तय हो जाएगा — मूवमेंट के हिसाब से कंपाउंड या आइसोलेशन वाला आँकड़ा लेकर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi sono i tuoi valori predefiniti. Applicandoli imposti il recupero su ogni esercizio del programma, usando il valore multiarticolare o monoarticolare a seconda del movimento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여기 값이 기본값이에요. 적용하면 프로그램의 모든 운동에 휴식 시간이 설정되고, 동작에 따라 복합 또는 고립 값을 써요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To Twoje wartości domyślne. Zastosowanie ustawia czas przerwy przy każdym ćwiczeniu w programie, biorąc wartość dla ćwiczeń złożonych albo izolowanych, zależnie od ruchu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar senin varsayılanların. Uygulamak, programındaki her egzersizin dinlenme süresini harekete uygun bileşik veya izole değeriyle ayarlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些是你的默认值。应用后会为计划中每个动作设定休息时间，并按动作属于复合还是孤立取用对应数值。"
          }
        }
      }
    },
