    "food.database.rebuildDetail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reloads every built-in food. Your own foods, recipes and history are untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Vuelve a cargar todos los alimentos integrados. Tus alimentos, recetas e historial no se tocan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recharge tous les aliments intégrés. Tes propres aliments, recettes et historique ne sont pas touchés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर बिल्ट-इन फ़ूड फिर से लोड होगा। आपके अपने फ़ूड, रेसिपी और हिस्ट्री पर कोई असर नहीं पड़ेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricarica tutti gli alimenti integrati. I tuoi alimenti, le ricette e la cronologia restano intatti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내장 음식을 모두 다시 불러와요. 직접 만든 음식과 레시피, 기록은 그대로예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wczytuje na nowo każdy wbudowany produkt. Twoje własne produkty, przepisy i historia zostają nietknięte."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yerleşik tüm besinleri yeniden yükler. Kendi besinlerin, tariflerin ve geçmişin değişmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新载入全部内置食物。你自己的食物、食谱和记录不受影响。"
          }
        }
      }
    },
