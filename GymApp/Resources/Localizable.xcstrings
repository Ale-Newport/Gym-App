    "settings.equipment.presetFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A preset fills in the list below. Changing any single item moves you to a custom setup."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una configuración rellena la lista de abajo. Cambiar cualquier elemento te pasa a una configuración personalizada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une configuration remplit la liste ci-dessous. Modifier un seul élément te fait passer en configuration personnalisée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रीसेट नीचे की सूची भर देता है। कोई भी एक चीज़ बदलते ही आप अपने हिसाब वाले सेटअप पर आ जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una configurazione compila l'elenco qui sotto. Cambiando anche un solo elemento passi a una configurazione personalizzata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazır kurulum aşağıdaki listeyi doldurur. Tek bir öğeyi değiştirmen seni kendi kurulumuna geçirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择场景会自动填写下面的列表。修改任何一项都会变成自定义场景。"
          }
        }
      }
    },
