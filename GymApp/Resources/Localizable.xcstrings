    "onboarding.availability.time.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Decides when a reminder would land, if you turn reminders on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide a qué hora llegaría un recordatorio, si los activas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Détermine le moment d’un rappel, si tu actives les rappels."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अगर आप रिमाइंडर चालू करें तो वे कब आएँगे, यह इससे तय होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Decide a che ora arriverebbe un promemoria, se li attivi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "알림을 켰을 때 언제 알릴지 정해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Decyduje, kiedy przyszłoby przypomnienie, jeśli je włączysz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hatırlatıcıları açarsan bildirimin ne zaman geleceğini belirler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你开启提醒，这决定提醒出现的时间。"
          }
        }
      }
    },
