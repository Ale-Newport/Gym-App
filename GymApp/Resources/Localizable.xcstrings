    "explain.volumeIncreased": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Increased %@ volume based on your recovery and recent performance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha aumentado el volumen de %@ según tu recuperación y tu rendimiento reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume %@ augmenté d’après ta récupération et tes performances récentes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी रिकवरी और हाल के प्रदर्शन के आधार पर %@ का वॉल्यूम बढ़ाया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aumentato il volume di %@ in base al tuo recupero e alle prestazioni recenti."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Większa objętość dla: %@ — na podstawie Twojej regeneracji i ostatnich wyników."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toparlanmana ve son performansına göre %@ hacmi artırıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你的恢复情况和近期表现，提高了%@的训练量。"
          }
        }
      }
    },
    "explain.volumeReduced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reduced %@ volume because recent sessions and recovery feedback suggested it was too much."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha reducido el volumen de %@ porque tus sesiones recientes y tus sensaciones apuntaban a que era demasiado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume %@ réduit parce que tes séances récentes et tes retours de récupération indiquaient que c’était trop."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ का वॉल्यूम घटाया, क्योंकि हाल के सेशन और रिकवरी फ़ीडबैक से लगा कि वह ज़्यादा था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ridotto il volume di %@ perché le sessioni recenti e i riscontri sul recupero indicavano che era troppo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniejsza objętość dla: %@ — ostatnie sesje i sygnały regeneracji wskazywały, że było jej za dużo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son seanslar ve toparlanma geri bildirimin fazla geldiğini gösterdiği için %@ hacmi azaltıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "近期训练和恢复反馈显示训练量偏多，因此降低了%@的训练量。"
          }
        }
      }
    },
