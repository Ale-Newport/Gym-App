        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı kas grupları dolaylı çalışılıyor, çünkü ekipmanın onlara doğrudan ulaşamıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些肌群只能间接练到，因为你的器械无法直接训练它们。"
          }
        }
      }
    },
    "programming.priority": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muscle group(s) you prioritised get extra sets and an earlier slot in the session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ grupo(s) muscular(es) que priorizaste reciben series extra y un hueco más temprano en la sesión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ groupe(s) musculaire(s) que tu as priorisé(s) reçoivent des séries en plus et une place plus tôt dans la séance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके प्राथमिकता वाले %@ मसल ग्रुप को अतिरिक्त सेट और सेशन में पहले की जगह मिलती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gruppi muscolari che hai messo in priorità ricevono serie extra e un posto più avanti nella sessione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Priorytetowe grupy mięśniowe (%@) dostają dodatkowe serie i wcześniejsze miejsce w sesji."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öncelik verdiğin %@ kas grubu fazladan set ve seansta daha erken bir sıra alır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你优先的 %@ 个肌群会获得额外组数，并被排在训练课更靠前的位置。"
          }
        }
      }
    },
    "programming.rationale.accessory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accessory work to finish the muscle off once the heavy lifting is done."
          }
        },
        "es": {
          "stringUnit": {
