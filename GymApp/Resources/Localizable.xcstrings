      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge builds a week around your goals, your equipment and the days you can actually train."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge monta tu semana a partir de tus objetivos, tu material y los días en los que de verdad puedes entrenar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge construit ta semaine autour de tes objectifs, de ton matériel et des jours où tu peux vraiment t’entraîner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge आपके लक्ष्यों, इक्विपमेंट और उन दिनों के हिसाब से हफ़्ता बनाता है जब आप सचमुच ट्रेनिंग कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge costruisce la settimana intorno ai tuoi obiettivi, alla tua attrezzatura e ai giorni in cui puoi allenarti davvero."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge가 목표, 장비, 실제로 운동할 수 있는 요일에 맞춰 한 주를 짜 줘요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge układa tydzień wokół Twoich celów, sprzętu i dni, w których naprawdę możesz trenować."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge; hedeflerine, ekipmanına ve gerçekten antrenman yapabildiğin günlere göre bir hafta kurar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge 会根据你的目标、器械和真正能训练的日子，为你安排一周。"
          }
        }
      }
    },
    "home.empty.title": {
