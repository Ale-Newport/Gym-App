        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido iniciar la cámara. Introduce el código de barras a mano."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’appareil photo n’a pas pu démarrer. Saisis le code-barres à la place."
          }
