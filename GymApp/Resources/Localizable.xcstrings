          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Objętość pchania i ciągnięcia jest zrównoważona w skali tygodnia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
