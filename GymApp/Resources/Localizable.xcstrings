    "onboarding.nutrition.pace.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How quickly your weight moves towards your target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con qué rapidez se mueve tu peso hacia tu objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À quelle vitesse ton poids se rapproche de ta cible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वज़न लक्ष्य की ओर कितनी तेज़ी से बढ़े।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanto in fretta il tuo peso si muove verso l'obiettivo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중이 목표를 향해 얼마나 빠르게 움직일지 정해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jak szybko Twoja waga zmierza do celu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilonun hedefine ne kadar hızlı yaklaşacağı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的体重朝目标移动的快慢。"
          }
        }
      }
    },
    "onboarding.nutrition.pace.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add your weight to see this as a weekly figure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade tu peso para verlo como cifra semanal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute ton poids pour voir cela sous forme de chiffre hebdomadaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना वज़न जोड़ें ताकि यह हफ़्तेवार आँकड़े के रूप में दिखे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
