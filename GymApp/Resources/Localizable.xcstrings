    "progression.explain.addSetUnloaded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add a set on %@, for %@ sets of %@ to %@ reps. There is no load to add, so volume is the next step."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade una serie en %@, hasta %@ series de %@ a %@ repeticiones. No hay carga que añadir, así que el siguiente paso es el volumen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute une série sur %@, soit %@ séries de %@ à %@ répétitions. Il n’y a pas de charge à ajouter, donc le volume est l’étape suivante."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ में एक सेट जोड़ें, कुल %@ सेट, %@ से %@ रेप्स के। लोड बढ़ाने को कुछ नहीं है, इसलिए अगला कदम वॉल्यूम है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi una serie su %@, per %@ serie da %@-%@ ripetizioni. Non c'è carico da aggiungere, quindi il passo successivo è il volume."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketine bir set ekle; %@ set × %@ ile %@ tekrar olsun. Eklenecek ağırlık yok, yani sıradaki adım hacim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 上增加一组，共 %@ 组，每组 %@ 到 %@ 次。没有负重可加，因此下一步是增加训练量。"
          }
        }
      }
    },
    "progression.explain.atMinimumLoad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat %@ at %@. That is the lightest this movement goes, so build reps here or switch to an easier variation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite %@ con %@. Es lo más ligero que admite este movimiento, así que suma repeticiones aquí o pasa a una variante más fácil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refais %@ à %@. C’est le plus léger possible sur ce mouvement : construis des répétitions ici ou passe à une variante plus facile."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को %@ पर दोहराएँ। इस मूवमेंट में इससे हल्का कुछ नहीं है, इसलिए यहीं रेप्स बढ़ाएँ या किसी आसान वैरिएशन पर जाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti %@ a %@. È il carico più leggero possibile per questo movimento, quindi costruisci qui le ripetizioni oppure passa a una variante più facile."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketini %@ ağırlıkla tekrarla. Bu, bu hareketin inebildiği en hafif değer; burada tekrar biriktir ya da daha kolay bir varyasyona geç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 保持在 %@。这已经是这个动作最轻的负重，可以在这里增加次数，或换一个更容易的变式。"
          }
        }
      }
    },
    "progression.explain.bankBeforeBigJump": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping %@ at %@ for one more session. The smallest step available is %@, which is %@ percent of the current load, so it is worth banking another solid session first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se queda en %@ una sesión más. El salto más pequeño disponible es %@, que es un %@ por ciento de la carga actual, así que conviene sumar antes otra sesión sólida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reste à %@ pour une séance de plus. Le plus petit palier disponible est %@, soit %@ pour cent de la charge actuelle : mieux vaut engranger une séance solide de plus d’abord."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को एक और सेशन के लिए %@ पर ही रख रहे हैं। सबसे छोटा उपलब्ध कदम %@ है, जो मौजूदा लोड का %@ प्रतिशत बैठता है, इसलिए एक और मज़बूत सेशन जमा कर लेना बेहतर है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ resta a %@ per un'altra sessione. Il salto più piccolo disponibile è %@, cioè il %@ per cento del carico attuale, quindi conviene mettere da parte prima un'altra sessione solida."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bir seans daha %@ değerinde kalıyor. Mevcut en küçük adım %@; bu da şu anki ağırlığın yüzde %@ kadarı, yani önce bir sağlam seans daha biriktirmeye değer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 保持在 %@，再练一次。可用的最小增量是 %@，相当于当前负重的百分之 %@，因此值得先再积累一次扎实的训练。"
          }
        }
      }
    },
    "progression.explain.bankSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keeping %@ at %@. You are %@ of %@ good sessions towards the next load increase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se queda en %@. Llevas %@ de %@ sesiones buenas para la próxima subida de carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reste à %@. Tu en es à %@ bonnes séances sur %@ avant la prochaine hausse de charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को %@ पर ही रख रहे हैं। अगली लोड बढ़ोतरी की ओर आपके %@ / %@ अच्छे सेशन हो चुके हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ resta a %@. Sei a %@ sessioni buone su %@ verso il prossimo aumento di carico."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ değerinde kalıyor. Bir sonraki ağırlık artışına giden %@ iyi seansın %@ tanesindesin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 保持在 %@。你已完成 %@ / %@ 次达标训练，之后就会提高负重。"
          }
        }
      }
    },
    "progression.explain.calibrate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Run one set of %@ at a load you can control, then rate how it felt. We will set the working load from your answer."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una serie de %@ con una carga que controles y luego valora cómo te ha sentado. Fijaremos la carga de trabajo con tu respuesta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais une série de %@ avec une charge que tu maîtrises, puis dis comment tu l’as ressentie. La charge de travail sera fixée à partir de ta réponse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ का एक सेट ऐसे लोड पर करें जिसे आप संभाल सकें, फिर बताएँ कि कैसा लगा। आपके जवाब से हम वर्किंग लोड तय कर देंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fai una serie di %@ con un carico che controlli, poi valuta come è andata. Imposteremo il carico di lavoro dalla tua risposta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketinden kontrol edebileceğin bir ağırlıkla tek set yap, sonra nasıl geldiğini değerlendir. Çalışma ağırlığını cevabına göre belirleyeceğiz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先用你能控制的重量做一组 %@，然后评价一下感受。我们会据此设定正式组的负重。"
          }
        }
      }
    },
    "progression.explain.deload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Deload week: %@ drops from %@ to %@, and from %@ to %@ sets. A lighter week now protects the next block."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Semana de descarga: %@ baja de %@ a %@, y de %@ a %@ series. Una semana suave ahora protege el próximo bloque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Semaine allégée : %@ passe de %@ à %@, et de %@ à %@ séries. Une semaine plus légère maintenant protège le bloc suivant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डीलोड हफ़्ता: %@ %@ से घटकर %@ हो जाता है, और %@ से %@ सेट रह जाते हैं। अभी का हल्का हफ़्ता अगले ब्लॉक को बचाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Settimana di scarico: %@ scende da %@ a %@ e da %@ a %@ serie. Una settimana più leggera ora protegge il blocco successivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafif hafta: %@ %@ değerinden %@ değerine, %@ setten %@ sete iner. Şimdi hafif bir hafta, sonraki bloğu korur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
