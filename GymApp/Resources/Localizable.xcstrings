    "settings.notifications.weightFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A reading at the same time each day keeps your weight trend steady."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una medición a la misma hora cada día mantiene estable tu tendencia de peso."
