    "programming.balance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push and pull volume are balanced across the week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen de empuje y el de tirón están equilibrados durante la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume de poussée et de tirage est équilibré sur la semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे हफ़्ते में पुश और पुल वॉल्यूम संतुलित हैं।"
          }
        },
        "it": {
