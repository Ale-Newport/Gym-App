    "settings.legal.food.openFoodFacts": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Searching for a packaged product or scanning a barcode looks it up on Open Food Facts, whose data is published under the Open Database Licence (ODbL)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Buscar un producto envasado o escanear un código de barras lo consulta en Open Food Facts, cuyos datos se publican bajo la Open Database Licence (ODbL)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher un produit emballé ou scanner un code-barres interroge Open Food Facts, dont les données sont publiées sous licence Open Database (ODbL)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी पैकेट वाले प्रोडक्ट को खोजने या बारकोड स्कैन करने पर उसे Open Food Facts पर देखा जाता है, जिसका डेटा Open Database Licence (ODbL) के तहत प्रकाशित है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Cercare un prodotto confezionato o scansionare un codice a barre lo cerca su Open Food Facts, i cui dati sono pubblicati con licenza Open Database (ODbL)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paketli bir ürünü aramak ya da barkod okutmak, ürünü verileri Open Database lisansı (ODbL) ile yayımlanan Open Food Facts üzerinde sorgular."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "搜索包装商品或扫描条形码时，会在 Open Food Facts 上查询，其数据依据 Open Database Licence（ODbL）发布。"
          }
        }
      }
    },
