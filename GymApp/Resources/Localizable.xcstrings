        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ूड सेवा तक नहीं पहुँचा जा सका। ऑफ़लाइन नतीजे दिखाए जा रहे हैं।"
          }
        },
        "it": {
