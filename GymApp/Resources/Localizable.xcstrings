    "onboarding.step.generating.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume, then a split, then the exercises, then your targets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero el volumen, luego el split, luego los ejercicios y luego tus objetivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume, puis un split, puis les exercices, puis tes objectifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले वॉल्यूम, फिर स्प्लिट, फिर एक्सरसाइज़, फिर आपके लक्ष्य।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima il volume, poi lo split, poi gli esercizi, poi i tuoi obiettivi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "볼륨, 분할, 운동, 그리고 목표 순서로 정해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Objętość, potem split, potem ćwiczenia, na końcu Twoje cele."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce hacim, sonra split, sonra egzersizler, sonra hedeflerin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先算训练量，再定分化，然后挑动作，最后设定目标。"
          }
        }
      }
    },
    "onboarding.step.generating.title": {
      "extractionState": "manual",
      "localizations": {
