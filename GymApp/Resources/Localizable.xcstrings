    "progress.strength.chartFootnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The one-rep max is estimated from submaximal sets. The app never asks you to attempt a true single."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El máximo a una repetición se estima a partir de series submáximas. La app nunca te pide intentar un máximo real."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le 1RM est estimé à partir de séries sous-maximales. L’app ne te demande jamais de tenter une vraie répétition maximale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वन-रेप मैक्स सबमैक्सिमल सेट से अनुमानित होता है। ऐप कभी असली सिंगल लगाने को नहीं कहता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il massimale è stimato da serie submassimali. L'app non ti chiede mai di tentare un singolo massimale vero."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek tekrar maksimumu, maksimalin altındaki setlerden tahmin edilir. Uygulama senden asla gerçek bir tek tekrar denemesi istemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "1RM 由次极限组推算得出。App 从不会要求你尝试真正的极限单次。"
          }
        }
      }
    },
