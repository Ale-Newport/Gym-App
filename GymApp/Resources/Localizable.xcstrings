    "split.reason.activeRecovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six hard days is the practical ceiling, so the %@th is light conditioning and core work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Seis días duros es el tope práctico, así que el %@.º es acondicionamiento suave y trabajo de core."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Six jours durs est le plafond raisonnable, donc le %@e est du cardio léger et du gainage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "छह कठिन दिन व्यावहारिक सीमा है, इसलिए %@वाँ दिन हल्की कंडीशनिंग और कोर काम का रखा गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei giorni duri sono il tetto pratico, quindi il %@° è condizionamento leggero e lavoro sul core."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sześć ciężkich dni to praktyczny sufit, więc %@. dzień to lekka kondycja i praca nad korpusem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pratikte üst sınır altı zorlu gündür; bu yüzden %@. gün hafif kondisyon ve core çalışması olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周六天高强度已是现实上限，因此第 %@ 天安排轻度体能和核心训练。"
          }
        }
      }
    },
    "split.reason.fourWay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A four-way split across %@ days: enough sessions to separate the heavy work from the accessory work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un split de cuatro días repartido en %@ días: sesiones suficientes para separar el trabajo pesado del accesorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un split en quatre sur %@ jours : assez de séances pour séparer le travail lourd du travail d’isolation."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ दिनों में चार-भाग स्प्लिट: इतने सेशन कि भारी काम और एक्सेसरी काम अलग-अलग रह सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno split in quattro su %@ giorni: abbastanza sessioni per separare il lavoro pesante da quello complementare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Split czterodzielny na %@ dni: tyle sesji wystarczy, żeby oddzielić ciężką pracę od akcesoryjnej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güne yayılan dörtlü split: ağır çalışmayı yardımcı çalışmadan ayıracak kadar seans var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 天的四分化：训练课足够多，可以把大重量训练和辅助训练分开。"
          }
        }
      }
    },
    "split.reason.fullBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-body sessions %@ times a week: with this many days, training every muscle each session gives each one the most frequency."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesiones de cuerpo completo %@ veces por semana: con estos días, entrenar cada músculo en cada sesión le da a todos la máxima frecuencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des séances full body %@ fois par semaine : avec ce nombre de jours, travailler chaque muscle à chaque séance leur donne la meilleure fréquence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हफ़्ते में %@ बार फुल-बॉडी सेशन: इतने दिनों में हर सेशन में हर मसल की ट्रेनिंग करने से हर मसल को सबसे ज़्यादा बार काम मिलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessioni full body %@ volte a settimana: con questo numero di giorni, allenare ogni muscolo in ogni sessione dà a ciascuno la frequenza più alta."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesje na całe ciało %@ razy w tygodniu: przy tylu dniach trenowanie każdego mięśnia w każdej sesji daje mu największą częstotliwość."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada %@ kez tüm vücut seansı: bu kadar günle her seansta her kası çalıştırmak, her birine en yüksek sıklığı verir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周 %@ 次全身训练：在这个天数下，每次都练到全身能让每块肌肉获得最高频率。"
          }
        }
      }
    },
    "split.reason.posteriorEmphasis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A posterior-chain-led split across %@ days: your back, glutes and hamstrings get the first, freshest session of the cycle."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un split centrado en la cadena posterior repartido en %@ días: tu espalda, tus glúteos y tus isquiotibiales se llevan la primera sesión del ciclo, la más fresca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un split centré sur la chaîne postérieure sur %@ jours : ton dos, tes fessiers et tes ischio-jambiers ont la première séance du cycle, la plus fraîche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ दिनों में पोस्टीरियर-चेन प्रधान स्प्लिट: आपकी पीठ, ग्लूट्स और हैमस्ट्रिंग को चक्र का पहला, सबसे ताज़ा सेशन मिलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno split guidato dalla catena posteriore su %@ giorni: schiena, glutei e femorali si prendono la prima sessione del ciclo, la più fresca."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Split z naciskiem na taśmę tylną na %@ dni: plecy, pośladki i dwugłowe uda dostają pierwszą, najświeższą sesję cyklu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güne yayılan arka zincir ağırlıklı split: sırtın, kalçan ve arka bacağın döngünün ilk, en dinç seansını alır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 天的后链主导分化：背部、臀部和腘绳肌会在循环中最先、也最有精力时被训练。"
          }
        }
      }
    },
    "split.reason.pplUpperLower": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push, pull and legs plus an upper/lower block across %@ days: it fits a second pass at every muscle into the week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuje, tirón y pierna más un bloque de superior/inferior en %@ días: mete una segunda pasada por cada músculo en la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Push, pull et jambes plus un bloc haut/bas sur %@ jours : cela fait tenir un deuxième passage sur chaque muscle dans la semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ दिनों में पुश, पुल और लेग्स के साथ एक अपर/लोअर ब्लॉक: इससे हफ़्ते में हर मसल पर दूसरी बार भी काम हो जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Push, pull e gambe più un blocco upper/lower su %@ giorni: fa entrare nella settimana un secondo passaggio su ogni muscolo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Push, pull i nogi plus blok góra/dół na %@ dni: mieści w tygodniu drugie podejście do każdego mięśnia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güne yayılan itiş, çekiş, bacak artı bir üst/alt bloğu: haftaya her kas için ikinci bir tur sığdırır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 天的推、拉、腿加上肢/下肢：让每块肌肉在一周内能被练到第二次。"
          }
        }
      }
    },
    "split.reason.pushPullLegs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push, pull and legs across %@ days: grouping muscles that work together means less overlap between sessions and more recovery for each."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Empuje, tirón y pierna en %@ días: agrupar músculos que trabajan juntos reduce el solape entre sesiones y da más recuperación a cada uno."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Push, pull et jambes sur %@ jours : regrouper les muscles qui travaillent ensemble réduit le chevauchement entre les séances et laisse plus de récupération à chacun."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ दिनों में पुश, पुल और लेग्स: साथ काम करने वाले मसल को एक साथ रखने से सेशनों में ओवरलैप कम होता है और हर मसल को ज़्यादा रिकवरी मिलती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Push, pull e gambe su %@ giorni: raggruppare i muscoli che lavorano insieme riduce la sovrapposizione tra sessioni e lascia più recupero a ciascuno."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Push, pull i nogi na %@ dni: grupowanie mięśni, które pracują razem, oznacza mniejsze nakładanie się sesji i więcej regeneracji dla każdej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güne yayılan itiş, çekiş ve bacak: birlikte çalışan kasları gruplamak seanslar arası örtüşmeyi azaltır ve her birine daha çok toparlanma bırakır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 天的推、拉、腿：把协同工作的肌肉分在一起，训练课之间重叠更少，每块肌肉恢复更充分。"
          }
        }
      }
    },
    "split.reason.specialisation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@-day split with a dedicated day for the muscles you want to prioritise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un split de %@ días con un día dedicado a los músculos que quieres priorizar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un split de %@ jours avec une journée dédiée aux muscles que tu veux prioriser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ दिन का स्प्लिट, जिसमें उन मसल के लिए एक अलग दिन है जिन्हें आप प्राथमिकता देना चाहते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno split di %@ giorni con una giornata dedicata ai muscoli che vuoi privilegiare."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Split na %@ dni z osobnym dniem dla mięśni, które chcesz traktować priorytetowo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öncelik vermek istediğin kaslara ayrılmış bir günü olan %@ günlük split."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 天的分化，其中有一天专门留给你想优先强化的肌肉。"
          }
        }
      }
    },
    "split.reason.torsoArmsLegs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Torso, shoulders and arms, then legs across %@ days: it gives the smaller muscles their own session instead of tacking them onto a long one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Torso, hombros y brazos, y luego pierna en %@ días: los músculos pequeños tienen su propia sesión en lugar de ir pegados a una larga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tronc, épaules et bras, puis jambes sur %@ jours : les petits muscles ont leur propre séance au lieu d’être ajoutés à une séance déjà longue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ दिनों में टोर्सो, कंधे और भुजाएँ, फिर लेग्स: इससे छोटे मसल को किसी लंबे सेशन के पिछलग्गू बनने के बजाय अपना सेशन मिलता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Torso, spalle e braccia, poi gambe su %@ giorni: dà ai muscoli più piccoli una sessione tutta loro invece di appiccicarli in coda a una lunga."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tułów, barki i ramiona, potem nogi na %@ dni: mniejsze mięśnie dostają własną sesję, zamiast być doklejane do długiej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güne yayılan gövde, omuz ve kol, ardından bacak: küçük kasları uzun bir seansın sonuna iliştirmek yerine onlara kendi seansını verir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 天的躯干、肩与手臂、腿部：让较小的肌肉拥有自己的训练课，而不是附加在一节冗长的课程后面。"
          }
        }
      }
    },
    "split.reason.upperLower": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An upper/lower split across %@ days: it hits every muscle twice a week while keeping each session a sensible length."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un split superior/inferior en %@ días: toca cada músculo dos veces por semana y mantiene cada sesión en una duración razonable."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un split haut/bas sur %@ jours : chaque muscle est travaillé deux fois par semaine tout en gardant des séances de durée raisonnable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ दिनों में अपर/लोअर स्प्लिट: हर मसल हफ़्ते में दो बार काम करता है और हर सेशन की लंबाई भी वाजिब रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uno split upper/lower su %@ giorni: colpisce ogni muscolo due volte a settimana tenendo ogni sessione di durata ragionevole."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Split góra/dół na %@ dni: trafia w każdy mięsień dwa razy w tygodniu, a sesje zostają rozsądnej długości."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güne yayılan üst/alt split: her kası haftada iki kez çalıştırırken seansları makul uzunlukta tutar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 天的上下肢分化：每块肌肉每周练到两次，同时让每节训练课保持合理长度。"
          }
        }
      }
    },
    "split.reason.upperLowerFull": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upper, lower and a full-body day across %@ days: the extra full-body session tops up frequency without adding a fourth training day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Superior, inferior y un día de cuerpo completo en %@ días: esa sesión extra sube la frecuencia sin añadir un cuarto día de entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haut, bas et une journée full body sur %@ jours : la séance full body en plus relève la fréquence sans ajouter un quatrième jour d’entraînement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ दिनों में अपर, लोअर और एक फुल-बॉडी दिन: अतिरिक्त फुल-बॉडी सेशन चौथा ट्रेनिंग दिन जोड़े बिना बारंबारता बढ़ा देता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Upper, lower e una giornata full body su %@ giorni: la sessione full body in più alza la frequenza senza aggiungere un quarto giorno di allenamento."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Góra, dół i dzień na całe ciało na %@ dni: dodatkowa sesja na całe ciało podbija częstotliwość bez czwartego dnia treningowego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ güne yayılan üst, alt ve bir tüm vücut günü: fazladan tüm vücut seansı, dördüncü bir antrenman günü eklemeden sıklığı yükseltir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 天的上肢、下肢加一天全身：额外的全身训练课提高了频率，又不必增加第四个训练日。"
          }
        }
      }
    },
