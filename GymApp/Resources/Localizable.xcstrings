    "import.confirmReplace.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything currently on this device will be deleted and replaced by the backup. This cannot be undone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que hay ahora en este dispositivo se borrará y lo sustituirá la copia. Esto no se puede deshacer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui se trouve sur cet appareil sera supprimé et remplacé par la sauvegarde. C’est irréversible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर अभी जो कुछ है वह मिटाकर बैकअप से बदल दिया जाएगा। यह वापस नहीं हो सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto quello che ora è su questo dispositivo verrà eliminato e sostituito dal backup. L'operazione non è reversibile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 있는 모든 데이터가 지워지고 백업 내용으로 바뀌어요. 되돌릴 수 없어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko, co jest teraz na tym urządzeniu, zostanie usunięte i zastąpione kopią. Tego nie da się cofnąć."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda şu anda ne varsa silinip yerine yedek yüklenecek. Bu işlem geri alınamaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机当前的全部内容会被删除，并替换为这份备份。此操作无法撤销。"
          }
        }
      }
    },
