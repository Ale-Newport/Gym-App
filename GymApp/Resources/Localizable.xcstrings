          }
        }
      }
    },
    "programming.cardio.afterLifting": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ conditioning block(s) a week, placed after your lifting as you asked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bloque(s) de acondicionamiento a la semana, colocados después de las pesas, como pediste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ bloc(s) de cardio par semaine, placé(s) après ta musculation, comme tu l’as demandé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हफ़्ते में %@ कंडीशनिंग ब्लॉक, आपके कहे अनुसार लिफ़्टिंग के बाद रखे गए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ blocchi di condizionamento a settimana, messi dopo i pesi come hai chiesto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bloki kondycyjne w tygodniu: %@, ustawione po treningu siłowym, tak jak prosiłeś."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada %@ kondisyon bloğu, istediğin gibi ağırlık çalışmasının ardına yerleştirildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周 %@ 个体能训练段，按你的要求安排在力量训练之后。"
          }
        }
      }
    },
    "programming.cardio.separate": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ conditioning session(s) a week, kept separate from your lifting as you asked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sesión(es) de acondicionamiento a la semana, separadas de las pesas, como pediste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ séance(s) de cardio par semaine, séparée(s) de ta musculation, comme tu l’as demandé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हफ़्ते में %@ कंडीशनिंग सेशन, आपके कहे अनुसार लिफ़्टिंग से अलग रखे गए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sessioni di condizionamento a settimana, tenute separate dai pesi come hai chiesto."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesje kondycyjne w tygodniu: %@, trzymane osobno od treningu siłowego, tak jak prosiłeś."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada %@ kondisyon seansı, istediğin gibi ağırlık çalışmasından ayrı tutuldu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周 %@ 节体能训练课，按你的要求与力量训练分开。"
          }
        }
      }
    },
    "programming.extended": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ set(s) were added because your sessions had time to spare."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha(n) añadido %@ serie(s) porque en tus sesiones sobraba tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ série(s) ajoutée(s) parce qu’il restait du temps dans tes séances."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ सेट जोड़े गए, क्योंकि आपके सेशन में समय बचा हुआ था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono state aggiunte %@ serie perché nelle tue sessioni avanzava tempo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodano serie: %@ — Twoje sesje miały zapas czasu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seanslarında fazladan vakit olduğu için %@ set eklendi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为你的训练课还有余量，增加了 %@ 组。"
          }
        }
      }
    },
    "programming.fallback.bodyweight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some slots fall back to bodyweight exercises, because nothing else in your equipment fits them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Algunos huecos recurren a ejercicios de peso corporal, porque nada de tu material encaja en ellos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Certaines places se replient sur des exercices au poids du corps, faute de matériel adapté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ जगहों पर बॉडीवेट एक्सरसाइज़ रखनी पड़ीं, क्योंकि आपके इक्विपमेंट में और कुछ फ़िट नहीं बैठता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alcuni posti ripiegano su esercizi a corpo libero, perché nella tua attrezzatura non c'è altro che vada bene."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Część miejsc wypełniają ćwiczenia z masą ciała, bo nic innego z Twojego sprzętu tam nie pasuje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bazı sıralar vücut ağırlığı egzersizlerine düşüyor, çünkü ekipmanında başka uyan bir şey yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有些位置退回到自重动作，因为你的器械里没有其他合适的选择。"
          }
        }
      }
    },
    "programming.fallback.group": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Some muscle groups are trained indirectly, because your equipment cannot reach them directly."
          }
        },
        "es": {
          "stringUnit": {
