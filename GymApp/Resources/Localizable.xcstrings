    "recovery.summary.fresh": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is holding you back today. Train as planned."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no hay nada que te frene. Entrena según el plan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne te freine aujourd’hui. Entraîne-toi comme prévu."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज कुछ भी आपको रोक नहीं रहा। योजना के मुताबिक ट्रेनिंग करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi non c'è nulla che ti trattenga. Allenati come da programma."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün seni tutan bir şey yok. Planladığın gibi çalış."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天没有什么拖后腿的，按计划训练就好。"
          }
        }
      }
    },
    "recovery.summary.low.groups": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Several muscle groups are still carrying a lot of fatigue. An easier session is the sensible choice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Varios grupos musculares siguen con bastante fatiga. Una sesión más suave es lo sensato."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plusieurs groupes musculaires portent encore beaucoup de fatigue. Une séance plus légère est le choix raisonnable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कई मसल ग्रुप में काफ़ी थकान बाकी है। आज हल्का सेशन रखना समझदारी होगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diversi gruppi muscolari portano ancora molta fatica. Una sessione più leggera è la scelta sensata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç kas grubu hâlâ epey yorgunluk taşıyor. Daha hafif bir seans mantıklı olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有几个肌群仍带着较多疲劳，今天选择轻松一些更合适。"
          }
        }
      }
    },
    "recovery.summary.low.systemic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Readiness is low right now. Keeping today light is the sensible choice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu preparación está baja ahora mismo. Lo sensato es tomarte hoy con calma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta forme est basse en ce moment. Rester léger aujourd’hui est le choix raisonnable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी तैयारी कम है। आज हल्का रखना समझदारी होगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In questo momento la prontezza è bassa. Tenere leggero oggi è la scelta sensata."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hazırlığın şu an düşük. Bugünü hafif tutmak mantıklı olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前身体状态偏低，今天放轻松一些更合适。"
          }
        }
      }
    },
    "recovery.summary.moderate.groups": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partly recovered. Some muscle groups are still carrying fatigue from recent work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperación parcial. Algunos grupos musculares aún arrastran fatiga del trabajo reciente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupération partielle. Certains groupes musculaires portent encore la fatigue des séances récentes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आंशिक रिकवरी। कुछ मसल ग्रुप में हाल के काम की थकान अब भी बाकी है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupero parziale. Alcuni gruppi muscolari portano ancora la fatica del lavoro recente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısmen toparlanmış. Bazı kas grupları son çalışmalardan hâlâ yorgunluk taşıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分恢复。有些肌群仍带着最近训练留下的疲劳。"
          }
        }
      }
    },
    "recovery.summary.moderate.systemic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Partly recovered. Overall readiness is a little below your usual."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recuperación parcial. Tu preparación general está algo por debajo de lo habitual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupération partielle. Ta forme générale est un peu en dessous de ton habitude."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आंशिक रिकवरी। कुल तैयारी आपकी सामान्य से थोड़ी कम है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Recupero parziale. La prontezza generale è un po' sotto il tuo solito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kısmen toparlanmış. Genel hazırlığın her zamankinin biraz altında."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "部分恢复。整体状态比你平时略低一些。"
          }
        }
      }
    },
    "recovery.summary.ready": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Recovery looks good for a full session."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La recuperación pinta bien para una sesión completa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La récupération est bonne pour une séance complète."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरे सेशन के लिए रिकवरी अच्छी लग रही है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il recupero è buono per una sessione completa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toparlanman tam bir seans için iyi görünüyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "恢复情况不错，可以完成一次完整训练。"
          }
        }
      }
    },
    "repo.error.fetchFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data could not be read just now. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahora mismo no se han podido leer tus datos. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes données n’ont pas pu être lues pour le moment. Réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा अभी पढ़ा नहीं जा सका। फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile leggere i tuoi dati in questo momento. Riprova."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się teraz odczytać Twoich danych. Spróbuj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerin şu anda okunamadı. Tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂时无法读取你的数据，请重试。"
          }
        }
      }
    },
    "repo.error.notEditable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This item comes from the built-in database and cannot be edited. Duplicate it to make your own version."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este elemento viene de la base de datos integrada y no se puede editar. Duplícalo para tener tu propia versión."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet élément vient de la base intégrée et ne peut pas être modifié. Duplique-le pour en faire ta propre version."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह चीज़ बिल्ट-इन डेटाबेस से आती है और एडिट नहीं की जा सकती। अपनी कॉपी बनाकर उसमें बदलाव करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elemento arriva dal database integrato e non può essere modificato. Duplicalo per crearne una tua versione."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten element pochodzi z wbudowanej bazy i nie da się go edytować. Zduplikuj go, żeby mieć własną wersję."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğe yerleşik veritabanından geliyor ve düzenlenemez. Kendi sürümünü oluşturmak için kopyala."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一项来自内置数据库，无法编辑。复制一份就可以改成自己的版本。"
          }
        }
      }
    },
    "repo.error.notFound": {
      "extractionState": "manual",
      "localizations": {
