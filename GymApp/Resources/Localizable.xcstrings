    "program.templates.saveFromMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session is copied into your library. Editing it in your program afterwards does not change the template."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La sesión se copia a tu biblioteca. Editarla después en tu programa no cambia la plantilla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La séance est copiée dans ta bibliothèque. La modifier ensuite dans ton programme ne change pas le modèle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेशन आपकी लाइब्रेरी में कॉपी हो जाएगा। बाद में प्रोग्राम में उसे एडिट करने से टेम्पलेट नहीं बदलता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sessione viene copiata nella tua libreria. Modificarla nel programma in seguito non cambia il modello."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션이 내 목록에 복사돼요. 그 뒤에 프로그램에서 수정해도 템플릿은 바뀌지 않아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesja zostaje skopiowana do Twojej biblioteki. Późniejsza edycja w programie nie zmienia szablonu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seans kütüphanene kopyalanır. Sonrasında programında düzenlemen şablonu değiştirmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这节训练课会被复制到你的模板库。之后在计划中修改它，不会改变模板。"
          }
        }
      }
    },
