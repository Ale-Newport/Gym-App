    "nutritionLog.energy.noTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No energy target set yet. Your intake is still totalled here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay objetivo de energía. Tu consumo se sigue sumando aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun objectif énergétique défini pour l’instant. Tes apports sont quand même totalisés ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई एनर्जी लक्ष्य तय नहीं है। फिर भी आपका कुल सेवन यहाँ जुड़ता रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora impostato un obiettivo energetico. Il totale di ciò che mangi viene comunque calcolato qui."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 열량 목표가 없어요. 섭취량은 그래도 여기에 합산돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie masz jeszcze celu energetycznego. Twoje spożycie i tak jest tu sumowane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz bir enerji hedefi yok. Aldıkların yine de burada toplanıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有设定热量目标，不过这里仍会累计你的摄入。"
          }
        }
      }
    },
