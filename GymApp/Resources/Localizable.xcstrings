    "onboarding.nutrition.meals.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How your daily target is divided up."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cómo se reparte tu objetivo diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comment ton objectif quotidien est réparti."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका दैनिक लक्ष्य कैसे बँटेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Come viene diviso il tuo obiettivo giornaliero."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 목표를 몇 끼로 나눌지 정해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tyle posiłków dzielimy Twój dzienny cel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük hedefinin kaça bölüneceği."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的每日目标会按餐数分配。"
          }
        }
      }
    },
    "onboarding.nutrition.meals.fourPlus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your protein gets spread more evenly across the day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu proteína se reparte de forma más uniforme a lo largo del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes protéines sont réparties plus régulièrement sur la journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका प्रोटीन पूरे दिन में ज़्यादा बराबरी से बँटेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue proteine si distribuiscono in modo più uniforme nella giornata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단백질이 하루에 더 고르게 나뉘어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje białko rozłoży się równiej w ciągu dnia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proteinin güne daha dengeli yayılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蛋白质会更均匀地分布在一天之中。"
          }
        }
      }
    },
    "onboarding.nutrition.meals.three": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fewer, larger meals, so protein per meal will be higher."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Menos comidas y más grandes, así que la proteína por comida será más alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Moins de repas, plus copieux : les protéines par repas seront plus élevées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम पर बड़े मील, इसलिए हर मील में प्रोटीन ज़्यादा रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Pasti meno numerosi e più abbondanti, quindi più proteine per pasto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끼니 수가 적고 양이 커서 한 끼 단백질이 더 많아져요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mniej, większych posiłków, więc białka na posiłek będzie więcej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha az ama daha büyük öğünler, yani öğün başına protein daha yüksek olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "餐数少、每餐更大，因此每餐的蛋白质会更高。"
          }
        }
      }
    },
    "onboarding.nutrition.pace": {
      "extractionState": "manual",
      "localizations": {
