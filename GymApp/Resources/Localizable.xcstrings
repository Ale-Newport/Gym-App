    "progress.adherence.consistencyNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Logging is a habit, not a test. A gap costs nothing but a little detail in the trend."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrar es un hábito, no un examen. Un hueco solo cuesta un poco de detalle en la tendencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Noter est une habitude, pas un examen. Un trou ne coûte qu’un peu de finesse dans la tendance."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दर्ज करना एक आदत है, कोई परीक्षा नहीं। एक दिन छूटने से बस ट्रेंड में थोड़ी बारीकी कम होती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registrare è un'abitudine, non un esame. Un buco costa solo un po' di dettaglio nella tendenza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt tutmak bir alışkanlıktır, sınav değil. Bir boşluk sana yalnızca trendde biraz ayrıntıya mal olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录是一种习惯，不是考试。漏掉几次只是让趋势少一点细节。"
          }
        }
      }
    },
