    "onboarding.step.equipment.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only exercises you can actually load will be suggested."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se te sugerirán ejercicios que de verdad puedas cargar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seuls les exercices que tu peux réellement charger te seront proposés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ वही एक्सरसाइज़ सुझाई जाएँगी जिन्हें आप सचमुच लोड कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti verranno proposti solo esercizi che puoi davvero caricare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제로 중량을 걸 수 있는 운동만 추천해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proponujemy tylko ćwiczenia, które naprawdę masz czym obciążyć."
