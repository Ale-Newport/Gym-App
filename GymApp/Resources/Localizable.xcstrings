    "nutritionLog.recent.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Foods you log appear here, newest first, so a repeat is one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los alimentos que registres aparecen aquí, los más recientes primero, para repetirlos con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aliments que tu enregistres apparaissent ici, du plus récent au plus ancien, pour les reprendre d’un geste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके दर्ज किए फ़ूड यहाँ आते हैं, नए पहले, ताकि दोबारा दर्ज करना एक टैप का काम रहे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli alimenti che registri compaiono qui, dal più recente, così ripeterli è questione di un tocco."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록한 음식이 최신 순으로 쌓여서, 같은 걸 다시 기록할 땐 한 번만 누르면 돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane produkty pojawiają się tutaj, od najnowszych, więc powtórka to jedno dotknięcie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğin besinler en yenisi üstte olacak şekilde burada görünür; tekrarı tek dokunuş."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你记录过的食物会出现在这里，最新的排在前面，重复记录只要点一下。"
          }
        }
      }
    },
    "nutritionLog.recent.emptyTitle": {
      "extractionState": "manual",
      "localizations": {
