    "home.nutrition.noTargetMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set one and this card starts tracking what is left in your day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca uno y esta tarjeta empezará a llevar la cuenta de lo que te queda en el día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définis-en un et cette carte commencera à suivre ce qu’il te reste dans la journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक लक्ष्य तय करें और यह कार्ड बताने लगेगा कि आपके दिन में कितना बाकी है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impostane uno e questa scheda inizierà a mostrarti quanto ti resta nella giornata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표를 정하면 오늘 얼마나 남았는지 여기서 알려 줘요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw go, a ta karta zacznie pokazywać, ile zostało Ci na dziś."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir hedef belirle; bu kart günün ne kadarının kaldığını takip etmeye başlasın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定一个，这张卡片就会开始显示今天还剩多少。"
          }
        }
      }
    },
