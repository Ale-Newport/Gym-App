        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने यह एक्सरसाइज़ लॉक की है, इसलिए यह ठीक वहीं रहती है जहाँ आपने रखी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai bloccato questo esercizio, quindi resta esattamente dove l'hai messo."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowałeś to ćwiczenie, więc zostaje dokładnie tam, gdzie je umieściłeś."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu egzersizi kilitledin, bu yüzden tam olarak koyduğun yerde kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你锁定了这个动作，因此它保持在你放置的位置。"
          }
        }
      }
    },
    "programming.rationale.primary": {
