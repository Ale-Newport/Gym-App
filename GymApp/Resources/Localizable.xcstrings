        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक शुरुआती बिंदु। आपके वज़न के ट्रेंड के साथ यह बदलता रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un punto di partenza. Si adatta man mano che la tendenza del tuo peso si muove."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "출발점이에요. 체중 추세에 따라 조정돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Punkt wyjścia. Będzie się zmieniać razem z trendem Twojej wagi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir başlangıç noktası. Kilo trendin değiştikçe o da ayarlanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个起点。它会随着你的体重趋势调整。"
          }
        }
      }
    },
    "onboarding.result.nutrition.off.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No daily target was set. You can turn tracking on in Settings whenever you want one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha fijado ningún objetivo diario. Puedes activar el registro en Ajustes cuando quieras uno."
