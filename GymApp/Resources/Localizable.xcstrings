    },
    "program.settings.deload.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are told when a lighter week looks like the right next step. Nothing changes until you accept it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te avisamos cuando una semana más ligera parezca el siguiente paso. No cambia nada hasta que lo aceptes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es prévenu quand une semaine plus légère semble être la bonne suite. Rien ne change tant que tu n’as pas accepté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब हल्का हफ़्ता सही अगला कदम लगेगा, आपको बता दिया जाएगा। जब तक आप मंज़ूर न करें, कुछ नहीं बदलेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti avvisiamo quando una settimana più leggera sembra il passo giusto. Non cambia nulla finché non accetti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가벼운 주가 다음 단계로 적절해 보이면 알려 드려요. 받아들이기 전에는 아무것도 바뀌지 않아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostaniesz sygnał, gdy lżejszy tydzień wygląda na właściwy następny krok. Nic się nie zmieni, dopóki tego nie zaakceptujesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daha hafif bir hafta doğru adım gibi göründüğünde sana söylenir. Sen kabul etmeden hiçbir şey değişmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当适合安排更轻的一周时，你会收到提示。在你接受之前不会有任何改动。"
          }
        }
      }
    },
    "program.settings.effectiveRIR": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Sessions are planned to finish about %lld reps short of failure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones se planifican para terminar unas %lld repeticiones antes del fallo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les séances sont prévues pour finir à environ %lld répétitions de l’échec."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेशन इस तरह बनाए जाते हैं कि आप फेल्योर से करीब %lld रेप्स पहले रुकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le sessioni sono pianificate per chiudere circa %lld ripetizioni prima del cedimento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션은 실패 지점까지 약 %lld회를 남기고 끝나도록 계획돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesje planujemy tak, żebyś kończył około %lld powtórzeń przed upadkiem mięśniowym."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seanslar, tükenmeye yaklaşık %lld tekrar kala bitecek şekilde planlanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练课会安排在距离力竭约 %lld 次的位置结束。"
          }
        }
      }
    },
    "program.settings.effortFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reps in reserve is how many more reps you could have done when you stopped a set. Higher means further from failure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las repeticiones en reserva son las que aún podrías haber hecho al terminar una serie. Cuanto más alto, más lejos del fallo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les répétitions en réserve, c’est le nombre de répétitions que tu aurais encore pu faire en arrêtant une série. Plus le chiffre est haut, plus tu es loin de l’échec."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिज़र्व रेप्स यानी सेट रोकते समय आप और कितने रेप्स कर सकते थे। ज़्यादा का मतलब फेल्योर से ज़्यादा दूर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le ripetizioni di riserva sono quante ripetizioni avresti potuto fare ancora quando hai chiuso la serie. Più alto significa più lontano dal cedimento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "여유 반복 수는 세트를 멈췄을 때 더 할 수 있었던 횟수예요. 값이 클수록 실패 지점에서 멀어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapas powtórzeń (RIR) to liczba powtórzeń, które mógłbyś jeszcze zrobić w chwili zakończenia serii. Więcej znaczy dalej od upadku mięśniowego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedekte kalan tekrar, seti bıraktığında kaç tekrar daha yapabilecek olduğundur. Yüksek değer, tükenmeye daha uzak demektir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留次数指的是你停下这一组时还能再做多少次。数值越高，离力竭越远。"
          }
        }
      }
    },
    "program.settings.inSync": {
      "extractionState": "manual",
      "localizations": {
