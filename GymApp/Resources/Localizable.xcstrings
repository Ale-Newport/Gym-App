    "import.strategy.merge.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep what is on this device and add anything missing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene lo que hay en este dispositivo y añade lo que falte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde ce qui est sur cet appareil et ajoute ce qui manque."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस का डेटा रखें और जो छूटा है वह जोड़ दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene quello che c'è su questo dispositivo e aggiunge ciò che manca."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 있는 데이터는 그대로 두고 빠진 것만 추가해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowaj to, co masz na tym urządzeniu, i dodaj brakujące."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdakileri koru, eksik olanları ekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留本机已有的内容，只补上缺少的部分。"
          }
        }
      }
    },
