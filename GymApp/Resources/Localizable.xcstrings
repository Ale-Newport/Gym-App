        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikacja przestaje wybierać dla Ciebie to ćwiczenie. Nadal możesz dodać je samodzielnie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uygulama bu egzersizi senin için seçmeyi bırakır. Kendin yine de ekleyebilirsin."
