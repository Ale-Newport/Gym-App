    "nutrition.adjust.macroSplit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein stays where it is. The change goes to carbohydrate and fat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La proteína se queda igual. El cambio va a los hidratos y a la grasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les protéines ne bougent pas. Le changement va sur les glucides et les lipides."
