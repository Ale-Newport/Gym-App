    "nutritionLibrary.targets.overrideMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set whatever numbers suit you. Forge keeps using them until you switch back to automatic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija los números que te vengan bien. Forge los seguirá usando hasta que vuelvas al automático."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mets les chiffres qui te conviennent. Forge les utilisera tant que tu ne reviens pas à l’automatique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो आँकड़े आपको ठीक लगें वही रखें। जब तक आप वापस अपने आप पर न लौटें, Forge इन्हीं का उपयोग करेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta i numeri che preferisci. Forge continuerà a usarli finché non torni all'automatico."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "원하는 숫자로 정하면 돼요. 자동으로 되돌리기 전까지 Forge가 그 값을 계속 써요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw liczby, jakie Ci pasują. Forge będzie ich używać, dopóki nie wrócisz do trybu automatycznego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sana uyan rakamları gir. Otomatiğe dönene kadar Forge bunları kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "填上你觉得合适的数字。在你切回自动之前，Forge 会一直使用它们。"
          }
        }
      }
    },
    "nutritionLibrary.targets.proposalConsent": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes until you accept it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada hasta que lo aceptes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne change tant que tu n’as pas accepté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप मंज़ूरी न दें, कुछ नहीं बदलेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non cambia nulla finché non accetti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아들이기 전에는 아무것도 바뀌지 않아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic się nie zmieni, dopóki tego nie zaakceptujesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen kabul etmeden hiçbir şey değişmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你接受之前，什么都不会改变。"
          }
        }
      }
    },
    "nutritionLibrary.targets.proposedEnergy": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a day now, %@ a day if you accept."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ al día ahora, %@ al día si lo aceptas."
          }
        },
        "fr": {
