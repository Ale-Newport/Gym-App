    "settings.appearance.accessibilityNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge follows your text size, contrast and reduced-motion settings. Those live in iOS Settings, under Accessibility."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge sigue tus ajustes de tamaño de texto, contraste y movimiento reducido. Están en Ajustes de iOS, dentro de Accesibilidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge suit tes réglages de taille de texte, de contraste et d’animations réduites. Ils se trouvent dans les Réglages iOS, sous Accessibilité."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge आपके टेक्स्ट साइज़, कंट्रास्ट और कम-मोशन सेटिंग्स का पालन करता है। वे iOS Settings में Accessibility के तहत हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge segue le tue impostazioni di dimensione del testo, contrasto e riduzione del movimento. Si trovano nelle Impostazioni di iOS, in Accessibilità."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge; metin boyutu, kontrast ve hareket azaltma ayarlarını izler. Bunlar iOS Ayarları'nda, Erişilebilirlik altındadır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge 会跟随你的文字大小、对比度和减弱动态效果设置。这些选项位于 iOS 设置的辅助功能中。"
          }
        }
      }
    },
    "settings.appearance.footer": {
      "extractionState": "manual",
      "localizations": {
