    "program.templates.emptyExercises": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This template has no exercises in it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta plantilla no tiene ningún ejercicio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce modèle ne contient aucun exercice."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस टेम्पलेट में कोई एक्सरसाइज़ नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
