    "settings.legal.food.estimates": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Values are rounded for everyday use. They are estimates, not laboratory measurements."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los valores están redondeados para el uso diario. Son estimaciones, no mediciones de laboratorio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les valeurs sont arrondies pour un usage quotidien. Ce sont des estimations, pas des mesures de laboratoire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मान रोज़मर्रा के उपयोग के लिए गोल किए गए हैं। ये अनुमान हैं, प्रयोगशाला की माप नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I valori sono arrotondati per l'uso quotidiano. Sono stime, non misurazioni di laboratorio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Değerler günlük kullanım için yuvarlanmıştır. Bunlar tahmindir, laboratuvar ölçümü değildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数值为日常使用做了取整。它们是估算值，不是实验室实测。"
          }
        }
      }
    },
