    "active.finish.nothingMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log at least one set to save this session, or discard it and start again later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra al menos una serie para guardar esta sesión, o descártala y empieza otra más adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre au moins une série pour sauvegarder cette séance, ou abandonne-la et recommence plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह सेशन सेव करने के लिए कम से कम एक सेट दर्ज करें, या इसे छोड़कर बाद में फिर शुरू करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
