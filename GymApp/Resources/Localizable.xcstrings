    "program.volume.belowMinimumNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Below the %@ sets this plan treats as the useful minimum for this muscle group."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por debajo de las %@ series que este plan considera el mínimo útil para este grupo muscular."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En dessous des %@ séries que ce plan considère comme le minimum utile pour ce groupe musculaire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मसल ग्रुप के लिए यह प्लान जिन %@ सेट को उपयोगी न्यूनतम मानता है, उससे कम।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sotto le %@ serie che questo piano considera il minimo utile per questo gruppo muscolare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 근육 그룹에서 의미 있는 최소치로 보는 %@세트보다 적어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poniżej %@ serii, które ten plan traktuje jako użyteczne minimum dla tej grupy mięśniowej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu planın bu kas grubu için yararlı alt sınır saydığı %@ setin altında."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "低于本计划认为这个肌群有效的最低 %@ 组。"
          }
        }
      }
    },
    "program.volume.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add exercises to your sessions and the weekly volume they add up to shows up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade ejercicios a tus sesiones y aquí verás el volumen semanal que suman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute des exercices à tes séances et le volume hebdomadaire qu’ils représentent apparaîtra ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने सेशन में एक्सरसाइज़ जोड़ें और उनसे बनने वाला साप्ताहिक वॉल्यूम यहाँ दिखने लगेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi esercizi alle tue sessioni e qui comparirà il volume settimanale che ne risulta."
          }
        },
        "ko": {
