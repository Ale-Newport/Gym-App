    "nutritionLog.search.promptMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Type at least two letters to search your own foods and the built-in database."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escribe al menos dos letras para buscar en tus alimentos y en la base de datos integrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisis au moins deux lettres pour chercher dans tes aliments et dans la base intégrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने फ़ूड और बिल्ट-इन डेटाबेस में खोजने के लिए कम से कम दो अक्षर टाइप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Digita almeno due lettere per cercare tra i tuoi alimenti e nel database integrato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 글자 이상 입력하면 내 음식과 내장 데이터베이스를 검색해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz co najmniej dwie litery, żeby przeszukać własne produkty i wbudowaną bazę."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi besinlerinde ve yerleşik veritabanında aramak için en az iki harf yaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入至少两个字，即可搜索你自己的食物和内置食物库。"
