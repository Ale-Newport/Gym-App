    "onboarding.restrictions.exclusions.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Search for anything you would rather not be given."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Busca cualquier cosa que prefieras que no te toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Cherche tout ce que tu préfères ne pas recevoir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। जो कुछ आप नहीं चाहते, उसे खोजकर जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Cerca qualsiasi cosa preferiresti non ricevere."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 받고 싶지 않은 운동을 검색해 보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Wyszukaj wszystko, czego wolisz nie dostawać."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Karşına çıkmasını istemediğin ne varsa ara."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。搜索你不希望被安排的动作。"
          }
        }
      }
    },
