        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체지방을 줄이면서 근육을 키우려면 하루 약 %@ kcal의 작은 적자와 충분한 단백질이 좋아요. 그래서 목표는 %@ kcal이에요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Budowanie mięśni przy jednoczesnym gubieniu tłuszczu wychodzi najlepiej na niewielkim deficycie około %@ kcal dziennie i przy dużej ilości białka, więc Twój cel to %@ kcal."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yağ kaybederken kas yapmak, günde yaklaşık %@ kcal'lik küçük bir açık ve bol proteinle en iyi sonucu verir; bu yüzden hedefin %@ kcal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "增肌同时减脂，最适合每天约 %@ kcal 的小幅热量缺口，并搭配充足蛋白质，因此你的目标是 %@ kcal。"
          }
        }
      }
    },
    "nutrition.energy.surplus": {
      "extractionState": "manual",
      "localizations": {
