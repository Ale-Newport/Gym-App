    "settings.equipment.dumbbellsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The sizes on your rack. Forge will not suggest a dumbbell you do not have."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los tamaños que hay en tu rack. Forge no te sugerirá una mancuerna que no tengas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les tailles présentes sur ton rack. Forge ne proposera pas un haltère que tu n’as pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके रैक पर मौजूद साइज़। Forge ऐसा डम्बल नहीं सुझाएगा जो आपके पास नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I pesi che hai sulla rastrelliera. Forge non ti proporrà un manubrio che non hai."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rafındaki ağırlıklar. Forge sende olmayan bir dumbbell'ı önermez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你哑铃架上的规格。Forge 不会建议你没有的哑铃。"
          }
        }
      }
    },
    "settings.equipment.emptyExplainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing selected, so Forge plans bodyweight sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada seleccionado, así que Forge planifica sesiones de peso corporal."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien de sélectionné, Forge planifie donc des séances au poids du corps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ नहीं चुना गया, इसलिए Forge बॉडीवेट सेशन बनाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente di selezionato, quindi Forge pianifica sessioni a corpo libero."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir şey seçilmedi, bu yüzden Forge vücut ağırlığı seansları planlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未选择任何器械，因此 Forge 会安排自重训练。"
          }
        }
      }
    },
    "settings.equipment.ezBarWeight": {
