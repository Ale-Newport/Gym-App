    "program.settings.rebuildTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuild your program?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
