    "onboarding.generate.error.catalog": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exercise library is empty, so a program cannot be built."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La biblioteca de ejercicios está vacía, así que no se puede montar un programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La bibliothèque d’exercices est vide, aucun programme ne peut être construit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सरसाइज़ लाइब्रेरी खाली है, इसलिए प्रोग्राम नहीं बन सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La libreria esercizi è vuota, quindi non è possibile costruire un programma."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동 목록이 비어 있어서 프로그램을 만들 수 없어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Biblioteka ćwiczeń jest pusta, więc nie da się zbudować programu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Egzersiz kütüphanesi boş, bu yüzden program kurulamıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作库为空，无法生成训练计划。"
          }
        }
      }
    },
    "onboarding.generate.error.empty": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your equipment and the movements you ruled out leave nothing to program. Add some equipment, or remove an exclusion, and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu material y los movimientos que has descartado no dejan nada que programar. Añade algo de material, o quita alguna exclusión, y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton matériel et les mouvements que tu as écartés ne laissent rien à programmer. Ajoute du matériel, ou retire une exclusion, puis réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके इक्विपमेंट और आपके बाहर रखे मूवमेंट मिलकर प्रोग्राम बनाने लायक कुछ नहीं छोड़ते। कुछ इक्विपमेंट जोड़ें या कोई पाबंदी हटाकर फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua attrezzatura e i movimenti che hai escluso non lasciano nulla da programmare. Aggiungi qualche attrezzo, o togli un'esclusione, e riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가진 장비와 제외한 동작을 빼면 넣을 운동이 남지 않아요. 장비를 추가하거나 제외를 하나 풀고 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój sprzęt i wykluczone ruchy nie zostawiają nic do zaprogramowania. Dodaj trochę sprzętu albo usuń jedno wykluczenie i spróbuj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekipmanın ve elediğin hareketler geriye programlanacak bir şey bırakmıyor. Biraz ekipman ekle ya da bir kısıtı kaldırıp tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的器械和排除掉的动作模式让可安排的内容为零。添加一些器械，或取消一项排除，然后重试。"
          }
        }
      }
    },
    "onboarding.generate.manual": {
