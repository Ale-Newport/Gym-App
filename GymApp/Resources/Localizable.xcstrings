    "onboarding.basics.birthDate.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Age changes your estimated energy needs."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La edad cambia tu estimación de necesidades energéticas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’âge modifie l’estimation de tes besoins énergétiques."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उम्र से आपकी अनुमानित एनर्जी ज़रूरत बदलती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'età cambia la stima del tuo fabbisogno energetico."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나이에 따라 추정 열량이 달라져요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiek zmienia szacowane zapotrzebowanie energetyczne."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaş, tahmini enerji ihtiyacını değiştirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "年龄会影响你的预估热量需求。"
          }
        }
      }
    },
    "onboarding.basics.birthDate.skipped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without it, your energy estimate assumes an average adult age."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin ella, tu estimación de energía asume una edad adulta media."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans elle, ton estimation énergétique part d’un âge adulte moyen."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बिना आपका एनर्जी अनुमान औसत वयस्क उम्र मानकर लगेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza di essa, la stima energetica presume un'età adulta media."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "없으면 평균 성인 나이로 가정하고 열량을 추정해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez niej szacunek energii przyjmuje przeciętny wiek dorosłego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu olmadan enerji tahminin ortalama bir yetişkin yaşını varsayar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不填的话，热量估算会按成年人的平均年龄计算。"
          }
        }
      }
    },
