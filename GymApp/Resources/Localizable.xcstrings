    "nutritionLibrary.food.micronutrientsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Fill in only what the label prints — anything left blank stays unknown rather than counting as zero."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Rellena solo lo que ponga la etiqueta: lo que dejes en blanco queda como desconocido, no como cero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Ne remplis que ce que l’étiquette indique — ce qui reste vide reste inconnu au lieu de compter pour zéro."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। सिर्फ़ वही भरें जो लेबल पर लिखा है — जो खाली रहेगा वह शून्य नहीं, अज्ञात माना जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Compila solo ciò che l'etichetta riporta: quello che lasci vuoto resta sconosciuto invece di contare come zero."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 라벨에 적힌 것만 채워 주세요. 비워 둔 항목은 0이 아니라 모름으로 남아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Wpisz tylko to, co jest na etykiecie — puste pola zostaną jako nieznane, a nie jako zero."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Yalnızca etikette yazanları gir — boş bıraktıkların sıfır sayılmaz, bilinmiyor kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。只填标签上印出来的内容，留空的会记为未知，而不是零。"
          }
        }
      }
    },
