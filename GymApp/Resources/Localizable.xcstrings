            "state": "translated",
            "value": "Bu gün için kayıt yok"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一天还没有记录"
          }
        }
      }
    },
    "nutritionLibrary.micros.goalNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Where you have set your own figure for a nutrient, that is used instead of the reference intake."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hayas fijado tu propia cifra para un nutriente, se usa esa en lugar de la ingesta de referencia."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand tu as fixé ta propre valeur pour un nutriment, c’est elle qui est utilisée à la place de l’apport de référence."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिस पोषक तत्व के लिए आपने अपना आँकड़ा तय किया है, वहाँ संदर्भ मात्रा की जगह वही इस्तेमाल होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dove hai impostato un tuo valore per un nutriente, viene usato quello al posto dell'assunzione di riferimento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "직접 정한 값이 있는 영양소는 기준 섭취량 대신 그 값을 써요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli ustawiłeś własną wartość dla składnika, używamy jej zamiast spożycia referencyjnego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir besin ögesi için kendi değerini belirlediysen, referans alım yerine o kullanılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "如果你为某种营养素设过自己的数值，会用你的数值，而不是参考摄入量。"
          }
        }
      }
    },
