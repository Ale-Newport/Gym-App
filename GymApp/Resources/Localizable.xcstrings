    "program.volume.aboveCeilingNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Above the %@ sets this plan uses as a recovery ceiling. It is an estimate, so trust how you feel as well."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Por encima de las %@ series que este plan usa como techo de recuperación. Es una estimación, así que fíate también de cómo te encuentras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Au-dessus des %@ séries que ce plan retient comme plafond de récupération. C’est une estimation : fie-toi aussi à ton ressenti."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्लान जिन %@ सेट को रिकवरी की ऊपरी सीमा मानता है, उससे ज़्यादा। यह एक अनुमान है, इसलिए अपने अनुभव पर भी भरोसा करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sopra le %@ serie che questo piano usa come tetto per il recupero. È una stima, quindi fidati anche di come ti senti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 계획이 회복 상한으로 보는 %@세트보다 많아요. 추정치이니 몸 상태도 함께 살펴 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powyżej %@ serii, które ten plan przyjmuje jako sufit regeneracji. To szacunek, więc ufaj też temu, jak się czujesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu planın toparlanma tavanı olarak kullandığı %@ setin üstünde. Bu bir tahmindir; kendini nasıl hissettiğine de güven."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "高于本计划采用的恢复上限 %@ 组。这只是估算，也请相信自己的感受。"
          }
        }
      }
    },
