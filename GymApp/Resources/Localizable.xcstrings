    "settings.equipment.lastWeight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep at least one weight, so loads still have something to round onto."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja al menos un peso, para que las cargas sigan teniendo a qué redondearse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde au moins une charge, pour que les poids aient toujours quelque chose sur quoi s’arrondir."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कम से कम एक वज़न रहने दें, ताकि लोड गोल करने के लिए कुछ बचा रहे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni almeno un peso, così i carichi hanno ancora su cosa arrotondare."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En az bir ağırlık kalsın ki yükler yuvarlanacak bir değer bulsun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请至少保留一个重量，负重才有可取整的依据。"
          }
        }
      }
    },
