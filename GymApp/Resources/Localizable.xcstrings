    "workoutHub.today.restDayMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is scheduled today. Recovery is part of the plan, but you can train anyway if you feel good."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no hay nada programado. La recuperación forma parte del plan, pero si te encuentras bien puedes entrenar igualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est prévu aujourd’hui. La récupération fait partie du plan, mais tu peux t’entraîner quand même si tu te sens bien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज कुछ तय नहीं है। रिकवरी प्लान का हिस्सा है, पर मन हो तो आप ट्रेनिंग कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi non c'è nulla in programma. Il recupero fa parte del piano, ma se ti senti bene puoi allenarti lo stesso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天没有安排。恢复也是计划的一部分，不过如果状态好，你也可以照常训练。"
          }
        }
      }
    },
