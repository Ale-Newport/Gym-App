        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有训练计划"
          }
        }
      }
    },
    "home.today.restMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is scheduled today, and that is the plan. Recovery is when the work you already did turns into progress."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoy no hay nada programado, y así está previsto. La recuperación es cuando el trabajo que ya hiciste se convierte en progreso."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est prévu aujourd’hui, et c’est voulu. La récupération, c’est le moment où le travail déjà fait se transforme en progrès."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आज कुछ भी तय नहीं है, और यही योजना है। जो मेहनत आप कर चुके हैं वह रिकवरी के दौरान ही प्रगति में बदलती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Oggi non c'è nulla in programma, ed è voluto. Il recupero è il momento in cui il lavoro già fatto diventa progresso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘은 아무 일정도 없고, 그게 계획이에요. 이미 해 둔 운동이 성과로 바뀌는 시간이에요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dziś nic nie jest zaplanowane — i tak ma być. Regeneracja to moment, w którym wykonana praca zamienia się w postęp."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugün için bir şey planlanmadı, bu da planın bir parçası. Yaptığın iş, toparlanırken ilerlemeye dönüşür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天没有安排，这本身就是计划的一部分。恢复能让已完成的训练真正变成进步。"
          }
        }
      }
    },
