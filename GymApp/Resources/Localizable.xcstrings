    "program.settings.rebuildMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked exercises and your whole history are kept. The split, the sessions and every exercise you have not locked are chosen again from these settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ejercicios fijados y todo tu historial se mantienen. El split, las sesiones y todos los ejercicios que no hayas fijado se vuelven a elegir con estos ajustes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exercices verrouillés et tout ton historique sont conservés. Le split, les séances et chaque exercice non verrouillé sont choisis à nouveau à partir de ces réglages."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक की गई एक्सरसाइज़ और आपकी पूरी हिस्ट्री बनी रहेगी। स्प्लिट, सेशन और हर वह एक्सरसाइज़ जो लॉक नहीं है, इन्हीं सेटिंग्स से दोबारा चुनी जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli esercizi bloccati e tutta la tua cronologia vengono mantenuti. Lo split, le sessioni e ogni esercizio non bloccato vengono scelti di nuovo da queste impostazioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠근 운동과 전체 기록은 그대로예요. 분할과 세션, 잠그지 않은 운동은 이 설정을 바탕으로 다시 골라요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowane ćwiczenia i cała Twoja historia zostają. Split, sesje i każde niezablokowane ćwiczenie dobieramy na nowo z tych ustawień."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitlediğin egzersizler ve tüm geçmişin korunur. Split, seanslar ve kilitlemediğin her egzersiz bu ayarlara göre yeniden seçilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定的动作和全部历史都会保留。分化、训练课以及所有未锁定的动作，都会依据这些设置重新挑选。"
          }
        }
      }
    },
    "program.settings.rebuildPrompt": {
      "extractionState": "manual",
      "localizations": {
        "en": {
