        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की शुरुआत %@ पर %@ रेप्स के लिए, आपके %@ से लेकर (अनुमानित वन-रेप मैक्स %@)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parte da %@ per %@ ripetizioni, riportato dal tuo %@ (1RM stimato %@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketine %@ tekrar için %@ ağırlıkla başlıyorsun; %@ hareketinden taşındı (tahmini tek tekrar maksimumu %@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 从 %@ 开始，做 %@ 次，由你的 %@ 迁移而来（预估 1RM %@）。"
          }
        }
      }
    },
    "loadEstimate.explain.fromSeed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting %@ at %@ for %@ reps, worked back from the %@ for %@ reps you told us about."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ empieza con %@ para %@ repeticiones, calculado a partir de los %@ para %@ repeticiones que nos contaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ démarre à %@ pour %@ répétitions, calculé à partir des %@ pour %@ répétitions que tu nous as indiqués."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की शुरुआत %@ पर %@ रेप्स के लिए, जो आपके बताए %@ पर %@ रेप्स से पीछे की ओर निकाली गई है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parte da %@ per %@ ripetizioni, calcolato a ritroso dai %@ per %@ ripetizioni che ci hai indicato."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketine %@ tekrar için %@ ağırlıkla başlıyorsun; bu, bize söylediğin %@ tekrarlık %@ değerinden geriye hesaplandı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 从 %@ 开始，做 %@ 次，这是根据你填写的 %@ × %@ 次推算出来的。"
          }
        }
      }
    },
    "loadEstimate.explain.minimum": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting %@ at %@, the lightest setting available. Rate your first set and we will find the right load from there."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ empieza con %@, el ajuste más ligero disponible. Valora tu primera serie y desde ahí encontraremos la carga adecuada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ démarre à %@, le réglage le plus léger disponible. Évalue ta première série et on trouvera la bonne charge à partir de là."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की शुरुआत %@ पर, जो सबसे हल्की उपलब्ध सेटिंग है। अपना पहला सेट रेट करें और हम वहीं से सही लोड ढूँढ लेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parte da %@, l'impostazione più leggera disponibile. Valuta la prima serie e da lì troveremo il carico giusto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketine mevcut en hafif ayar olan %@ ile başlıyorsun. İlk setini değerlendir, doğru ağırlığı oradan bulalım."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 从 %@ 开始，这是可用的最轻设置。评价你的第一组，我们会据此找到合适的负重。"
          }
        }
      }
    },
