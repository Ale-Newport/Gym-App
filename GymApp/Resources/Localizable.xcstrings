        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음식 서비스에 연결하지 못했어요. 오프라인 결과를 보여 드릴게요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się połączyć z bazą produktów. Pokazuję wyniki offline."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besin servisine ulaşılamadı. Çevrimdışı sonuçlar gösteriliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接食物服务，正在显示离线结果。"
          }
        }
      }
    },
