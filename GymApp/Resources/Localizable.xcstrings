    "settings.goals.experienceEffect": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge picks exercises up to %@ level and leaves about %lld reps in reserve."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge elige ejercicios hasta nivel %@ y deja unas %lld repeticiones en reserva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge choisit des exercices jusqu’au niveau %@ et laisse environ %lld répétitions en réserve."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge %@ स्तर तक की एक्सरसाइज़ चुनता है और करीब %lld रेप्स रिज़र्व में छोड़ता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge sceglie esercizi fino al livello %@ e lascia circa %lld ripetizioni di riserva."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge %@ düzeyine kadar egzersiz seçer ve yaklaşık %lld tekrar yedekte bırakır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge 会挑选难度不超过%@的动作，并保留约 %lld 次。"
          }
        }
      }
    },
    "settings.goals.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first goal you pick is the one Forge plans around. Tap a goal again to remove it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer objetivo que elijas es el que Forge usa para planificar. Toca un objetivo otra vez para quitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier objectif que tu choisis est celui autour duquel Forge planifie. Touche un objectif à nouveau pour le retirer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पहला चुना लक्ष्य ही वह है जिसके इर्द-गिर्द Forge योजना बनाता है। हटाने के लिए लक्ष्य पर दोबारा टैप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo obiettivo che scegli è quello su cui Forge pianifica. Tocca di nuovo un obiettivo per toglierlo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk seçtiğin hedef, Forge'un etrafında plan yaptığı hedeftir. Kaldırmak için hedefe tekrar dokun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你最先选的目标是 Forge 规划的核心。再次点按可取消某个目标。"
          }
        }
      }
    },
    "settings.goals.months": {
