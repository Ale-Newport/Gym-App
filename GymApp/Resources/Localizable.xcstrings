          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mieści się w ustawionym budżecie na jedzenie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Belirlediğin besin bütçesine sığar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你设定的食物预算之内。"
          }
        }
      }
    },
    "meal.reason.calories": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %@ kcal, against the %@ kcal left for this meal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Unas %@ kcal, frente a las %@ kcal que te quedan para esta comida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %@ kcal, sur les %@ kcal qu’il reste pour ce repas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "करीब %@ kcal, जबकि इस मील के लिए %@ kcal बचे हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa %@ kcal, sulle %@ kcal rimaste per questo pasto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "약 %@ kcal이고, 이 식사에 남은 양은 %@ kcal이에요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Około %@ kcal przy %@ kcal, które zostały na ten posiłek."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaklaşık %@ kcal; bu öğün için kalan ise %@ kcal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %@ kcal，这一餐还剩 %@ kcal。"
          }
        }
      }
    },
    "meal.reason.favorite": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses foods you have marked as favourites."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa alimentos que has marcado como favoritos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise des aliments que tu as mis en favoris."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें वे फ़ूड हैं जिन्हें आपने पसंदीदा बनाया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa alimenti che hai messo tra i preferiti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즐겨찾기로 표시한 음식을 써요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzysta z produktów oznaczonych jako ulubione."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Favori olarak işaretlediğin besinleri kullanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用的是你收藏过的食物。"
          }
        }
      }
    },
    "meal.reason.frequentlyLogged": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Uses foods you log often, so it is quick to add."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa alimentos que registras a menudo, así que es rápido de añadir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise des aliments que tu enregistres souvent, donc rapides à ajouter."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें वे फ़ूड हैं जो आप अक्सर दर्ज करते हैं, इसलिए जोड़ना आसान है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa alimenti che registri spesso, quindi è veloce da aggiungere."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 기록하는 음식이라 빠르게 추가할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Korzysta z produktów, które często zapisujesz, więc szybko go dodasz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sık kaydettiğin besinleri kullanır, yani eklemesi hızlı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用的是你常记录的食物，添加起来很快。"
          }
        }
      }
    },
