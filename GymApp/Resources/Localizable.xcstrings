    "nutrition.adjust.staleData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most recent weigh-in is more than %@ days old, so the trend is out of date. Add a fresh one and the app will look again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pesaje más reciente tiene más de %@ días, así que la tendencia está desactualizada. Añade uno nuevo y la app volverá a mirarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière pesée date de plus de %@ jours, la tendance n’est donc plus à jour. Ajoutes-en une récente et l’app regardera de nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सबसे नया वज़न रिकॉर्ड %@ दिन से ज़्यादा पुराना है, इसलिए ट्रेंड पुराना पड़ गया है। एक नया रिकॉर्ड जोड़ें और ऐप फिर देखेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultima pesata risale a più di %@ giorni fa, quindi la tendenza non è aggiornata. Aggiungine una nuova e l'app darà un'altra occhiata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 최근 체중 기록이 %@일 넘게 지나서 추세가 오래됐어요. 새로 기록하면 다시 살펴볼게요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatnie ważenie ma więcej niż %@ dni, więc trend jest nieaktualny. Dodaj świeże, a aplikacja spojrzy jeszcze raz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "En son tartım %@ günden eski, yani trend güncel değil. Yeni bir tartım ekle, uygulama yeniden baksın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近一次体重记录已超过 %@ 天，趋势已经过时。补一次新的，App 会重新判断。"
