    "progress.strength.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Finish a workout, or widen the range, to see how your strength is moving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Termina un entrenamiento, o amplía el rango, para ver cómo se mueve tu fuerza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Termine une séance, ou élargis la période, pour voir comment ta force évolue."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी ताकत का रुख देखने के लिए एक वर्कआउट पूरा करें, या रेंज बढ़ा दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa un allenamento, o allarga l'intervallo, per vedere come si muove la tua forza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gücünün nasıl değiştiğini görmek için bir antrenman bitir ya da aralığı genişlet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成一次训练，或扩大时间范围，就能看到力量的变化。"
          }
        }
      }
    },
