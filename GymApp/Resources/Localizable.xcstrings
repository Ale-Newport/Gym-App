    "nutritionLog.custom.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Foods you create stay here, ready to log again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los alimentos que crees se quedan aquí, listos para volver a registrarlos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les aliments que tu crées restent ici, prêts à être enregistrés à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके बनाए फ़ूड यहीं रहते हैं, फिर से दर्ज करने के लिए तैयार।"
