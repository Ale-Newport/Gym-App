    "nutritionLibrary.suggest.noTargetMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggestions are built around what is left of your day, so they need a daily target first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sugerencias se montan sobre lo que te queda del día, así que primero necesitan un objetivo diario."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les suggestions se construisent autour de ce qu’il te reste dans la journée : il faut donc d’abord un objectif quotidien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सुझाव इस आधार पर बनते हैं कि आपके दिन में कितना बाकी है, इसलिए पहले एक दैनिक लक्ष्य चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proposte si costruiscono su ciò che ti resta della giornata, quindi serve prima un obiettivo giornaliero."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천은 오늘 남은 양을 기준으로 만들어져서, 하루 목표가 먼저 필요해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Propozycje budujemy wokół tego, co zostało Ci na dziś, więc najpierw potrzebny jest dzienny cel."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öneriler gününden kalana göre kurulur, bu yüzden önce bir günlük hedef gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "建议是围绕你今天还剩多少生成的，所以需要先有每日目标。"
          }
        }
      }
    },
    "nutritionLibrary.suggest.noTargetTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No daily target yet"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay objetivo diario"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore d’objectif quotidien"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई दैनिक लक्ष्य नहीं"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessun obiettivo giornaliero"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 하루 목표가 없어요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak dziennego celu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz günlük hedef yok"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还没有每日目标"
          }
        }
      }
    },
    "nutritionLibrary.suggest.noneMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are not enough foods here to build a meal that fits. Add a few foods, saved meals or recipes and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay alimentos suficientes para montar una comida que encaje. Añade unos cuantos alimentos, comidas guardadas o recetas y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas assez d’aliments ici pour composer un repas qui convienne. Ajoute quelques aliments, repas enregistrés ou recettes, puis réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़िट बैठने वाला मील बनाने के लिए यहाँ पर्याप्त फ़ूड नहीं हैं। कुछ फ़ूड, सेव किए मील या रेसिपी जोड़कर फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non ci sono abbastanza alimenti per comporre un pasto che vada bene. Aggiungi qualche alimento, pasto salvato o ricetta e riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 끼를 구성할 만큼 음식이 충분하지 않아요. 음식이나 저장한 식사, 레시피를 몇 개 추가하고 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za mało tu produktów, żeby ułożyć pasujący posiłek. Dodaj kilka produktów, zapisanych posiłków lub przepisów i spróbuj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uyan bir öğün kurmaya yetecek kadar besin yok. Birkaç besin, kayıtlı öğün veya tarif ekleyip tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里的食物还不够组成一顿合适的餐。添加一些食物、常用餐食或食谱后再试。"
          }
        }
      }
    },
