    "progress.records.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Records are spotted automatically as you train. Finish a few sessions and they appear here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los récords se detectan solos según entrenas. Termina unas cuantas sesiones y aparecerán aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les records sont repérés automatiquement pendant que tu t’entraînes. Termine quelques séances et ils apparaîtront ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रेनिंग के साथ रिकॉर्ड अपने आप पहचाने जाते हैं। कुछ सेशन पूरे करें और वे यहाँ दिखने लगेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I record vengono riconosciuti da soli mentre ti alleni. Completa qualche sessione e compariranno qui."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rekorlar sen çalıştıkça kendiliğinden yakalanır. Birkaç seans bitir, burada görünsünler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "纪录会在你训练时自动识别。完成几次训练后就会出现在这里。"
          }
        }
      }
    },
