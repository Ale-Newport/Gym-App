        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर हफ़्ते करीब %@ kg बढ़ाने के लिए रोज़ लगभग %@ kcal खाना होगा, जो मेंटेनेंस से करीब %@ kcal ज़्यादा है।"
