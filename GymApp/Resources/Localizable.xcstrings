    "program.settings.keepsHistory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your whole version history is kept, and so is every workout you have logged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se conserva todo tu historial de versiones y también todos los entrenamientos que has registrado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ton historique de versions est conservé, ainsi que chaque séance que tu as enregistrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी पूरी वर्शन हिस्ट्री बनी रहेगी, और आपका दर्ज किया हर वर्कआउट भी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutta la cronologia delle versioni viene mantenuta, e così ogni allenamento che hai registrato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 버전 기록과 기록한 모든 운동이 그대로 유지돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cała historia wersji zostaje, tak samo jak każdy zapisany trening."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm sürüm geçmişin ve kaydettiğin her antrenman korunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完整的版本历史会保留，你记录过的每次训练也一样。"
          }
        }
      }
    },
    "program.settings.keepsLocked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every exercise you locked stays exactly where you put it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los ejercicios que fijaste se quedan exactamente donde los pusiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque exercice que tu as verrouillé reste exactement où tu l’as mis."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लॉक की हुई हर एक्सरसाइज़ ठीक वहीं रहेगी जहाँ आपने रखी थी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni esercizio che hai bloccato resta esattamente dove l'hai messo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠근 운동은 모두 놓아 둔 자리에 그대로 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde zablokowane ćwiczenie zostaje dokładnie tam, gdzie je umieściłeś."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitlediğin her egzersiz tam olarak koyduğun yerde kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你锁定的每个动作都会留在原来的位置。"
          }
        }
      }
    },
    "program.settings.mismatch.block": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built in %lld-week blocks; you have asked for %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Montado en bloques de %lld semanas; has pedido %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construit en blocs de %lld semaines ; tu en as demandé %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह %lld हफ़्ते के ब्लॉक में बना था; आपने %lld माँगे हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruito a blocchi da %lld settimane; ne hai chieste %lld."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld주 블록으로 만들었는데 %lld주를 요청했어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbudowany w blokach po %lld tygodni; poprosiłeś o %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld haftalık bloklara göre kuruldu; sen %lld hafta istedin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成时按 %lld 周一个周期；你现在设定为 %lld 周。"
          }
        }
      }
    },
    "program.settings.mismatch.days": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built for %lld days a week; your schedule now has %lld."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Montado para %lld días por semana; tu horario tiene ahora %lld."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construit pour %lld jours par semaine ; ton emploi du temps en compte maintenant %lld."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह हफ़्ते के %lld दिनों के लिए बना था; अब आपके शेड्यूल में %lld हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruito per %lld giorni a settimana; ora i tuoi impegni ne prevedono %lld."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 %lld일 기준으로 만들었는데 지금 일정은 %lld일이에요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbudowany na %lld dni w tygodniu; Twój grafik ma teraz %lld."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada %lld güne göre kuruldu; takviminde şimdi %lld gün var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成时按每周 %lld 天；你的日程现在是 %lld 天。"
          }
        }
      }
    },
    "program.settings.mismatch.goals": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your goals have changed since it was built."
          }
        },
        "es": {
