    "active.substitute.equipmentMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ stays in your gym unless you remove it. Removing it changes what Forge suggests from now on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ sigue en tu gimnasio a menos que lo quites. Si lo quitas, cambiará lo que Forge te sugiera de ahora en adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ reste dans ta salle tant que tu ne le retires pas. Le retirer change ce que Forge te proposera à partir de maintenant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ आपके जिम में तब तक रहेगा जब तक आप उसे हटा न दें। हटाने पर Forge के आगे के सुझाव बदल जाएँगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ resta nella tua palestra finché non lo rimuovi. Rimuoverlo cambia quello che Forge ti propone da qui in avanti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "除非你移除，%@ 会一直留在你的健身房中。移除它会改变 Forge 今后的推荐。"
          }
        }
      }
    },
