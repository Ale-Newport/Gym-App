        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। वे मूवमेंट और एक्सरसाइज़ जो आप कभी नहीं देखना चाहते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Movimenti ed esercizi che preferiresti non vedere mai."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 아예 보고 싶지 않은 동작과 운동을 골라 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Ruchy i ćwiczenia, których wolisz nigdy nie widzieć."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Hiç karşına çıkmasını istemediğin hareketler ve egzersizler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。你不希望看到的动作模式和动作。"
          }
        }
      }
    },
