    "settings.profile.sexExplainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Used only in the energy and body-composition formulas. You can leave it unspecified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se usa solo en las fórmulas de energía y composición corporal. Puedes dejarlo sin especificar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisé uniquement dans les formules d’énergie et de composition corporelle. Tu peux ne rien indiquer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ एनर्जी और शरीर-संरचना के फ़ॉर्मूलों में इस्तेमाल होता है। आप इसे खाली भी छोड़ सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usato solo nelle formule per energia e composizione corporea. Puoi lasciarlo non specificato."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca enerji ve vücut kompozisyonu formüllerinde kullanılır. Belirtmeden de bırakabilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅用于热量和身体成分公式。你也可以不填。"
          }
        }
      }
    },
