    "settings.nutrition.restrictionsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Anything selected here is filtered out completely. Those foods never appear in a suggestion, rather than simply ranking lower."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que selecciones aquí se filtra por completo. Esos alimentos no aparecen nunca en una sugerencia, no es que salgan más abajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce qui est sélectionné ici est entièrement filtré. Ces aliments n’apparaissent jamais dans une suggestion, plutôt que d’être simplement moins bien classés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ चुनी गई हर चीज़ पूरी तरह छाँट दी जाती है। वे फ़ूड सुझावों में कभी नहीं आते — बस नीचे रैंक नहीं होते।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che selezioni qui viene filtrato completamente. Quegli alimenti non compaiono mai in una proposta, non si limitano a scendere in classifica."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Burada seçilenler tamamen filtrelenir. O besinler sıralamada geriye düşmez, hiç önerilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里选中的内容会被完全过滤掉。这些食物不会出现在建议中，而不只是排名靠后。"
          }
        }
      }
    },
