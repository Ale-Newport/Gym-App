    "nutritionLog.error.generic": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your food log could not be updated. Try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido actualizar tu registro de comidas. Inténtalo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton journal alimentaire n’a pas pu être mis à jour. Réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका फ़ूड लॉग अपडेट नहीं हो सका। फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato possibile aggiornare il diario alimentare. Riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "음식 기록을 업데이트하지 못했어요. 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zaktualizować dziennika jedzenia. Spróbuj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Besin günlüğün güncellenemedi. Tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法更新你的饮食记录，请重试。"
          }
        }
      }
    },
