    "program.versions.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you have a program, every change to it is recorded here with the reason behind it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando tengas un programa, cada cambio quedará registrado aquí con el motivo detrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que tu auras un programme, chaque changement sera enregistré ici avec la raison derrière."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोग्राम बन जाने के बाद उसमें होने वाला हर बदलाव यहाँ उसकी वजह के साथ दर्ज होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando avrai un programma, ogni sua modifica verrà registrata qui con il motivo che c'era dietro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프로그램이 생기면 모든 변경이 이유와 함께 여기에 기록돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy będziesz mieć program, każda jego zmiana trafi tutaj razem z powodem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir programın olduğunda, ona yapılan her değişiklik nedeniyle birlikte burada kaydedilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有了训练计划之后，它的每次变化都会连同原因记录在这里。"
          }
        }
      }
    },
