        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built entirely with Apple's frameworks. Forge contains no third-party code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Creada íntegramente con los frameworks de Apple. Forge no contiene código de terceros."
