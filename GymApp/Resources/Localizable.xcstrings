    "settings.about.rerunOnboarding.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Answer the setup questions again to rebuild your profile and program."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Responde otra vez a las preguntas iniciales para rehacer tu perfil y tu programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réponds à nouveau aux questions de configuration pour reconstruire ton profil et ton programme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी प्रोफ़ाइल और प्रोग्राम दोबारा बनाने के लिए सेटअप के सवालों के जवाब फिर से दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rispondi di nuovo alle domande iniziali per ricostruire profilo e programma."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Profilini ve programını yeniden kurmak için kurulum sorularını tekrar yanıtla."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新回答设置问题，重建你的个人资料和训练计划。"
          }
        }
      }
    },
