    "settings.profile.activityExplainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe your day away from the gym. Forge adds the work of your sessions on top of this."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Describe tu día fuera del gimnasio. Forge suma encima el trabajo de tus sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Décris ta journée en dehors de la salle. Forge ajoute le travail de tes séances par-dessus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिम के बाहर अपने दिन के बारे में बताएँ। आपके सेशन की मेहनत Forge इसके ऊपर जोड़ता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Descrivi la tua giornata fuori dalla palestra. Forge ci aggiunge sopra il lavoro delle tue sessioni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salon dışındaki gününü anlat. Forge, seanslarının yükünü bunun üzerine ekler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "描述你在健身房之外的一天。Forge 会在此基础上加上训练的消耗。"
          }
        }
      }
    },
