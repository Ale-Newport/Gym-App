    "progression.explain.holdDuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep %@ at %@ to %@ seconds a set. You held %@ seconds last time, so there is still room inside the target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %@ en %@-%@ segundos por serie. La última vez aguantaste %@ segundos, así que aún hay margen dentro del objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde %@ à %@ à %@ secondes par série. Tu as tenu %@ secondes la dernière fois, il reste donc de la marge dans l’objectif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को हर सेट %@ से %@ सेकंड पर रखें। पिछली बार आपने %@ सेकंड रोका था, इसलिए लक्ष्य के भीतर अभी जगह है।"
          }
        },
        "it": {
          "stringUnit": {
