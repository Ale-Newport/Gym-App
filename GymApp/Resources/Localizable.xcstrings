    "onboarding.equipment.increments.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "So every weight suggested is one your gym can actually make."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Así, cada peso sugerido es uno que tu gimnasio puede montar de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pour que chaque charge proposée soit une charge que ta salle peut vraiment composer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ताकि हर सुझाया वज़न वही हो जो आपका जिम सचमुच बना सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Così ogni peso proposto è uno che la tua palestra può davvero comporre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체육관에서 실제로 만들 수 있는 무게만 제안하기 위해서예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dzięki temu każdy proponowany ciężar da się złożyć na Twojej siłowni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Böylece önerilen her ağırlık, salonunda gerçekten kurulabilen bir ağırlık olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这样建议的每个重量，你的健身房都能凑出来。"
          }
        }
      }
    },
