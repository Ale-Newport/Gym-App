    "food.result.energyMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calories and the macros on this product do not add up. Check the label before logging it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las calorías y los macros de este producto no cuadran. Comprueba la etiqueta antes de registrarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calories et les macros de ce produit ne collent pas. Vérifie l’étiquette avant de l’enregistrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस प्रोडक्ट की कैलोरी और मैक्रो आपस में मेल नहीं खाते। दर्ज करने से पहले लेबल जाँच लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calorie e i macro di questo prodotto non tornano. Controlla l'etichetta prima di registrarlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 제품의 칼로리와 매크로가 서로 맞지 않아요. 기록하기 전에 라벨을 확인해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorie i makroskładniki na tym produkcie się nie sumują. Sprawdź etykietę, zanim to zapiszesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu üründeki kalori ile makrolar birbirini tutmuyor. Kaydetmeden önce etiketi kontrol et."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这件商品的热量和宏量营养素对不上。记录前请核对标签。"
          }
        }
      }
    },
