    "home.deload.note": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepting keeps every session in place and simply starts them lighter, with fewer sets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si aceptas, todas las sesiones se mantienen: simplemente empiezan más ligeras y con menos series."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Accepter garde toutes les séances en place et les fait simplement démarrer plus léger, avec moins de séries."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मंज़ूर करने पर हर सेशन अपनी जगह रहेगा, बस शुरुआत हल्के लोड और कम सेट से होगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accettando, tutte le sessioni restano al loro posto: partono solo più leggere e con meno serie."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아들여도 세션은 그대로 두고, 더 가볍게 더 적은 세트로 시작해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zgoda zostawia każdą sesję na miejscu — zaczną się po prostu lżej i z mniejszą liczbą serii."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kabul edersen tüm seansların yerinde kalır; yalnızca daha hafif ve daha az setle başlarlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接受之后，每节训练课都保留，只是起始更轻、组数更少。"
          }
        }
      }
    },
