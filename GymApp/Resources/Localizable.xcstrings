    "onboarding.restrictions.limitations.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Anything picked here is left out of your program. This is a preference, not a diagnosis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Lo que marques aquí se deja fuera de tu programa. Es una preferencia, no un diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Tout ce qui est coché ici est laissé hors de ton programme. C’est une préférence, pas un diagnostic."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। यहाँ चुनी गई कोई भी चीज़ आपके प्रोग्राम से बाहर रहेगी। यह आपकी पसंद है, कोई निदान नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Quello che scegli qui resta fuori dal tuo programma. È una preferenza, non una diagnosi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 여기서 고른 것은 프로그램에서 빠져요. 진단이 아니라 선호일 뿐이에요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Cokolwiek tu wybierzesz, zostanie pominięte w programie. To preferencja, nie diagnoza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Burada seçtiklerin programının dışında bırakılır. Bu bir tercihtir, teşhis değildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。这里选中的内容不会出现在你的训练计划里。这只是偏好，不是诊断。"
          }
        }
      }
    },
