    "progress.volume.tonnageFootnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only sets where load × reps means something are counted, so assisted and bodyweight work is left out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se cuentan las series en las que carga × repeticiones significa algo, así que el trabajo asistido y de peso corporal queda fuera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seules les séries où charge × reps a un sens sont comptées, le travail assisté et au poids du corps est donc laissé de côté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ वही सेट गिने जाते हैं जहाँ लोड × रेप्स का कोई मतलब बनता है, इसलिए असिस्टेड और बॉडीवेट काम छूट जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Vengono contate solo le serie in cui carico × ripetizioni ha senso, quindi il lavoro assistito e a corpo libero resta fuori."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ağırlık × tekrarın anlam taşıdığı setler sayılır; destekli ve vücut ağırlığı çalışmaları dışarıda kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只统计负重 × 次数有意义的组，因此助力和自重训练不计入。"
          }
        }
      }
    },
