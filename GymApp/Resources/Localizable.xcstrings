    "progress.volume.creditsFootnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Counted in set credits: a set counts fully for the muscle it targets and as a fraction for the muscles that assist, which is how your weekly targets are worked out."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se cuenta en créditos de serie: una serie cuenta entera para el músculo al que apunta y como fracción para los que ayudan, que es como se calculan tus objetivos semanales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Compté en crédits de séries : une série compte pleinement pour le muscle qu’elle cible et pour une fraction pour les muscles qui l’assistent, et c’est ainsi que tes objectifs hebdomadaires sont calculés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गिनती सेट क्रेडिट में होती है: जिस मसल पर सेट सीधे लगता है उसे पूरा क्रेडिट मिलता है और मदद करने वाले मसल को हिस्सा — इसी से आपके साप्ताहिक लक्ष्य निकाले जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conteggiati in crediti serie: una serie conta per intero per il muscolo che allena e in frazione per i muscoli che aiutano, ed è così che si calcolano i tuoi obiettivi settimanali."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Set kredisiyle sayılır: bir set, hedeflediği kas için tam, yardımcı kaslar için kesirli sayılır; haftalık hedeflerin de böyle hesaplanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
