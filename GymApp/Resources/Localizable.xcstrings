    "nutrition.macro.lowCalorieCompromise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this calorie level protein and fat alone fill the budget, so carbohydrate is set to zero. A slower pace would give you a more workable plan."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con estas calorías, la proteína y la grasa ya ocupan todo el margen, así que los hidratos quedan a cero. Un ritmo más lento te daría un plan más llevadero."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "À ce niveau de calories, les protéines et les lipides remplissent à eux seuls le budget, les glucides sont donc à zéro. Un rythme plus lent te donnerait un plan plus vivable."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस कैलोरी स्तर पर प्रोटीन और फैट ही पूरा बजट भर देते हैं, इसलिए कार्ब्स शून्य पर हैं। थोड़ी धीमी रफ़्तार चुनें तो योजना ज़्यादा व्यावहारिक बनेगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A questo livello calorico proteine e grassi da soli riempiono il budget, quindi i carboidrati sono a zero. Un ritmo più lento ti darebbe un piano più praticabile."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 칼로리에서는 단백질과 지방만으로 예산이 다 차서 탄수화물이 0이 됐어요. 속도를 늦추면 훨씬 현실적인 계획이 나와요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy tej kaloryczności samo białko i tłuszcz wypełniają budżet, więc węglowodany ustawiono na zero. Wolniejsze tempo dałoby Ci bardziej wykonalny plan."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kalori düzeyinde bütçeyi tek başına protein ve yağ dolduruyor, bu yüzden karbonhidrat sıfır. Daha yavaş bir tempo sana daha uygulanabilir bir plan verir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这个热量水平下，蛋白质和脂肪已经占满预算，因此碳水被设为零。放慢一点节奏会得到更可行的方案。"
          }
        }
      }
    },
    "nutrition.macro.protein": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein is set at %@ g, about %@ g per kg of body weight, which is the usual range for people who train."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La proteína queda en %@ g, unos %@ g por kg de peso corporal, que es el rango habitual para quien entrena."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les protéines sont fixées à %@ g, soit environ %@ g par kg de poids de corps, la fourchette habituelle pour les personnes qui s’entraînent."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोटीन %@ g तय है, यानी शरीर के हर kg वज़न पर करीब %@ g, जो ट्रेनिंग करने वालों के लिए सामान्य रेंज है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proteine sono fissate a %@ g, circa %@ g per kg di peso corporeo: è l'intervallo abituale per chi si allena."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단백질은 %@ g으로 잡았어요. 체중 1 kg당 약 %@ g으로, 운동하는 사람에게 흔한 범위예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Białko ustawiono na %@ g, czyli około %@ g na kg masy ciała — to zwykły zakres dla osób trenujących."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein %@ g olarak belirlendi; bu, vücut ağırlığının kilogramı başına yaklaşık %@ g eder ve antrenman yapanlar için alışılmış aralıktır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蛋白质设为 %@ g，约每公斤体重 %@ g，这是训练人群的常见区间。"
          }
        }
      }
    },
    "nutrition.macro.proteinAdjustedMass": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein is worked out from an adjusted body weight of %@ kg rather than your scale weight, which keeps the number realistic."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La proteína se calcula sobre un peso corporal ajustado de %@ kg en lugar de tu peso en la báscula, lo que mantiene la cifra realista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les protéines sont calculées sur un poids corrigé de %@ kg plutôt que sur ton poids sur la balance, ce qui garde le chiffre réaliste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोटीन आपके तराजू के वज़न की जगह %@ kg के समायोजित वज़न से निकाला गया है, ताकि आँकड़ा व्यावहारिक रहे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proteine sono calcolate su un peso corretto di %@ kg invece che sul peso della bilancia, così il numero resta realistico."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단백질은 체중계 숫자 대신 보정 체중 %@ kg을 기준으로 계산해서 현실적인 값이 나와요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Białko liczone jest ze skorygowanej masy ciała %@ kg, a nie z odczytu z wagi, dzięki czemu liczba pozostaje realistyczna."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein, tartıdaki kilon yerine %@ kg'lık düzeltilmiş bir vücut ağırlığından hesaplandı; böylece rakam gerçekçi kalıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蛋白质按调整后体重 %@ kg 计算，而不是体重秤读数，这样数字更实际。"
          }
        }
      }
    },
    "nutrition.macro.proteinCompromise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein was trimmed to %@ g so that carbohydrate did not fall to nothing at this calorie level."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La proteína se ha recortado a %@ g para que los hidratos no se quedasen en nada con estas calorías."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les protéines ont été ramenées à %@ g pour que les glucides ne tombent pas à zéro à ce niveau de calories."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोटीन घटाकर %@ g किया गया, ताकि इस कैलोरी स्तर पर कार्ब्स शून्य न हो जाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proteine sono state ridotte a %@ g perché a questo livello calorico i carboidrati non scendessero a zero."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 칼로리에서 탄수화물이 0이 되지 않도록 단백질을 %@ g으로 줄였어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Białko obniżono do %@ g, żeby przy tej kaloryczności węglowodany nie spadły do zera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu kalori düzeyinde karbonhidrat sıfıra düşmesin diye protein %@ g'a çekildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蛋白质下调到 %@ g，这样在当前热量下碳水才不会被压到零。"
          }
        }
      }
    },
    "nutrition.macro.proteinDeficit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein sits towards the top of that range because you are eating below maintenance, which helps protect muscle while you lose fat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La proteína se sitúa en la parte alta de ese rango porque estás comiendo por debajo del mantenimiento, y eso ayuda a proteger el músculo mientras pierdes grasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les protéines se placent en haut de cette fourchette parce que tu manges sous ton maintien, ce qui aide à préserver le muscle pendant que tu perds du gras."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोटीन उस रेंज के ऊपरी छोर के पास रखा गया है, क्योंकि आप मेंटेनेंस से कम खा रहे हैं — इससे फैट घटाते समय मसल बची रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proteine stanno verso la parte alta di quell'intervallo perché mangi sotto il mantenimento, e questo aiuta a proteggere il muscolo mentre perdi grasso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유지 칼로리보다 적게 먹고 있어서 단백질을 그 범위의 위쪽으로 잡았어요. 체지방을 줄이는 동안 근육을 지키는 데 도움이 돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Białko jest przy górnej granicy tego zakresu, bo jesz poniżej podtrzymania, a to pomaga chronić mięśnie podczas gubienia tłuszczu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İdamenin altında beslendiğin için protein bu aralığın üst ucuna yakın; bu da yağ kaybederken kasını korumana yardımcı olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "因为你处在热量缺口中，蛋白质取在区间偏上，有助于在减脂时保住肌肉。"
          }
        }
      }
    },
