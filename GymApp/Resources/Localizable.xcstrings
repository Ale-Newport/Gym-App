    "deload.reason.blockLength": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have trained hard for %@ weeks without an easy one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Llevas %@ semanas entrenando fuerte sin una semana suave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu t’entraînes dur depuis %@ semaines sans semaine allégée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपने बिना किसी आसान हफ़्ते के %@ हफ़्ते कड़ी ट्रेनिंग की है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ti alleni duramente da %@ settimane senza una più leggera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ haftadır hafif bir hafta olmadan sıkı çalışıyorsun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你已经连续 %@ 周高强度训练，中间没有安排轻松的一周。"
          }
        }
      }
    },
    "deload.reason.effortInflation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The same loads are costing more effort on %@ exercises."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las mismas cargas te cuestan más esfuerzo en %@ ejercicios."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les mêmes charges te coûtent plus d’effort sur %@ exercices."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ एक्सरसाइज़ में उतने ही लोड पर ज़्यादा मेहनत लग रही है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli stessi carichi ti costano più sforzo in %@ esercizi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı ağırlıklar %@ egzersizde daha çok zorlamaya mal oluyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %@ 个动作在相同负重下更吃力了。"
          }
        }
      }
    },
    "deload.reason.effortInflationSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your sessions are feeling harder at the same workload."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus sesiones se te hacen más duras con el mismo trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes séances te paraissent plus dures à charge de travail égale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उतने ही काम पर आपके सेशन ज़्यादा कठिन लग रहे हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue sessioni risultano più dure a parità di lavoro."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı iş yükünde seansların daha zor geliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在相同负荷下，你的训练感觉更吃力了。"
          }
        }
      }
    },
    "deload.reason.elevatedFatigue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ muscle groups are still carrying high fatigue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ grupos musculares siguen con la fatiga alta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ groupes musculaires portent encore une fatigue élevée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ मसल ग्रुप में अब भी ज़्यादा थकान है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gruppi muscolari portano ancora una fatica alta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ kas grubu hâlâ yüksek yorgunluk taşıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有 %@ 个肌群仍带着较高疲劳。"
          }
        }
      }
    },
    "deload.reason.lowReadiness": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your overall readiness has been low."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu preparación general lleva tiempo baja."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta forme générale est basse depuis un moment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी कुल तैयारी कम चल रही है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua prontezza generale è stata bassa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Genel hazırlığın bir süredir düşük."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的整体状态一直偏低。"
          }
        }
      }
    },
    "deload.reason.missedSets": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "About %@%% of planned sets have gone unfinished recently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Últimamente se ha quedado sin terminar en torno al %@%% de las series previstas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Environ %@%% des séries prévues n’ont pas été terminées ces derniers temps."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हाल में तय किए गए करीब %@%% सेट अधूरे रह गए हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Circa il %@%% delle serie previste è rimasto incompiuto di recente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son zamanlarda planlanan setlerin yaklaşık %%%@ kadarı tamamlanmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近约 %@%% 的计划组数没有完成。"
          }
        }
      }
    },
    "deload.reason.performanceRegression": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exercises have gone backwards over the last few sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ejercicios han retrocedido en las últimas sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ exercices ont reculé sur les dernières séances."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछले कुछ सेशन में %@ एक्सरसाइज़ पीछे गई हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ esercizi sono andati indietro nelle ultime sessioni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son birkaç seansta %@ egzersizde geri gidiş oldu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "最近几次训练里，有 %@ 个动作出现了退步。"
          }
        }
      }
    },
    "deload.reason.subjective": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your daily check-ins have been low for several days."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus revisiones diarias llevan varios días bajas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes bilans du jour sont bas depuis plusieurs jours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके रोज़ के चेक-इन कई दिनों से कम रहे हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi check-in giornalieri sono bassi da diversi giorni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük yanıtların birkaç gündür düşük."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的每日状态记录连续几天都偏低。"
          }
        }
      }
    },
    "deload.summary.recommended": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An easy week looks like the right next step: around %@%% less volume and around %@%% lighter loads."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una semana suave parece el siguiente paso: alrededor de un %@%% menos de volumen y cargas un %@%% más ligeras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une semaine allégée semble être la bonne suite : environ %@%% de volume en moins et des charges environ %@%% plus légères."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक आसान हफ़्ता सही अगला कदम लगता है: करीब %@%% कम वॉल्यूम और करीब %@%% हल्के लोड।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una settimana leggera sembra il passo giusto: circa %@%% di volume in meno e carichi più leggeri di circa %@%%."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hafif bir hafta doğru adım gibi görünüyor: yaklaşık %%%@ daha az hacim ve yaklaşık %%%@ daha hafif ağırlıklar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "接下来安排一个减量周比较合适：训练量减少约 %@%%，负重降低约 %@%%。"
          }
        }
      }
    },
    "deload.summary.watch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing needs to change yet, but a couple of things are worth keeping an eye on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hace falta cambiar nada, pero hay un par de cosas que conviene vigilar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’a besoin de changer pour l’instant, mais deux ou trois choses méritent d’être surveillées."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कुछ बदलने की ज़रूरत नहीं, पर कुछ बातों पर नज़र रखना ठीक रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Per ora non serve cambiare nulla, ma un paio di cose vale la pena tenerle d'occhio."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz değişmesi gereken bir şey yok ama göz önünde tutmaya değer birkaç nokta var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "目前还不需要调整，不过有几点值得留意。"
          }
        }
      }
    },
    "diet.flexitarian": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Flexitarian"
