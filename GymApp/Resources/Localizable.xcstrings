          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się zapisać tej zmiany. Spróbuj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu değişiklik kaydedilemedi. Tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存这项更改，请重试。"
          }
        }
      }
    },
    "repo.error.snapshotCodingFailed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The program history entry could not be stored."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido guardar esta entrada del historial del programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’entrée d’historique du programme n’a pas pu être enregistrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोग्राम हिस्ट्री की यह एंट्री सेव नहीं हो सकी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
