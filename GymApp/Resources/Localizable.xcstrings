    "program.editor.otherProgramsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only one program is active at a time. The others are kept, with their history, until you delete them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo hay un programa activo a la vez. Los demás se conservan, con su historial, hasta que los elimines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul programme est actif à la fois. Les autres sont conservés, avec leur historique, jusqu’à ce que tu les supprimes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक समय में सिर्फ़ एक ही प्रोग्राम सक्रिय रहता है। बाकी अपनी हिस्ट्री के साथ तब तक बने रहते हैं जब तक आप उन्हें मिटा न दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "È attivo un solo programma alla volta. Gli altri restano, con la loro cronologia, finché non li elimini."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 번에 하나의 프로그램만 활성화돼요. 나머지는 삭제하기 전까지 기록과 함께 보관돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktywny jest zawsze tylko jeden program. Pozostałe czekają razem z historią, dopóki ich nie usuniesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aynı anda yalnızca bir program etkindir. Diğerleri, geçmişleriyle birlikte sen silene kadar saklanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同一时间只有一份计划处于启用状态。其余的会连同历史一起保留，直到你删除它们。"
          }
        }
      }
    },
