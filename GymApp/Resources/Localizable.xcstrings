    "programming.volume.age": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume is set a little more conservatively to leave more room for recovery."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen se plantea algo más conservador para dejar más margen a la recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume est réglé un peu plus prudemment pour laisser plus de place à la récupération."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्यूम थोड़ा संभलकर रखा गया है, ताकि रिकवरी के लिए ज़्यादा जगह बचे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il volume è impostato un po' più prudente per lasciare più spazio al recupero."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Objętość ustawiona nieco ostrożniej, żeby zostawić więcej miejsca na regenerację."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Toparlanmaya daha çok alan kalsın diye hacim biraz daha temkinli belirlendi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练量安排得更保守一些，为恢复留出更多空间。"
          }
        }
      }
    },
    "programming.volume.deload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a deload week, so volume is deliberately reduced."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta es una semana de descarga, así que el volumen se reduce a propósito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est une semaine allégée, le volume est donc volontairement réduit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह डीलोड हफ़्ता है, इसलिए वॉल्यूम जानबूझकर कम रखा गया है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa è una settimana di scarico, quindi il volume è ridotto di proposito."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To lżejszy tydzień, więc objętość jest celowo zmniejszona."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu bir hafif hafta, bu yüzden hacim bilerek azaltıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是减量周，训练量被有意降低。"
          }
        }
      }
    },
    "programming.volume.fatigue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume is trimmed slightly because your recent sessions and check-ins suggest you are still recovering."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El volumen se recorta un poco porque tus sesiones recientes y tus revisiones apuntan a que aún te estás recuperando."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le volume est légèrement réduit parce que tes séances récentes et tes bilans indiquent que tu récupères encore."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉल्यूम थोड़ा घटाया गया है, क्योंकि आपके हाल के सेशन और चेक-इन बताते हैं कि आप अभी रिकवर हो रहे हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il volume è leggermente ridotto perché le sessioni recenti e i tuoi check-in indicano che stai ancora recuperando."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Objętość lekko przycięta, bo ostatnie sesje i Twoje wpisy sugerują, że wciąż się regenerujesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Son seansların ve günlük yanıtların hâlâ toparlandığını gösterdiği için hacim biraz kısıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练量略有削减，因为你最近的训练和状态记录显示你仍在恢复。"
          }
        }
      }
    },
    "programming.volume.timeCapped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume is capped by the time you have: %@ sessions of up to %@ minutes."
          }
        },
        "es": {
          "stringUnit": {
