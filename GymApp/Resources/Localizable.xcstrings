    "nutritionLibrary.targets.belowFloor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is below %@ a day, the lowest this app will suggest. You can still save it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto está por debajo de %@ al día, lo mínimo que esta app sugiere. Aun así puedes guardarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est en dessous de %@ par jour, le plus bas que cette app suggérera. Tu peux quand même l’enregistrer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह रोज़ %@ से कम है, जो इस ऐप की सबसे कम सलाह है। फिर भी आप इसे सेव कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è sotto %@ al giorno, il minimo che quest'app suggerisce. Puoi comunque salvarlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 %@ 미만이라 앱이 권장하는 하한보다 낮아요. 그래도 저장할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To poniżej %@ dziennie — najniższej wartości, jaką ta aplikacja sugeruje. Nadal możesz to zapisać."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, uygulamanın önereceği en düşük değer olan günde %@ değerinin altında. Yine de kaydedebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这低于每天 %@，也就是本 App 会建议的下限。你仍然可以保存。"
          }
        }
      }
    },
