    "program.settings.changesPlan": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The split, the sessions and any exercise you have not locked are chosen again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El split, las sesiones y cualquier ejercicio que no hayas fijado se vuelven a elegir."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le split, les séances et tout exercice non verrouillé sont choisis à nouveau."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्प्लिट, सेशन और हर वह एक्सरसाइज़ जो लॉक नहीं है, दोबारा चुनी जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lo split, le sessioni e ogni esercizio non bloccato vengono scelti di nuovo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "분할과 세션, 잠그지 않은 운동은 다시 골라요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Split, sesje i każde niezablokowane ćwiczenie dobieramy na nowo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Split, seanslar ve kilitlemediğin her egzersiz yeniden seçilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分化、训练课以及所有未锁定的动作都会重新挑选。"
          }
        }
      }
    },
