          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Praca akcesoryjna, żeby dokończyć mięsień, gdy ciężka robota jest już za Tobą."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağır iş bittikten sonra kası bitirmek için yardımcı çalışma."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助动作，在大重量训练结束后把这块肌肉练透。"
          }
        }
      }
    },
    "programming.rationale.cardio": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conditioning, placed after lifting so it does not blunt your strength work."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Acondicionamiento, colocado después de las pesas para que no reste al trabajo de fuerza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cardio, placé après la musculation pour ne pas émousser ton travail de force."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कंडीशनिंग, लिफ़्टिंग के बाद रखी गई ताकि यह आपके ताकत वाले काम को कमज़ोर न करे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condizionamento, messo dopo i pesi per non smorzare il lavoro di forza."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kondycja ustawiona po treningu siłowym, żeby nie stępiła pracy nad siłą."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kondisyon; güç çalışmanı köreltmesin diye ağırlıklardan sonraya yerleştirildi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体能训练，安排在力量训练之后，以免影响力量表现。"
          }
        }
      }
    },
    "programming.rationale.core": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Core work, kept to the end so it does not compromise your bracing on the big lifts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Trabajo de core, dejado para el final para no comprometer tu estabilidad en los básicos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Travail de gainage, gardé pour la fin pour ne pas compromettre ton maintien sur les gros mouvements."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोर का काम, आखिर में रखा गया ताकि बड़ी लिफ़्ट में आपकी पकड़ कमज़ोर न पड़े।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavoro sul core, tenuto alla fine per non compromettere la tenuta del tronco nei fondamentali."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Praca nad korpusem zostawiona na koniec, żeby nie osłabiła stabilizacji w dużych bojach."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Core çalışması; büyük hareketlerdeki karın içi basıncını bozmasın diye sona bırakıldı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核心训练，放在最后，以免影响大动作中的躯干支撑。"
          }
        }
      }
    },
    "programming.rationale.locked": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You locked this exercise, so it stays exactly where you put it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fijaste este ejercicio, así que se queda exactamente donde lo pusiste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as verrouillé cet exercice, il reste donc exactement où tu l’as mis."
