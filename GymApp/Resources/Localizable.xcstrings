    "settings.legal.software.apple": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge is built with Apple's frameworks under the Apple Developer Program Licence Agreement, and has no third-party packages."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge está creada con los frameworks de Apple bajo el Apple Developer Program License Agreement, y no tiene paquetes de terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge est construit avec les frameworks d’Apple, sous l’accord de licence du Apple Developer Program, et n’utilise aucun paquet tiers."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge, Apple Developer Program Licence Agreement के तहत Apple के फ़्रेमवर्क से बना है, और इसमें कोई थर्ड-पार्टी पैकेज नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge è realizzata con i framework di Apple secondo l'Apple Developer Program License Agreement e non usa pacchetti di terze parti."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge, Apple Developer Program Lisans Sözleşmesi kapsamında Apple'ın çatıları ile geliştirilmiştir ve üçüncü taraf paket içermez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge 基于 Apple 的框架构建，遵循 Apple Developer Program 许可协议，不含任何第三方包。"
          }
        }
      }
    },
