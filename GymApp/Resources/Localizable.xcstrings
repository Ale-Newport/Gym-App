    "nutritionLibrary.meals.nameFromDayMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "It is saved with the foods and amounts you logged for that meal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guarda con los alimentos y las cantidades que registraste en esa comida."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est enregistré avec les aliments et les quantités notés pour ce repas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उन्हीं फ़ूड और मात्राओं के साथ सेव होगा जो आपने उस मील में दर्ज किए थे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene salvato con gli alimenti e le quantità che avevi registrato per quel pasto."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그때 기록한 음식과 양 그대로 저장돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisujemy go z produktami i ilościami, które wpisałeś w tym posiłku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "O öğün için kaydettiğin besinler ve miktarlarla saklanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存时会带上你为那一餐记录的食物和分量。"
          }
        }
      }
    },
