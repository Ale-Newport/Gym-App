    "nutritionLibrary.meals.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save the meals you eat often and logging one takes a single tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda las comidas que haces a menudo y registrar una será cuestión de un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre les repas que tu manges souvent et les noter ne prendra qu’un geste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो मील आप अक्सर खाते हैं उन्हें सेव कर लें, फिर दर्ज करना एक ही टैप का काम रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva i pasti che fai spesso e registrarne uno diventa questione di un tocco."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 먹는 식사를 저장해 두면 한 번만 눌러 기록할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz posiłki, które jesz często, a dodanie takiego zajmie jedno dotknięcie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sık yediğin öğünleri kaydet; birini kaydetmek tek dokunuş olsun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把常吃的一餐存起来，以后记录只要点一下。"
          }
        }
      }
    },
