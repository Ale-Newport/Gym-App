    "exercises.history.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a set and your loads, best sets and estimated 1RM will show up here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una serie y aquí verás tus cargas, tus mejores series y tu 1RM estimado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre une série et tes charges, tes meilleures séries et ton 1RM estimé apparaîtront ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सेट दर्ज करें और आपके लोड, बेस्ट सेट और अनुमानित 1RM यहाँ दिखने लगेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra una serie e qui compariranno carichi, migliori serie e 1RM stimato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세트를 기록하면 중량, 최고 세트, 예상 1RM이 여기에 나타나요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz serię, a pojawią się tu Twoje ciężary, najlepsze serie i szacowany 1RM."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir set kaydet; ağırlıkların, en iyi setlerin ve tahmini 1RM'in burada görünsün."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录一组之后，负重、最佳组和预估 1RM 都会显示在这里。"
          }
        }
      }
    },
