    "food.error.offline": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are offline. Showing the built-in food database."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás sin conexión. Mostrando la base de datos de alimentos integrada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu es hors ligne. Affichage de la base d’aliments intégrée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप ऑफ़लाइन हैं। ऐप में मौजूद फ़ूड डेटाबेस दिखाया जा रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei offline. Viene mostrato il database alimenti integrato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 상태예요. 앱에 내장된 음식 데이터베이스를 보여 드릴게요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jesteś offline. Pokazuję wbudowaną bazę produktów."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışısın. Yerleşik besin veritabanı gösteriliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "当前离线，正在显示内置食物库。"
          }
        }
      }
    },
    "food.error.rateLimited": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many lookups just now. Try again in a moment."
