    "nutritionLibrary.food.tagsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tags are how Forge filters this food and decides when to suggest it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las etiquetas son lo que usa Forge para filtrar este alimento y decidir cuándo sugerirlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les étiquettes servent à Forge pour filtrer cet aliment et décider quand le proposer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "टैग से ही Forge इस फ़ूड को छाँटता है और तय करता है कि इसे कब सुझाना है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tag sono ciò con cui Forge filtra questo alimento e decide quando proportelo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge는 태그로 이 음식을 걸러 내고, 언제 추천할지 정해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Po tagach Forge filtruje ten produkt i decyduje, kiedy go zaproponować."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge bu besini etiketlere göre filtreler ve ne zaman önereceğine onlarla karar verir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge 用标签筛选这种食物，并决定什么时候推荐它。"
          }
        }
      }
    },
