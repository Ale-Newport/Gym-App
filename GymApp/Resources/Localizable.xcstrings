          "stringUnit": {
            "state": "translated",
            "value": "Ajoute du poids dès que les répétitions visées sont atteintes"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब भी लक्ष्य रेप्स पूरे हों, वज़न बढ़ाएँ"
          }
        },
        "it": {
          "stringUnit": {
