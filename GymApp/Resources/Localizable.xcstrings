    "program.name.newNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You will build the sessions yourself. Your schedule has room for %lld training days a week."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las sesiones las montarás tú. Tu horario tiene sitio para %lld días de entrenamiento a la semana."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu construiras les séances toi-même. Ton emploi du temps laisse la place à %lld jours d’entraînement par semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेशन आप खुद बनाएँगे। आपके शेड्यूल में हफ़्ते के %lld ट्रेनिंग दिनों की जगह है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruirai tu le sessioni. I tuoi impegni lasciano spazio a %lld giorni di allenamento a settimana."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세션은 직접 만들게 돼요. 일정상 주 %lld일까지 운동할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sesje zbudujesz sam. Twój grafik ma miejsce na %lld dni treningowych w tygodniu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seansları kendin kuracaksın. Takvimin haftada %lld antrenman gününe uygun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "训练课将由你自己安排。你的日程每周有 %lld 天可以训练。"
          }
        }
      }
    },
