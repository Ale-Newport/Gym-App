    "intents.startWorkout.description": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens Forge and starts today's session, or picks up the one already running."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre Forge y empieza la sesión de hoy, o retoma la que ya esté en marcha."
          }
