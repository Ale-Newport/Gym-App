    "onboarding.goals.muscles.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. These get the extra sets when there is room for them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Son los que se llevan las series extra cuando hay sitio para ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Ce sont eux qui reçoivent les séries en plus quand il y a de la place."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। जगह होने पर अतिरिक्त सेट इन्हीं को मिलते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Sono questi a ricevere le serie extra quando c'è spazio."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 여유가 있을 때 추가 세트가 이쪽으로 가요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. To one dostają dodatkowe serie, kiedy jest na nie miejsce."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Yer olduğunda fazladan setler bunlara gider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。有余量时，这些肌群会获得额外组数。"
