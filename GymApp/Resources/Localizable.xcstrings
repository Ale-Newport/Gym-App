    "settings.health.unavailable.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has no Health app, so Forge cannot connect to it. Everything else works as normal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no tiene la app Salud, así que Forge no puede conectarse a ella. Todo lo demás funciona con normalidad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas l’app Santé, Forge ne peut donc pas s’y connecter. Tout le reste fonctionne normalement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर Health ऐप नहीं है, इसलिए Forge उससे नहीं जुड़ सकता। बाकी सब सामान्य रूप से चलता रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha l'app Salute, quindi Forge non può collegarsi. Tutto il resto funziona normalmente."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda Sağlık uygulaması yok, bu yüzden Forge ona bağlanamıyor. Geri kalan her şey normal çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台设备没有健康 App，因此 Forge 无法连接。其余功能一切正常。"
          }
        }
      }
    },
