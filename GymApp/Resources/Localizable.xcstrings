    "nutritionLibrary.suggest.exclusionsMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing carrying these tags is suggested, from your diet and allergen settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se sugiere nada con estas etiquetas, según tus ajustes de dieta y alérgenos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien portant ces étiquettes n’est proposé, d’après tes réglages de régime et d’allergènes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी डाइट और एलर्जन सेटिंग्स के कारण इन टैग वाला कुछ भी नहीं सुझाया जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non viene proposto nulla che porti questi tag, in base alle tue impostazioni su dieta e allergeni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "식단과 알레르기 설정에 따라 이 태그가 붙은 음식은 추천하지 않아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic z tymi tagami nie jest proponowane — tak wynika z Twojej diety i ustawień alergenów."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Beslenme ve alerjen ayarlarına göre bu etiketleri taşıyan hiçbir şey önerilmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你的饮食和过敏原设置，带有这些标签的内容都不会被推荐。"
          }
        }
      }
    },
