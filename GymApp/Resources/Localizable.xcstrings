    "program.settings.deload": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Suggest easy weeks"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sugerir semanas suaves"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Proposer des semaines allégées"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आसान हफ़्ते सुझाएँ"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Proponi settimane leggere"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가벼운 주 제안"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Proponuj lżejsze tygodnie"
          }
        },
        "tr": {
          "stringUnit": {
