          }
        }
      }
    },
    "repo.error.stillReferenced": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This food is used in %@ saved meals or recipes. Delete it anyway?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este alimento se usa en %@ comidas o recetas guardadas. ¿Lo eliminas igualmente?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet aliment est utilisé dans %@ repas ou recettes enregistrés. Le supprimer quand même ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह फ़ूड %@ सेव किए मील या रेसिपी में इस्तेमाल हो रहा है। फिर भी मिटाएँ?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo alimento è usato in %@ pasti salvati o ricette. Vuoi eliminarlo comunque?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
