    "settings.health.readFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health never tells an app whether reading was allowed, so Forge can only say what it asks for. Anything it reads stays on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salud nunca le dice a una app si se le permitió leer, así que Forge solo puede decir qué pide. Todo lo que lee se queda en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Santé ne dit jamais à une app si la lecture a été autorisée : Forge ne peut donc indiquer que ce qu’elle demande. Tout ce qu’elle lit reste sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Health किसी ऐप को कभी नहीं बताता कि पढ़ने की अनुमति मिली या नहीं, इसलिए Forge सिर्फ़ यह बता सकता है कि वह क्या माँगता है। जो कुछ वह पढ़ता है, वह इसी डिवाइस पर रहता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salute non dice mai a un'app se la lettura è stata concessa, quindi Forge può solo dirti cosa chiede. Tutto ciò che legge resta su questo dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlık bir uygulamaya okumaya izin verilip verilmediğini asla söylemez; bu yüzden Forge yalnızca ne istediğini söyleyebilir. Okuduğu her şey bu cihazda kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康 App 从不告知应用读取是否被允许，因此 Forge 只能说明它请求了什么。读取到的内容都留在这台设备上。"
          }
        }
      }
    },
