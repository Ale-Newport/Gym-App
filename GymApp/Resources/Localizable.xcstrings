    "onboarding.restrictions.search.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing in the library matches “%@”. Try a shorter word."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nada en la biblioteca coincide con «%@». Prueba con una palabra más corta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien dans la bibliothèque ne correspond à « %@ ». Essaie un mot plus court."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लाइब्रेरी में “%@” से मिलता-जुलता कुछ नहीं है। कोई छोटा शब्द आज़माएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella libreria non c'è nulla che corrisponda a “%@”. Prova con una parola più corta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목록에 “%@”와 일치하는 것이 없어요. 더 짧은 단어로 찾아보세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic w bibliotece nie pasuje do „%@”. Spróbuj krótszego słowa."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kütüphanede “%@” ile eşleşen bir şey yok. Daha kısa bir kelime dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作库里没有匹配“%@”的内容。换个更短的词试试。"
          }
        }
      }
    },
