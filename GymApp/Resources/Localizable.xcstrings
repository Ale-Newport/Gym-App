          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 식이섬유와 미량 영양소를 채우는 데 도움이 돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dorzuca do dnia trochę błonnika i mikroskładników."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Güne biraz lif ve mikro besin katar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为这一天补充一些膳食纤维和微量营养素。"
          }
        }
      }
    },
    "meal.reason.protein": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fills most of the protein you have left, %@ g of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cubre casi toda la proteína que te queda, %@ g."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Remplit l’essentiel des protéines qu’il te reste, soit %@ g."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका बचा हुआ ज़्यादातर प्रोटीन पूरा करता है — %@ g।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Copre gran parte delle proteine che ti restano, %@ g."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오늘 남은 단백질의 대부분인 %@ g을 채워요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnia większość białka, które Ci zostało — %@ g."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalan proteinin büyük kısmını, %@ g kadarını doldurur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "补上今天剩余蛋白质的大部分，共 %@ g。"
          }
        }
      }
    },
    "meal.reason.recipe": {
