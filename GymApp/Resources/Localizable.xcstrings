    "workoutHub.today.autoProgressionOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatic progression is switched off, so today's numbers are the ones stored in your program."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La progresión automática está desactivada, así que los números de hoy son los que hay guardados en tu programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La progression automatique est désactivée : les chiffres du jour sont ceux enregistrés dans ton programme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने आप होने वाला प्रोग्रेशन बंद है, इसलिए आज के आँकड़े वही हैं जो आपके प्रोग्राम में सेव हैं।"
          }
        },
        "it": {
          "stringUnit": {
