        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복사했어요. 사본은 활성화하기 전까지 비활성 상태예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skopiowano. Kopia jest nieaktywna, dopóki jej nie włączysz."
