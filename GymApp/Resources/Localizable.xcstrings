    "onboarding.availability.days.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many days a week you can realistically train."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántos días a la semana puedes entrenar de forma realista."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de jours par semaine tu peux réellement t’entraîner."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हफ़्ते में कितने दिन आप सचमुच ट्रेनिंग कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quanti giorni a settimana puoi allenarti davvero."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일주일에 현실적으로 며칠 운동할 수 있는지 알려 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile dni w tygodniu realnie możesz trenować."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada gerçekçi olarak kaç gün antrenman yapabilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你每周现实中能训练几天。"
          }
        }
      }
    },
    "onboarding.availability.days.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Days a week: %lld — spaced out to leave recovery between sessions."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Días por semana: %lld, repartidos para dejar recuperación entre sesiones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jours par semaine : %lld — espacés pour laisser de la récupération entre les séances."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हफ़्ते में दिन: %lld — सेशन के बीच रिकवरी के लिए दूरी रखी गई है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Giorni a settimana: %lld, distribuiti per lasciare recupero tra le sessioni."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주 %lld일이에요. 세션 사이에 회복 시간이 남도록 배치해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dni w tygodniu: %lld — rozłożone tak, żeby między sesjami zostawało miejsce na regenerację."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada %lld gün — seanslar arasında toparlanma kalsın diye aralıklı yerleştirilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周 %lld 天，会分散安排，给训练之间留出恢复时间。"
          }
        }
      }
    },
