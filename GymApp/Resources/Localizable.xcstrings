    "progression.explain.lighterThanPlanned": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat %@ at %@. Last session was logged at %@, below the planned load, so it does not tell us whether the plan is right."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite %@ con %@. La última sesión se registró con %@, por debajo de la carga prevista, así que no nos dice si el plan es el adecuado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refais %@ à %@. La dernière séance a été enregistrée à %@, sous la charge prévue : elle ne dit pas si le plan est juste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को %@ पर दोहराएँ। पिछला सेशन %@ पर दर्ज हुआ था, जो तय लोड से कम है, इसलिए उससे यह पता नहीं चलता कि प्लान सही है या नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti %@ a %@. L'ultima sessione è stata registrata a %@, sotto il carico previsto, quindi non ci dice se il piano sia giusto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketini %@ ağırlıkla tekrarla. Geçen seans planlanan ağırlığın altında, %@ olarak kaydedildi; bu yüzden planın doğru olup olmadığını göstermiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 保持在 %@。上次记录的是 %@，低于计划负重，因此无法判断计划是否合适。"
          }
        }
      }
    },
    "progression.explain.maintain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Repeat %@ at %@ for %@ to %@ reps. One session short of the target is not a trend, so nothing changes yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Repite %@ con %@ a %@-%@ repeticiones. Una sesión por debajo del objetivo no es una tendencia, así que de momento no cambia nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Refais %@ à %@ pour %@ à %@ répétitions. Une séance en dessous de l’objectif n’est pas une tendance, donc rien ne change encore."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को %@ पर %@ से %@ रेप्स के लिए दोहराएँ। लक्ष्य से एक सेशन पीछे रहना कोई ट्रेंड नहीं, इसलिए अभी कुछ नहीं बदलता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ripeti %@ a %@ per %@-%@ ripetizioni. Una sola sessione sotto l'obiettivo non è una tendenza, quindi per ora non cambia nulla."
          }
        },
        "tr": {
