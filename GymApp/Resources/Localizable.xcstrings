        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketini set başına %@ ile %@ saniye arasında tut. Geçen sefer %@ saniye tuttun, yani hedefin içinde hâlâ yer var."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 保持在每组 %@ 到 %@ 秒。你上次坚持了 %@ 秒，目标区间内还有空间。"
