    "split.reason.activeRecovery": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Six hard days is the practical ceiling, so the %@th is light conditioning and core work."
          }
        }
      }
    },
    "split.reason.fourWay": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A four-way split across %@ days: enough sessions to separate the heavy work from the accessory work."
          }
        }
      }
    },
    "split.reason.fullBody": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Full-body sessions %@ times a week: with this many days, training every muscle each session gives each one the most frequency."
          }
        }
      }
    },
    "split.reason.posteriorEmphasis": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A posterior-chain-led split across %@ days: your back, glutes and hamstrings get the first, freshest session of the cycle."
          }
        }
      }
    },
    "split.reason.pplUpperLower": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push, pull and legs plus an upper/lower block across %@ days: it fits a second pass at every muscle into the week."
          }
        }
      }
    },
    "split.reason.pushPullLegs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Push, pull and legs across %@ days: grouping muscles that work together means less overlap between sessions and more recovery for each."
          }
        }
      }
    },
    "split.reason.specialisation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A %@-day split with a dedicated day for the muscles you want to prioritise."
          }
        }
      }
    },
    "split.reason.torsoArmsLegs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Torso, shoulders and arms, then legs across %@ days: it gives the smaller muscles their own session instead of tacking them onto a long one."
          }
        }
      }
    },
    "split.reason.upperLower": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An upper/lower split across %@ days: it hits every muscle twice a week while keeping each session a sensible length."
          }
        }
      }
    },
    "split.reason.upperLowerFull": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Upper, lower and a full-body day across %@ days: the extra full-body session tops up frequency without adding a fourth training day."
          }
        }
      }
    },
