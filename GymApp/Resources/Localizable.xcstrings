    "program.editor.sessionsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder. Swipe a session to rename, duplicate or delete it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Desliza una sesión para renombrarla, duplicarla o eliminarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour réorganiser. Balaie une séance pour la renommer, la dupliquer ou la supprimer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम बदलने के लिए खींचें। नाम बदलने, कॉपी बनाने या मिटाने के लिए सेशन पर स्वाइप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Scorri su una sessione per rinominarla, duplicarla o eliminarla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌어서 순서를 바꾸고, 옆으로 밀어 이름 바꾸기나 복제, 삭제를 할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, żeby zmienić kolejność. Przesuń sesję palcem, żeby zmienić jej nazwę, zduplikować ją lub usunąć."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıralamak için sürükle. Yeniden adlandırmak, kopyalamak veya silmek için seansı kaydır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可重新排序。左滑训练课可重命名、复制或删除。"
          }
        }
      }
    },
