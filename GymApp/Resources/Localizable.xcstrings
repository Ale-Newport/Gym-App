    "progress.nutrition.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Log a day or two of food and this screen shows how your intake tracks against your target."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un día o dos de comida y esta pantalla te mostrará cómo va tu consumo frente al objetivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre un ou deux jours d’alimentation et cet écran montrera comment tes apports se situent face à ton objectif."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक-दो दिन का खाना दर्ज करें और यह स्क्रीन दिखाएगी कि आपका सेवन लक्ष्य के मुकाबले कैसा चल रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Registra un giorno o due di cibo e questa schermata mostrerà come procede rispetto al tuo obiettivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir iki günlük beslenmeni kaydet; bu ekran alımının hedefine göre nasıl gittiğini göstersin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录一两天的饮食，这个页面就会显示你的摄入与目标的对比。"
          }
        }
      }
    },
