    "nutritionLibrary.food.servingsHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Name the portions you actually use, and logging this food later takes one tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Nombra las porciones que usas de verdad y registrar este alimento será cuestión de un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nomme les portions que tu utilises vraiment, et enregistrer cet aliment ne prendra qu’un geste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो हिस्से आप सचमुच लेते हैं उन्हें नाम दें, फिर इस फ़ूड को दर्ज करना एक टैप का काम रह जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dai un nome alle porzioni che usi davvero: registrare questo alimento diventerà questione di un tocco."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실제로 먹는 단위를 등록해 두면 다음부터 한 번만 눌러 기록할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nazwij porcje, których naprawdę używasz, a późniejsze zapisanie tego produktu zajmie jedno dotknięcie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerçekten kullandığın porsiyonlara ad ver; bu besini sonra kaydetmek tek dokunuş olsun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把你实际用的份量命名好，以后记录这种食物只要点一下。"
          }
        }
      }
    },
