    "program.split.customNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You built this week yourself, so there is no automatic split behind it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta semana la montaste tú, así que no hay ningún split automático detrás."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu as construit cette semaine toi-même : il n’y a donc pas de split automatique derrière."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह हफ़्ता आपने खुद बनाया है, इसलिए इसके पीछे कोई अपने आप चुना स्प्लिट नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa settimana l'hai costruita tu, quindi non c'è nessuno split automatico dietro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 한 주는 직접 만들어서 뒤에 깔린 자동 분할이 없어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten tydzień ułożyłeś sam, więc nie stoi za nim żaden automatyczny split."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu haftayı kendin kurdun, yani arkasında otomatik bir split yok."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这一周由你自己安排，因此背后没有自动分化。"
          }
        }
      }
    },
    "program.split.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No structure fits your current schedule. Add a training day and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguna estructura encaja con tu horario actual. Añade un día de entrenamiento y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune structure ne convient à ton emploi du temps actuel. Ajoute un jour d’entraînement et réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मौजूदा शेड्यूल में कोई ढाँचा फ़िट नहीं बैठता। एक ट्रेनिंग दिन जोड़कर फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna struttura si adatta ai tuoi impegni attuali. Aggiungi un giorno di allenamento e riprova."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지금 일정에 맞는 구성이 없어요. 운동하는 요일을 추가하고 다시 시도해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadna struktura nie pasuje do Twojego obecnego grafiku. Dodaj dzień treningowy i spróbuj ponownie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Şu anki takvimine uyan bir yapı yok. Bir antrenman günü ekleyip tekrar dene."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有结构适合你当前的日程。增加一个训练日后再试。"
          }
        }
      }
    },
    "program.split.emptyTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
