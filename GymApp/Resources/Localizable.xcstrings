    "settings.data.import.emptyBackup.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The file is valid but holds no workouts, programs or food entries, so restoring it would change nothing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El archivo es válido, pero no contiene entrenamientos, programas ni alimentos registrados, así que restaurarlo no cambiaría nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le fichier est valide mais ne contient aucune séance, aucun programme et aucune entrée alimentaire : le restaurer ne changerait rien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "फ़ाइल सही है, पर उसमें कोई वर्कआउट, प्रोग्राम या फ़ूड एंट्री नहीं है, इसलिए उसे वापस लाने से कुछ नहीं बदलेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il file è valido ma non contiene allenamenti, programmi o alimenti registrati, quindi ripristinarlo non cambierebbe nulla."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dosya geçerli ama içinde antrenman, program veya besin kaydı yok; yani geri yüklemek hiçbir şeyi değiştirmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "文件本身有效，但里面没有训练、训练计划或饮食记录，恢复它不会带来任何变化。"
          }
        }
      }
    },
