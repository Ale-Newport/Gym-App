            "state": "translated",
            "value": "새 운동 고르기는 이 세션에만 적용돼요. 잠근 것은 그대로 남아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dobór nowych ćwiczeń dotyczy tylko tej sesji. To, co zablokowałeś, zostaje na miejscu."
          }
        },
        "tr": {
          "stringUnit": {
