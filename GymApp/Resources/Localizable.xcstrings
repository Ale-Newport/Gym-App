    "progression.explain.addSet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep %@ at %@ and add a set, for %@ working sets. This plan adds volume before it adds load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %@ en %@ y añade una serie, hasta %@ series de trabajo. Este plan añade volumen antes que carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde %@ à %@ et ajoute une série, soit %@ séries de travail. Ce plan ajoute du volume avant d’ajouter de la charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को %@ पर रखें और एक सेट जोड़ें, कुल %@ वर्किंग सेट। यह प्लान लोड से पहले वॉल्यूम बढ़ाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni %@ a %@ e aggiungi una serie, per un totale di %@ serie di lavoro. Questo piano aggiunge volume prima del carico."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ağırlığını %@ değerinde tut ve bir set ekle; toplam %@ çalışma seti olsun. Bu plan, ağırlıktan önce hacim ekler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 保持在 %@，并增加一组，共 %@ 个正式组。这套方案先增加训练量，再增加负重。"
          }
        }
      }
    },
    "progression.explain.addSetDuration": {
      "extractionState": "manual",
      "localizations": {
