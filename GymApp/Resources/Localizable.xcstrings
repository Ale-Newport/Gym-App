    "program.templates.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Swipe a template to rename, duplicate or delete it. Templates sit outside your program, so rebuilding the program leaves them alone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desliza una plantilla para renombrarla, duplicarla o eliminarla. Las plantillas viven fuera de tu programa, así que reconstruirlo no las toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Balaie un modèle pour le renommer, le dupliquer ou le supprimer. Les modèles vivent en dehors de ton programme : le reconstruire ne les touche pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नाम बदलने, कॉपी बनाने या मिटाने के लिए टेम्पलेट पर स्वाइप करें। टेम्पलेट आपके प्रोग्राम से बाहर रहते हैं, इसलिए प्रोग्राम दोबारा बनने पर उन पर असर नहीं पड़ता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scorri su un modello per rinominarlo, duplicarlo o eliminarlo. I modelli stanno fuori dal tuo programma, quindi ricostruirlo non li tocca."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "옆으로 밀어 템플릿의 이름 바꾸기나 복제, 삭제를 할 수 있어요. 템플릿은 프로그램 밖에 있어서 프로그램을 다시 만들어도 그대로예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przesuń szablon palcem, żeby zmienić nazwę, zduplikować go lub usunąć. Szablony są poza programem, więc przebudowa programu ich nie rusza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeniden adlandırmak, kopyalamak veya silmek için şablonu kaydır. Şablonlar programının dışındadır, yani programı yeniden kurmak onlara dokunmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "左滑模板可重命名、复制或删除。模板独立于训练计划之外，因此重新生成计划不会影响它们。"
          }
        }
      }
    },
