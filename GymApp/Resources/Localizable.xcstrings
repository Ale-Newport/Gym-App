    "onboarding.welcome.explain.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every suggestion comes with the thinking behind it, so you can overrule it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada sugerencia viene con el razonamiento detrás, para que puedas llevarle la contraria."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque suggestion vient avec le raisonnement derrière, pour que tu puisses la contredire."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सुझाव के साथ उसके पीछे की सोच रहती है, ताकि आप उसे बदल भी सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni proposta arriva con il ragionamento che c'è dietro, così puoi anche non seguirla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 제안에 그렇게 판단한 이유가 함께 있어서, 언제든 다르게 정할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda propozycja przychodzi z uzasadnieniem, więc możesz ją odrzucić."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her öneri, arkasındaki mantıkla birlikte gelir; istersen onu geçersiz kılabilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一条建议都会说明依据，你随时可以推翻它。"
          }
        }
      }
    },
    "onboarding.welcome.explain.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reasons, not just numbers"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Motivos, no solo números"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des raisons, pas seulement des chiffres"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ आँकड़े नहीं, वजह भी"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Motivi, non solo numeri"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "숫자만이 아니라 이유까지"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powody, nie same liczby"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca rakam değil, gerekçe"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不只有数字，还有理由"
          }
        }
      }
    },
    "onboarding.welcome.privacy.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No account, no sign-in, nothing sent anywhere."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin cuenta, sin registro, sin enviar nada a ninguna parte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas de compte, pas de connexion, rien n’est envoyé nulle part."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न कोई अकाउंट, न साइन-इन, न कुछ कहीं भेजा जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun account, nessun accesso, niente inviato da nessuna parte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계정도 로그인도 없고, 아무것도 밖으로 보내지 않아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez konta, bez logowania, nic nigdzie nie wędruje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap yok, giriş yok, hiçbir yere hiçbir şey gönderilmiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无需账号，无需登录，不上传任何内容。"
          }
        }
      }
    },
    "onboarding.welcome.privacy.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your data stays on your phone"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus datos se quedan en tu móvil"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes données restent sur ton téléphone"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका डेटा आपके फ़ोन पर ही रहता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi dati restano sul tuo telefono"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "데이터는 내 폰에만"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje dane zostają w telefonie"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilerin telefonunda kalır"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "数据只留在你的手机上"
          }
        }
      }
    },
    "onboarding.welcome.program.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Built from the days you have, the time you have and the equipment you can reach."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho con los días que tienes, el tiempo que tienes y el material al que llegas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construit à partir des jours dont tu disposes, du temps que tu as et du matériel à ta portée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास जो दिन हैं, जो समय है और जो इक्विपमेंट पहुँच में है, उसी से बना।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruito sui giorni che hai, sul tempo che hai e sull'attrezzatura a cui arrivi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가능한 요일과 시간, 쓸 수 있는 장비로 만들어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbudowany z dni, które masz, czasu, którym dysponujesz, i sprzętu, do którego sięgasz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayırabildiğin günlere, vaktine ve ulaşabildiğin ekipmana göre kurulur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "依据你有的日子、时间和能用到的器械生成。"
          }
        }
      }
    },
    "onboarding.welcome.program.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A program that fits your week"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programa que encaja en tu semana"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programme qui tient dans ta semaine"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके हफ़्ते में फ़िट बैठने वाला प्रोग्राम"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un programma che sta nella tua settimana"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "내 한 주에 맞는 프로그램"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Program dopasowany do Twojego tygodnia"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftana uyan bir program"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "贴合你一周的训练计划"
          }
        }
      }
    },
    "onboarding.welcome.progress.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every set is logged, and your loads move as your numbers do."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada serie queda registrada, y tus cargas se mueven igual que tus números."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque série est enregistrée, et tes charges évoluent avec tes chiffres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सेट दर्ज होता है, और आपके आँकड़ों के साथ आपके लोड भी बढ़ते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni serie viene registrata e i tuoi carichi salgono insieme ai tuoi numeri."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 세트를 기록하고, 숫자가 오르면 중량도 함께 올라가요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda seria jest zapisana, a ciężary rosną razem z Twoimi liczbami."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her set kaydedilir ve rakamların yükseldikçe ağırlıkların da yükselir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每一组都被记录，负重随你的数据一起提升。"
          }
        }
      }
    },
    "onboarding.welcome.progress.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Progress you can see"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un progreso que se ve"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Des progrès visibles"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दिखने वाली प्रगति"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Progressi che si vedono"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "눈에 보이는 성장"
          }
        },
        "pl": {
