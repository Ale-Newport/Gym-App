    "reset.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This deletes your profile, programs, training history and nutrition log from this device. Export a backup first if you want to keep any of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto borra de este dispositivo tu perfil, tus programas, tu historial de entrenamiento y tu registro de nutrición. Exporta una copia antes si quieres conservar algo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela supprime ton profil, tes programmes, ton historique d’entraînement et ton journal alimentaire de cet appareil. Exporte d’abord une sauvegarde si tu veux en garder quelque chose."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे आपकी प्रोफ़ाइल, प्रोग्राम, ट्रेनिंग हिस्ट्री और फ़ूड लॉग इस डिवाइस से मिट जाएँगे। कुछ भी रखना हो तो पहले बैकअप एक्सपोर्ट कर लें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo elimina da questo dispositivo il tuo profilo, i programmi, la cronologia degli allenamenti e il diario alimentare. Esporta prima un backup se vuoi conservarne una parte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 프로필, 프로그램, 운동 기록, 식단 기록을 지워요. 남기고 싶은 게 있다면 먼저 백업을 내보내세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To usuwa z tego urządzenia Twój profil, programy, historię treningów i dziennik jedzenia. Jeśli chcesz cokolwiek zachować, najpierw wyeksportuj kopię."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu işlem profilini, programlarını, antrenman geçmişini ve besin günlüğünü bu cihazdan siler. Bir kısmını saklamak istiyorsan önce yedek al."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这会从本机删除你的个人资料、训练计划、训练历史和饮食记录。想保留的话，请先导出一份备份。"
          }
        }
      }
    },
