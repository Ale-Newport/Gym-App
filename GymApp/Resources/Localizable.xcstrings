        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रोटीन जहाँ है वहीं रहेगा। बदलाव कार्ब्स और फैट में होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le proteine restano dove sono. La modifica va su carboidrati e grassi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "단백질은 그대로 두고, 바뀐 양은 탄수화물과 지방에서 조정해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Białko zostaje bez zmian. Zmiana idzie na węglowodany i tłuszcz."
