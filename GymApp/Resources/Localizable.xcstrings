    "onboarding.experience.seeds.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. A weight and a rep count for any lift you know sets a sensible starting load."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Un peso y unas repeticiones de cualquier ejercicio que conozcas fijan una carga inicial sensata."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Une charge et un nombre de répétitions sur un mouvement que tu connais donnent une charge de départ cohérente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। किसी भी परिचित लिफ़्ट का वज़न और रेप्स बताने से समझदारी भरा शुरुआती लोड तय हो जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Un peso e un numero di ripetizioni per gli esercizi che conosci danno un carico di partenza sensato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 아는 종목의 무게와 횟수를 적으면 알맞은 시작 중량이 잡혀요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Ciężar i liczba powtórzeń dla znanego Ci boju ustawiają sensowny ciężar startowy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Bildiğin herhangi bir hareket için bir ağırlık ve tekrar sayısı, makul bir başlangıç ağırlığı belirler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。填上你知道的动作重量和次数，就能得到合理的起始负重。"
          }
        }
      }
    },
    "onboarding.experience.seeds.loading": {
      "extractionState": "manual",
      "localizations": {
