    "progression.doubleProgression.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add reps to the top of the range, then add weight"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sube repeticiones hasta el tope del rango y luego añade peso"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Monte les répétitions jusqu’en haut de la fourchette, puis ajoute du poids"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले रेंज के ऊपरी छोर तक रेप्स बढ़ाएँ, फिर वज़न"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi ripetizioni fino al massimo del range, poi peso"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce aralığın üstüne kadar tekrar ekle, sonra ağırlık"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先把次数加到区间上限，再加重量"
          }
        }
      }
    },
    "progression.explain.addReps": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep %@ at %@ and work towards %@ reps on every set. Your lowest set was %@ reps last time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén %@ en %@ y ve hacia %@ repeticiones en todas las series. Tu serie más baja fue de %@ repeticiones la última vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde %@ à %@ et vise %@ répétitions sur chaque série. Ta série la plus faible était à %@ répétitions la dernière fois."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ को %@ पर रखें और हर सेट में %@ रेप्स की ओर बढ़ें। पिछली बार आपका सबसे कम सेट %@ रेप्स का था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni %@ a %@ e punta a %@ ripetizioni in ogni serie. L'ultima volta la tua serie più bassa è stata di %@ ripetizioni."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ağırlığını %@ değerinde tut ve her sette %@ tekrara ulaşmaya çalış. Geçen sefer en düşük setin %@ tekrardı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 保持在 %@，争取每组做到 %@ 次。你上次最低的一组是 %@ 次。"
          }
        }
      }
    },
