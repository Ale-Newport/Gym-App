    "progress.adherence.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you have finished a session or logged a day of food, this screen shows how it is going."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En cuanto termines una sesión o registres un día de comida, esta pantalla te dirá cómo va la cosa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que tu auras terminé une séance ou enregistré une journée d’alimentation, cet écran montrera où tu en es."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक सेशन पूरा करने या एक दिन का खाना दर्ज करने के बाद यह स्क्रीन दिखाएगी कि सब कैसा चल रहा है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando avrai completato una sessione o registrato una giornata di cibo, questa schermata ti mostrerà come sta andando."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir seansı bitirdiğinde ya da bir günlük beslenmeni kaydettiğinde, bu ekran nasıl gittiğini gösterir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成一节训练课或记录一天的饮食后，这个页面会显示进展情况。"
          }
        }
      }
    },
    "progress.adherence.empty.title": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
