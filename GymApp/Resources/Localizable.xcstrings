    "workoutHub.reschedule.spacing": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ moves to %@ rather than %@, so %@ gets another day to recover."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ pasa al %@ en lugar del %@, para que %@ tenga un día más de recuperación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ passe à %@ plutôt qu’à %@, ce qui laisse à %@ un jour de plus pour récupérer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ %@ पर जाता है, %@ पर नहीं, ताकि %@ को रिकवरी का एक और दिन मिल जाए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ si sposta a %@ invece che a %@, così %@ ha un giorno in più per recuperare."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 移到 %@ 而不是 %@，这样 %@ 能多恢复一天。"
          }
        }
      }
    },
    "workoutHub.reschedule.summary": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing is dropped. The sessions you still owe are re-seated into the days you have left, keeping a day clear between anything that trains the same muscles."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se cae nada. Las sesiones que aún debes se recolocan en los días que te quedan, dejando un día libre entre las que trabajan los mismos músculos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est abandonné. Les séances qu’il te reste sont replacées dans les jours disponibles, en gardant un jour libre entre celles qui travaillent les mêmes muscles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ भी छोड़ा नहीं जाता। जो सेशन बाकी हैं, वे आपके बचे दिनों में फिर से जमा दिए जाते हैं, और एक ही मसल पर काम करने वाले सेशनों के बीच एक दिन खाली रखा जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non si perde nulla. Le sessioni che ti restano vengono ricollocate nei giorni che hai ancora, tenendo un giorno libero tra tutto ciò che allena gli stessi muscoli."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不会丢掉任何内容。你还欠下的训练课会被重新排进剩余的日子里，并在训练相同肌肉的安排之间留出一天。"
          }
        }
      }
    },
    "workoutHub.reschedule.summaryNoChange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your week already works. Every remaining session is on the best day available."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu semana ya funciona. Cada sesión que queda está en el mejor día disponible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta semaine fonctionne déjà. Chaque séance restante est au meilleur jour disponible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका हफ़्ता पहले से ठीक है। बचा हर सेशन उपलब्ध सबसे अच्छे दिन पर है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua settimana funziona già così. Ogni sessione rimasta è nel miglior giorno disponibile."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的一周已经很合理，剩下的每节训练课都在最合适的日子上。"
          }
        }
      }
    },
