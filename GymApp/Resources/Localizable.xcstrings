    "program.session.excludeNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluding an exercise keeps it out of future suggestions everywhere. It stays in this session until you remove it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Excluir un ejercicio lo deja fuera de las sugerencias en toda la app. Se queda en esta sesión hasta que lo quites."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Exclure un exercice le retire des suggestions futures partout. Il reste dans cette séance tant que tu ne l’enlèves pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक्सरसाइज़ बाहर रखने पर वह आगे कहीं भी नहीं सुझाई जाएगी। जब तक आप हटा न दें, वह इस सेशन में बनी रहेगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Escludere un esercizio lo tiene fuori dalle proposte future ovunque. Resta in questa sessione finché non lo rimuovi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제외하면 앞으로 어디에서도 추천되지 않아요. 직접 제거하기 전까지 이 세션에는 남아 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykluczenie trzyma to ćwiczenie z dala od przyszłych propozycji w całej aplikacji. W tej sesji zostaje, dopóki go nie usuniesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir egzersizi hariç tutmak, onu her yerde gelecekteki önerilerin dışında bırakır. Sen çıkarana kadar bu seansta kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "排除一个动作后，它在任何地方都不会再被推荐。在你移除它之前，它仍留在这节训练课中。"
          }
        }
      }
    },
    "program.session.exercisesFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag to reorder. Swipe an exercise to swap or remove it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para reordenar. Desliza un ejercicio para cambiarlo o quitarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fais glisser pour réorganiser. Balaie un exercice pour le remplacer ou le retirer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्रम बदलने के लिए खींचें। बदलने या हटाने के लिए एक्सरसाइज़ पर स्वाइप करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per riordinare. Scorri su un esercizio per sostituirlo o rimuoverlo."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "끌어서 순서를 바꾸고, 옆으로 밀어 교체하거나 제거할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, żeby zmienić kolejność. Przesuń ćwiczenie palcem, żeby je zamienić lub usunąć."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sıralamak için sürükle. Değiştirmek veya çıkarmak için egzersizi kaydır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动可重新排序。左滑动作可替换或移除。"
          }
        }
      }
    },
