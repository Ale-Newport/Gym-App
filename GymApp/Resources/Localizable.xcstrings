    "home.recovery.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An estimate from the training you logged, not a medical measurement."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una estimación a partir del entrenamiento que has registrado, no una medición médica."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une estimation basée sur l’entraînement que tu as enregistré, pas une mesure médicale."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपकी दर्ज की गई ट्रेनिंग से लगाया अनुमान है, कोई मेडिकल माप नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stima dagli allenamenti che hai registrato, non una misurazione medica."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록한 운동에서 계산한 추정치이고, 의학적 측정이 아니에요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacunek na podstawie zapisanych treningów, a nie pomiar medyczny."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğin antrenmanlardan çıkarılan bir tahmindir, tıbbi bir ölçüm değildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是根据你记录的训练做出的估算，不是医学测量。"
          }
        }
      }
    },
