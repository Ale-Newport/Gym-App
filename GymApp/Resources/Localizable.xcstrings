    "settings.goals.priorityNone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing prioritised. Weekly volume is spread evenly across muscle groups."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay nada priorizado. El volumen semanal se reparte por igual entre los grupos musculares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien n’est prioritaire. Le volume hebdomadaire est réparti équitablement entre les groupes musculaires."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई प्राथमिकता नहीं। साप्ताहिक वॉल्यूम सभी मसल ग्रुप में बराबर बँटता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Niente in priorità. Il volume settimanale è distribuito in modo uniforme tra i gruppi muscolari."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öncelik verilen yok. Haftalık hacim kas gruplarına eşit dağıtılır."
