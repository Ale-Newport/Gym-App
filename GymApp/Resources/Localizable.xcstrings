    "loadEstimate.explain.fromBodyWeight": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting %@ at %@ for %@ reps. That is a deliberately light first guess from your body weight of %@, so rate the first set and we will correct it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ empieza con %@ para %@ repeticiones. Es una primera estimación deliberadamente ligera a partir de tu peso corporal de %@, así que valora la primera serie y la corregiremos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ démarre à %@ pour %@ répétitions. C’est une première estimation volontairement légère à partir de ton poids de %@ : évalue la première série et on corrigera."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की शुरुआत %@ पर %@ रेप्स के लिए। यह आपके %@ शरीर के वज़न से लगाया जानबूझकर हल्का पहला अंदाज़ा है, इसलिए पहला सेट रेट करें और हम इसे ठीक कर देंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parte da %@ per %@ ripetizioni. È volutamente una prima stima leggera basata sul tuo peso corporeo di %@, quindi valuta la prima serie e la correggeremo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketine %@ tekrar için %@ ağırlıkla başlıyorsun. Bu, %@ olan vücut ağırlığından çıkarılmış bilerek hafif bir ilk tahmin; ilk setini değerlendir, düzeltelim."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 从 %@ 开始，做 %@ 次。这是根据你 %@ 的体重刻意保守的初次估计，请评价第一组，我们会据此修正。"
          }
        }
      }
    },
    "loadEstimate.explain.fromOwnHistory": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Starting %@ at %@ for %@ reps, based on your own best set here (estimated one-rep max %@)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ empieza con %@ para %@ repeticiones, según tu mejor serie aquí (1RM estimado de %@)."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ démarre à %@ pour %@ répétitions, d’après ta meilleure série sur cet exercice (1RM estimé %@)."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ की शुरुआत %@ पर %@ रेप्स के लिए, यहाँ आपके अपने सबसे अच्छे सेट के आधार पर (अनुमानित वन-रेप मैक्स %@)।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ parte da %@ per %@ ripetizioni, in base alla tua serie migliore qui (1RM stimato %@)."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ hareketine %@ tekrar için %@ ağırlıkla başlıyorsun; buradaki kendi en iyi setine dayanıyor (tahmini tek tekrar maksimumu %@)."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 从 %@ 开始，做 %@ 次，依据是你在这个动作上的最佳组（预估 1RM %@）。"
          }
        }
      }
    },
    "loadEstimate.explain.fromRelated": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
