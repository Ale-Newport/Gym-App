    "nutritionLibrary.recipes.emptyEditorMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add what goes in, and Forge works out the nutrition per serving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade lo que lleva y Forge calcula la nutrición por ración."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute ce qui entre dedans, et Forge calcule les valeurs par portion."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें जो जाता है वह जोड़ें, और Forge हर सर्विंग का न्यूट्रिशन निकाल देगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi cosa ci va dentro e Forge calcola i valori nutrizionali per porzione."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "들어가는 재료를 추가하면 Forge가 1회분 영양 정보를 계산해 줘요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj to, co wchodzi w skład, a Forge policzy wartości odżywcze na porcję."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçine ne giriyorsa ekle; Forge porsiyon başına besin değerlerini hesaplasın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把用到的材料加进来，Forge 会算出每份的营养。"
          }
