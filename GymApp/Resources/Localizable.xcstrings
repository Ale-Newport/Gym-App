    "nutritionLibrary.targets.noTargetMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge can estimate one from your height, weight, age, activity and goal. You can change any of it afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge puede estimarlo a partir de tu altura, tu peso, tu edad, tu actividad y tu objetivo. Después puedes cambiar lo que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge peut en estimer un à partir de ta taille, ton poids, ton âge, ton activité et ton objectif. Tu peux tout modifier ensuite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge आपकी लंबाई, वज़न, उम्र, गतिविधि और लक्ष्य से एक अनुमान लगा सकता है। बाद में आप इसमें कुछ भी बदल सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge può stimarne uno da altezza, peso, età, attività e obiettivo. Puoi cambiare tutto in seguito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge가 키와 체중, 나이, 활동량, 목표로 추정해 드릴 수 있어요. 나중에 무엇이든 바꿀 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge oszacuje go z Twojego wzrostu, wagi, wieku, aktywności i celu. Wszystko możesz potem zmienić."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge; boyundan, kilondan, yaşından, aktivitenden ve hedefinden bir tahmin çıkarabilir. Sonradan hepsini değiştirebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge 可以根据你的身高、体重、年龄、活动量和目标估算一个。之后任何一项都能改。"
          }
        }
      }
    },
