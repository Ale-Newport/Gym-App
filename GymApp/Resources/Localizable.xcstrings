    "program.session.rirNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "How many reps you should have left when you stop a set. Higher means further from failure."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuántas repeticiones deberías tener de margen al terminar una serie. Cuanto más alto, más lejos del fallo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Combien de répétitions il devrait te rester quand tu arrêtes une série. Plus le chiffre est haut, plus tu es loin de l’échec."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेट रोकते समय आपके पास कितने रेप्स बचे रहने चाहिए। ज़्यादा का मतलब फेल्योर से ज़्यादा दूर।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quante ripetizioni dovresti avere ancora in canna quando chiudi una serie. Più alto significa più lontano dal cedimento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "세트를 멈출 때 몇 회를 더 할 수 있어야 하는지예요. 값이 클수록 실패 지점에서 멀어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ile powtórzeń powinno Ci zostać, gdy kończysz serię. Więcej znaczy dalej od upadku mięśniowego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seti bıraktığında kaç tekrarın daha kalmış olması gerektiği. Yüksek değer, tükenmeye daha uzak demektir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结束一组时你还应剩下多少次。数值越高，离力竭越远。"
          }
        }
      }
    },
