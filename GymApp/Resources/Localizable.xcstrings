    "nutritionLog.custom.energyNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Leave energy blank and it is worked out from the protein, carbs and fat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deja la energía en blanco y se calculará a partir de la proteína, los hidratos y la grasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Laisse l’énergie vide et elle sera calculée à partir des protéines, glucides et lipides."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एनर्जी खाली छोड़ दें तो वह प्रोटीन, कार्ब्स और फैट से निकाल ली जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Lascia vuota l'energia e verrà calcolata da proteine, carboidrati e grassi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열량을 비워 두면 단백질과 탄수화물, 지방으로 계산해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostaw pole energii puste, a policzymy ją z białka, węglowodanów i tłuszczu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enerjiyi boş bırakırsan protein, karbonhidrat ve yağdan hesaplanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热量留空的话，会根据蛋白质、碳水和脂肪算出来。"
          }
        }
      }
    },
