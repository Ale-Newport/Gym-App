    "nutrition.energy.bmr": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body is estimated to burn about %@ kcal a day at rest, from your height, weight and age."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se estima que tu cuerpo quema unas %@ kcal al día en reposo, según tu altura, tu peso y tu edad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton corps brûlerait environ %@ kcal par jour au repos, d’après ta taille, ton poids et ton âge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी लंबाई, वज़न और उम्र के हिसाब से अनुमान है कि आराम की हालत में आपका शरीर रोज़ करीब %@ kcal खर्च करता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si stima che a riposo il tuo corpo bruci circa %@ kcal al giorno, in base ad altezza, peso ed età."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키와 체중, 나이로 볼 때 쉴 때 하루 약 %@ kcal을 쓰는 것으로 추정돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Szacujemy, że w spoczynku Twój organizm spala około %@ kcal dziennie — na podstawie wzrostu, wagi i wieku."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Boyuna, kilona ve yaşına göre vücudunun dinlenirken günde yaklaşık %@ kcal yaktığı tahmin ediliyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "根据你的身高、体重和年龄，你的身体在静息状态下每天大约消耗 %@ kcal。"
          }
        }
      }
    },
    "nutrition.energy.bmrDefaultAge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No date of birth on file, so the estimate assumes %@ years old. Add yours to make it more accurate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay fecha de nacimiento guardada, así que la estimación asume %@ años. Añade la tuya para afinarla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune date de naissance enregistrée, l’estimation part donc de %@ ans. Ajoute la tienne pour plus de précision."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जन्मतिथि दर्ज नहीं है, इसलिए अनुमान %@ साल की उम्र मानकर लगाया गया है। अपनी उम्र जोड़ें तो यह और सटीक हो जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è una data di nascita salvata, quindi la stima presume %@ anni. Aggiungi la tua per renderla più precisa."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생년월일이 없어서 %@세로 가정하고 계산했어요. 입력하면 더 정확해져요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak daty urodzenia, więc szacunek zakłada wiek %@ lat. Podaj swoją, a będzie dokładniejszy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı bir doğum tarihi yok, bu yüzden tahmin %@ yaşını varsayıyor. Kendi yaşını eklersen daha isabetli olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料里没有出生日期，所以估算按 %@ 岁计算。填上你的年龄会更准确。"
          }
        }
      }
    },
    "nutrition.energy.bmrUnspecifiedSex": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a biological sex on file the estimate averages the two standard formulas, so it is less precise than it could be."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin un sexo biológico guardado, la estimación promedia las dos fórmulas habituales, así que es menos precisa de lo que podría ser."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans sexe biologique enregistré, l’estimation fait la moyenne des deux formules de référence : elle est donc moins précise qu’elle pourrait l’être."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जैविक लिंग दर्ज न होने पर अनुमान दोनों मानक फ़ॉर्मूलों का औसत लेता है, इसलिए यह उतना सटीक नहीं है जितना हो सकता था।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza un sesso biologico salvato la stima fa la media delle due formule standard, quindi è meno precisa di quanto potrebbe essere."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생물학적 성별이 없어서 표준 공식 두 가지의 평균을 썼고, 그만큼 정밀도가 낮아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez podanej płci biologicznej szacunek uśrednia dwa standardowe wzory, więc jest mniej precyzyjny, niż mógłby być."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı bir biyolojik cinsiyet olmadığı için tahmin, iki standart formülün ortalamasını alıyor; yani olabileceği kadar hassas değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "资料里没有生理性别，估算取两套标准公式的平均值，因此精度会低一些。"
          }
        }
      }
    },
    "nutrition.energy.deficit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Losing about %@ kg a week means eating around %@ kcal a day, roughly %@ kcal below maintenance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Perder unos %@ kg por semana supone comer alrededor de %@ kcal al día, unas %@ kcal por debajo del mantenimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdre environ %@ kg par semaine revient à manger autour de %@ kcal par jour, soit à peu près %@ kcal sous ton maintien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर हफ़्ते करीब %@ kg घटाने के लिए रोज़ लगभग %@ kcal खाना होगा, जो मेंटेनेंस से करीब %@ kcal कम है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Perdere circa %@ kg a settimana significa mangiare intorno a %@ kcal al giorno, più o meno %@ kcal sotto il mantenimento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주당 약 %@ kg을 빼려면 하루 약 %@ kcal을 먹으면 돼요. 유지 칼로리보다 약 %@ kcal 적은 양이에요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utrata około %@ kg tygodniowo oznacza jedzenie około %@ kcal dziennie, czyli mniej więcej %@ kcal poniżej podtrzymania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada yaklaşık %@ kg vermek, günde yaklaşık %@ kcal yemek demek; bu da idamenin kabaca %@ kcal altı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每周减重约 %@ kg，意味着每天摄入约 %@ kcal，比维持热量低约 %@ kcal。"
          }
        }
      }
    },
    "nutrition.energy.deficitCapped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deficit was capped at %@ kcal a day. Faster than that costs muscle and rarely lasts."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El déficit se ha limitado a %@ kcal al día. Ir más rápido cuesta músculo y rara vez se sostiene."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le déficit a été plafonné à %@ kcal par jour. Plus vite, cela coûte du muscle et tient rarement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डेफ़िसिट को रोज़ %@ kcal पर सीमित रखा गया है। इससे तेज़ घटाने पर मसल जाती है और वह टिकता भी नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il deficit è stato limitato a %@ kcal al giorno. Andare più veloce costa muscolo e raramente dura."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "적자는 하루 %@ kcal로 제한했어요. 그보다 빠르면 근육이 줄고 오래 유지하기도 어려워요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deficyt ograniczono do %@ kcal dziennie. Szybsze tempo kosztuje mięśnie i rzadko się utrzymuje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık günde %@ kcal ile sınırlandı. Bundan hızlısı kasa mal olur ve nadiren kalıcı olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热量缺口被限制在每天 %@ kcal。比这更快会损失肌肉，也很难坚持。"
          }
        }
      }
    },
    "nutrition.energy.estimateDisclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These figures are estimates to start from, not medical advice. The app will adjust them as your own results come in."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas cifras son estimaciones para empezar, no consejo médico. La app las irá ajustando según tus propios resultados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ces chiffres sont des estimations pour démarrer, pas un avis médical. L’app les ajustera au fur et à mesure de tes résultats."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये आँकड़े शुरुआत के लिए अनुमान हैं, कोई मेडिकल सलाह नहीं। आपके अपने नतीजे आते ही ऐप इन्हें ठीक करता रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questi numeri sono stime da cui partire, non consigli medici. L'app li adatterà man mano che arrivano i tuoi risultati."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 수치는 출발점이 되는 추정치이고 의학적 조언이 아니에요. 실제 결과가 쌓이면 앱이 조정해 드려요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To szacunki na start, a nie porada medyczna. Aplikacja skoryguje je, gdy pojawią się Twoje własne wyniki."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu rakamlar başlangıç için birer tahmindir, tıbbi tavsiye değildir. Kendi sonuçların geldikçe uygulama bunları ayarlar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些数字只是一个起点估算，不是医疗建议。随着你自己的结果出现，App 会不断调整。"
          }
        }
      }
    },
    "nutrition.energy.floorAboveMaintenance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lowest daily intake this app will recommend for you is %@ kcal, which is already above your estimated maintenance of %@ kcal. Eating less than this is not something the app will suggest, so moving more is the better lever from here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La ingesta diaria más baja que esta app te recomendará es de %@ kcal, que ya está por encima de tu mantenimiento estimado de %@ kcal. La app no va a sugerirte comer menos que eso, así que a partir de aquí moverte más es la mejor palanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’apport quotidien le plus bas que cette app te recommandera est de %@ kcal, ce qui dépasse déjà ton maintien estimé de %@ kcal. Manger moins n’est pas quelque chose que l’app suggérera : bouger plus est le meilleur levier à partir d’ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह ऐप आपके लिए सबसे कम जो दैनिक सेवन सुझाएगा वह %@ kcal है, जो आपके अनुमानित मेंटेनेंस %@ kcal से पहले ही ज़्यादा है। इससे कम खाने का सुझाव ऐप नहीं देगा, इसलिए यहाँ से ज़्यादा चलना-फिरना बेहतर रास्ता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'apporto giornaliero più basso che quest'app ti consiglia è %@ kcal, già sopra il tuo mantenimento stimato di %@ kcal. Mangiare meno non è qualcosa che l'app suggerirà, quindi da qui la leva migliore è muoverti di più."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "앱이 권장하는 하루 최소 섭취량은 %@ kcal인데, 추정 유지 칼로리 %@ kcal보다 이미 높아요. 이보다 적게 먹으라고 권하지는 않으니, 여기서부터는 활동량을 늘리는 쪽이 더 나아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najniższe dzienne spożycie, jakie ta aplikacja Ci poleci, to %@ kcal — a to już więcej niż Twój szacowany poziom podtrzymania, czyli %@ kcal. Aplikacja nie zaproponuje jedzenia mniej, więc lepszą dźwignią jest teraz większy ruch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu uygulamanın senin için önereceği en düşük günlük alım %@ kcal ve bu zaten tahmini idamen olan %@ kcal'in üzerinde. Bundan daha az yemeyi uygulama önermez; buradan sonrası için daha çok hareket etmek daha iyi bir yol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本 App 为你建议的最低每日摄入是 %@ kcal，而这已经高于你的预估维持热量 %@ kcal。App 不会建议你吃得更少，所以从这里开始，多活动才是更好的方向。"
          }
        }
      }
    },
    "nutrition.energy.floorApplied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calculated target was below the level this app is willing to recommend, so it was raised to %@ kcal a day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El objetivo calculado quedaba por debajo del nivel que esta app está dispuesta a recomendar, así que se ha subido a %@ kcal al día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’objectif calculé était sous le seuil que cette app accepte de recommander, il a donc été remonté à %@ kcal par jour."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गणना से निकला लक्ष्य उस स्तर से नीचे था जिसकी यह ऐप सलाह देता है, इसलिए उसे बढ़ाकर रोज़ %@ kcal कर दिया गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'obiettivo calcolato era sotto il livello che quest'app è disposta a consigliare, quindi è stato alzato a %@ kcal al giorno."
          }
        },
        "ko": {
          "stringUnit": {
