    "active.substitute.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No exercise fits that reason with the equipment you have. Clear the reason to widen the search."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ningún ejercicio encaja con ese motivo y el material que tienes. Quita el motivo para ampliar la búsqueda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun exercice ne correspond à cette raison avec le matériel dont tu disposes. Efface la raison pour élargir la recherche."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके इक्विपमेंट के साथ उस वजह पर कोई एक्सरसाइज़ फ़िट नहीं बैठती। खोज बढ़ाने के लिए वजह हटा दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun esercizio corrisponde a quel motivo con l'attrezzatura che hai. Togli il motivo per allargare la ricerca."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以你现有的器械，没有动作符合这个理由。清除理由可以扩大搜索范围。"
          }
        }
      }
    },
