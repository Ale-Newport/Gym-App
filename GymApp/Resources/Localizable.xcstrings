    "onboarding.basics.target.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. It sets the direction of your energy target, nothing else."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Marca la dirección de tu objetivo de energía, nada más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Il donne la direction de ton objectif énergétique, rien de plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। इससे सिर्फ़ आपके एनर्जी लक्ष्य की दिशा तय होती है, और कुछ नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Definisce la direzione del tuo obiettivo energetico, nient'altro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 열량 목표의 방향만 정해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Wyznacza tylko kierunek Twojego celu energetycznego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Yalnızca enerji hedefinin yönünü belirler, başka bir şeyi değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。它只决定热量目标的方向，不影响其他内容。"
          }
        }
      }
    },
    "onboarding.basics.target.gain": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to gain. Your energy target will sit above maintenance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ que ganar. Tu objetivo de energía quedará por encima del mantenimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ à prendre. Ton objectif énergétique se situera au-dessus du maintien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ बढ़ाना है। आपका एनर्जी लक्ष्य मेंटेनेंस से ऊपर रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ da guadagnare. Il tuo obiettivo energetico starà sopra il mantenimento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 증량이 목표예요. 열량 목표는 유지 칼로리보다 높게 잡혀요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ do zyskania. Twój cel energetyczny znajdzie się powyżej podtrzymania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alınacak %@. Enerji hedefin idamenin üstünde olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要增加 %@。你的热量目标会高于维持水平。"
          }
        }
      }
    },
    "onboarding.basics.target.lose": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ to lose. Your energy target will sit below maintenance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ que perder. Tu objetivo de energía quedará por debajo del mantenimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ à perdre. Ton objectif énergétique se situera sous le maintien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ घटाना है। आपका एनर्जी लक्ष्य मेंटेनेंस से नीचे रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ da perdere. Il tuo obiettivo energetico starà sotto il mantenimento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 감량이 목표예요. 열량 목표는 유지 칼로리보다 낮게 잡혀요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ do zrzucenia. Twój cel energetyczny znajdzie się poniżej podtrzymania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Verilecek %@. Enerji hedefin idamenin altında olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要减掉 %@。你的热量目标会低于维持水平。"
          }
        }
      }
    },
    "onboarding.basics.target.same": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "That matches your current weight, so your target will sit at maintenance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Coincide con tu peso actual, así que tu objetivo se situará en el mantenimiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela correspond à ton poids actuel, ton objectif se situera donc au maintien."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके मौजूदा वज़न जैसा ही है, इसलिए आपका लक्ष्य मेंटेनेंस पर रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Coincide con il tuo peso attuale, quindi il tuo obiettivo sarà al mantenimento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 체중과 같아서 목표는 유지 칼로리에 맞춰져요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To Twoja obecna waga, więc cel będzie na poziomie podtrzymania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, şu anki kilonla aynı; yani hedefin idame düzeyinde olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这和你当前体重一致，因此目标会设在维持水平。"
          }
        }
      }
    },
