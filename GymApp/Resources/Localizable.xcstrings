    "onboarding.nutrition.excluded.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "One word works best. These match ingredient tags rather than dish names."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Con una sola palabra funciona mejor. Esto coincide con etiquetas de ingredientes, no con nombres de platos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul mot fonctionne le mieux. Cela correspond aux étiquettes d’ingrédients plutôt qu’aux noms de plats."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक शब्द सबसे अच्छा काम करता है। ये व्यंजन के नाम नहीं, सामग्री के टैग से मिलाए जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una parola sola funziona meglio. Corrispondono ai tag degli ingredienti, non ai nomi dei piatti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "한 단어가 가장 잘 맞아요. 요리 이름이 아니라 재료 태그와 대조해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najlepiej działa jedno słowo. Dopasowujemy je do tagów składników, a nie do nazw dań."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tek kelime en iyi sonucu verir. Bunlar yemek adlarıyla değil, malzeme etiketleriyle eşleşir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一个词效果最好。这里匹配的是配料标签，而不是菜名。"
          }
        }
      }
    },
