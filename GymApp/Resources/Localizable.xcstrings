    "onboarding.step.goals.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The first goal you pick leads. The rest shade the choices around it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El primer objetivo que elijas manda. Los demás matizan lo que se decide a su alrededor."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le premier objectif que tu choisis mène la danse. Les autres nuancent les choix autour de lui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका पहला लक्ष्य आगे रहता है। बाकी उसके आसपास के चुनावों को रंग देते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il primo obiettivo che scegli guida. Gli altri sfumano le scelte intorno a lui."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가장 먼저 고른 목표가 중심이 되고, 나머지는 그 주변을 채워요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pierwszy wybrany cel prowadzi. Reszta tylko cieniuje decyzje wokół niego."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İlk seçtiğin hedef belirleyici olur. Diğerleri çevresindeki seçimleri renklendirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "第一个目标起主导作用，其余的会影响它周围的取舍。"
          }
        }
      }
    },
