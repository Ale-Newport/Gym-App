    "meal.reason.budget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fits inside the food budget you set."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Encaja en el presupuesto de comida que fijaste."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tient dans le budget alimentaire que tu as fixé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके तय फ़ूड बजट में फ़िट बैठता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
