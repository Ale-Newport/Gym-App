    "nutritionLibrary.picker.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing here matches that. Create the food once and it is yours to reuse."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aquí no hay nada que coincida. Crea el alimento una vez y ya será tuyo para reutilizarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ici ne correspond. Crée l’aliment une fois et il sera à toi pour toujours."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यहाँ इससे मिलता-जुलता कुछ नहीं है। फ़ूड एक बार बना लें, फिर वह हमेशा आपका है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Qui non c'è nulla che corrisponda. Crea l'alimento una volta e resta tuo, pronto da riusare."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일치하는 음식이 없어요. 한 번 만들어 두면 계속 다시 쓸 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic tutaj nie pasuje. Utwórz produkt raz, a zostanie u Ciebie na przyszłość."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Buradaki hiçbir şey eşleşmiyor. Besini bir kez oluştur, sonra hep kullan."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里没有匹配的内容。创建一次，以后就可以一直用。"
          }
        }
      }
    },
