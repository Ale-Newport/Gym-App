    "progress.nutrition.macroFootnote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stacked by the energy each macronutrient carries: 4 kcal a gram for protein and carbohydrate, 9 for fat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apilado según la energía que aporta cada macronutriente: 4 kcal por gramo de proteína e hidratos, 9 de grasa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Empilé selon l’énergie apportée par chaque macronutriment : 4 kcal par gramme pour les protéines et les glucides, 9 pour les lipides."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर मैक्रोन्यूट्रिएंट की एनर्जी के हिसाब से जोड़ा गया: प्रोटीन और कार्बोहाइड्रेट में 4 kcal प्रति ग्राम, फैट में 9।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impilati in base all'energia che ogni macronutriente porta: 4 kcal per grammo per proteine e carboidrati, 9 per i grassi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her makro besinin taşıdığı enerjiye göre yığılmıştır: protein ve karbonhidrat için gram başına 4 kcal, yağ için 9 kcal."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按各宏量营养素提供的热量堆叠：蛋白质和碳水每克 4 kcal，脂肪每克 9 kcal。"
          }
        }
      }
    },
