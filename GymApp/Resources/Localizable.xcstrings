    "program.versions.immutable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "History is only ever added to. A version cannot be edited or deleted, so what your plan looked like, and why it changed, stays readable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al historial solo se le añade. Una versión no se puede editar ni eliminar, así que cómo era tu plan, y por qué cambió, queda siempre legible."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’historique ne fait que s’ajouter. Une version ne peut être ni modifiée ni supprimée : ce à quoi ton plan ressemblait, et pourquoi il a changé, reste lisible."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हिस्ट्री में सिर्फ़ जोड़ा जाता है। कोई वर्शन एडिट या मिटाया नहीं जा सकता, ताकि आपका प्लान कब कैसा था और क्यों बदला, यह पढ़ा जा सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Alla cronologia si può solo aggiungere. Una versione non si può modificare né eliminare, così resta leggibile com'era il tuo piano e perché è cambiato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록은 더해지기만 해요. 버전은 수정하거나 삭제할 수 없어서, 계획이 어땠고 왜 바뀌었는지 그대로 남아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Historia jest tylko dopisywana. Wersji nie da się edytować ani usunąć, dzięki czemu to, jak wyglądał Twój plan i dlaczego się zmienił, pozostaje czytelne."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçmişe yalnızca ekleme yapılır. Bir sürüm düzenlenemez veya silinemez; böylece planının nasıl göründüğü ve neden değiştiği okunabilir kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "历史只会被追加。版本无法编辑或删除，因此你的计划当时是什么样、为什么变化，始终可查。"
          }
        }
      }
    },
    "program.versions.openHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shows what this version contained"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
