          "stringUnit": {
            "state": "translated",
            "value": "A dash means this record does not list that nutrient, not that the food contains none of it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un guion significa que este registro no indica ese nutriente, no que el alimento no lo tenga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un tiret signifie que cette fiche n’indique pas ce nutriment, pas que l’aliment n’en contient pas."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "डैश का मतलब है कि इस रिकॉर्ड में वह पोषक तत्व दर्ज नहीं है — यह नहीं कि फ़ूड में वह बिल्कुल नहीं है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un trattino significa che questa scheda non riporta quel nutriente, non che l'alimento non ne contenga."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "줄표는 이 기록에 그 영양소가 적혀 있지 않다는 뜻이지, 들어 있지 않다는 뜻은 아니에요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Myślnik znaczy, że ten wpis nie podaje danego składnika — a nie że produkt go nie zawiera."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tire işareti, bu kaydın o besin ögesini belirtmediği anlamına gelir; besinde hiç bulunmadığı anlamına değil."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "短横线表示这条记录没有列出该营养素，并不代表这种食物完全不含它。"
          }
        }
      }
    },
