    "nutrition.adjust.approval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes until you accept it."
          }
        }
      }
    },
    "nutrition.adjust.ceilingReached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calories are already at %@ kcal, well above maintenance, so the app will not add any more."
          }
        }
      }
    },
    "nutrition.adjust.decrease": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are changing about %@ kg a week against a target of %@ kg, so taking off %@ kcal a day should bring you back on track."
          }
        }
      }
    },
    "nutrition.adjust.floorReached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calories are already at %@ kcal, the lowest this app will recommend for you. Moving more is the better lever from here."
          }
        }
      }
    },
    "nutrition.adjust.increase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are changing about %@ kg a week against a target of %@ kg, so adding %@ kcal a day should bring you back on track."
          }
        }
      }
    },
    "nutrition.adjust.insufficientData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are not enough weigh-ins yet. About %@ readings across %@ days are needed before the app can tell a real trend from day-to-day noise."
          }
        }
      }
    },
    "nutrition.adjust.lowAdherence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only about %@ of days were logged, so the trend cannot fairly be put down to your targets yet."
          }
        }
      }
    },
    "nutrition.adjust.lowConfidence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The weigh-ins are still too scattered to read a trend from, so your targets stay as they are."
          }
        }
      }
    },
    "nutrition.adjust.macroSplit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein stays where it is. The change goes to carbohydrate and fat."
          }
        }
      }
    },
    "nutrition.adjust.onTrack": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are changing about %@ kg a week against a target of %@ kg. That is close enough to leave alone."
          }
        }
      }
    },
    "nutrition.adjust.staleData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The most recent weigh-in is more than %@ days old, so the trend is out of date. Add a fresh one and the app will look again."
          }
        }
      }
    },
    "nutrition.adjust.tooSoon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your targets changed %@ days ago. The app waits at least %@ days so the scale has time to show what that change did."
          }
        }
      }
    },
    "nutrition.adjustAction.decrease": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eat a little less"
          }
        }
      }
    },
    "nutrition.adjustAction.hold": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep going as you are"
          }
        }
      }
    },
    "nutrition.adjustAction.increase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Eat a little more"
          }
        }
      }
    },
    "nutrition.adjustAction.insufficientData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Not enough data yet"
          }
        }
      }
    },
    "nutrition.energy.bmr": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your body is estimated to burn about %@ kcal a day at rest, from your height, weight and age."
          }
        }
      }
    },
    "nutrition.energy.bmrDefaultAge": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No date of birth on file, so the estimate assumes %@ years old. Add yours to make it more accurate."
          }
        }
      }
    },
    "nutrition.energy.bmrUnspecifiedSex": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Without a biological sex on file the estimate averages the two standard formulas, so it is less precise than it could be."
          }
        }
      }
    },
    "nutrition.energy.deficit": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Losing about %@ kg a week means eating around %@ kcal a day, roughly %@ kcal below maintenance."
          }
        }
      }
    },
    "nutrition.energy.deficitCapped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The deficit was capped at %@ kcal a day. Faster than that costs muscle and rarely lasts."
          }
        }
      }
    },
    "nutrition.energy.estimateDisclaimer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These figures are estimates to start from, not medical advice. The app will adjust them as your own results come in."
          }
        }
      }
    },
    "nutrition.energy.floorAboveMaintenance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The lowest daily intake this app will recommend for you is %@ kcal, which is already above your estimated maintenance of %@ kcal. Eating less than this is not something the app will suggest, so moving more is the better lever from here."
          }
        }
      }
    },
    "nutrition.energy.floorApplied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The calculated target was below the level this app is willing to recommend, so it was raised to %@ kcal a day."
          }
        }
      }
    },
    "nutrition.energy.maintenance": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your target sits at maintenance, about %@ kcal a day."
          }
        }
      }
    },
    "nutrition.energy.recomposition": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Building muscle while losing fat works best on a small deficit of about %@ kcal a day with plenty of protein, so your target is %@ kcal."
          }
        }
      }
    },
    "nutrition.energy.surplus": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gaining about %@ kg a week means eating around %@ kcal a day, roughly %@ kcal above maintenance."
          }
        }
      }
    },
    "nutrition.energy.surplusCapped": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The surplus was capped at %@ kcal a day so more of what you gain is muscle rather than fat."
          }
        }
      }
    },
    "nutrition.energy.tdee": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenance works out at roughly %@ kcal a day, from your activity level and %@ training days a week."
          }
        }
      }
    },
    "nutrition.macro.carbs": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Carbohydrate takes the remaining %@ g, which is what fuels your training."
          }
        }
      }
    },
    "nutrition.macro.fat": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat is set at %@ g, about %@ of your calories."
          }
        }
      }
    },
    "nutrition.macro.fatCompromise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat was trimmed to %@ g so the macros fit inside your calorie target."
          }
        }
      }
    },
    "nutrition.macro.fatFloor": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fat was held at %@ g, the minimum this app will recommend for hormones and vitamin absorption."
          }
        }
      }
    },
    "nutrition.macro.lowCalorieCompromise": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "At this calorie level protein and fat alone fill the budget, so carbohydrate is set to zero. A slower pace would give you a more workable plan."
          }
        }
      }
    },
    "nutrition.macro.protein": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Protein is set at %@ g, about %@ g per kg of body weight, which is the usual range for people who train."
          }
        }
      }
    },
    "nutrition.macro.proteinAdjustedMass": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
