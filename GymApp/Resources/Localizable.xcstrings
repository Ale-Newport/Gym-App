    "program.split.pickerNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are the structures that fit your training days, best first. Each one says why."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas son las estructuras que encajan con tus días de entrenamiento, las mejores primero. Cada una explica por qué."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Voici les structures qui conviennent à tes jours d’entraînement, les meilleures d’abord. Chacune explique pourquoi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये वे ढाँचे हैं जो आपके ट्रेनिंग दिनों में फ़िट बैठते हैं, सबसे उपयुक्त पहले। हर एक की वजह भी दी है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste sono le strutture che stanno nei tuoi giorni di allenamento, dalla migliore. Ognuna spiega perché."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "운동하는 요일에 맞는 구성이에요. 잘 맞는 순서로 보여 주고, 각각 이유도 함께 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To struktury pasujące do Twoich dni treningowych, najlepsze na górze. Przy każdej jest uzasadnienie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar antrenman günlerine uyan yapılar, en uygunu üstte. Her biri nedenini söylüyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "以下结构适合你的训练日，最合适的排在前面。每一项都会说明理由。"
          }
        }
      }
    },
