    "autoreg.addSet": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session felt easy and this muscle group is below its weekly target, so one set is being added."
          }
        }
      }
    },
    "autoreg.noChange": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything is on track. Your next session stays as planned."
          }
        }
      }
    },
    "autoreg.reduceLoad": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ came up short of its rep targets, so it starts a little lighter next time."
          }
        }
      }
    },
    "autoreg.reduceLoad.severe": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ missed its rep targets by a wide margin. Dropping the load to get the reps back."
          }
        }
      }
    },
    "autoreg.removeSet.fatigue": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This muscle group is still carrying a lot of fatigue, so one set is coming off."
          }
        }
      }
    },
    "autoreg.restLonger": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reps dropped away sharply between sets on %@. A longer rest should hold performance."
          }
        }
      }
    },
    "autoreg.shortenSession": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The session ran about %@ minutes past your time cap, so it is being trimmed."
          }
        }
      }
    },
    "autoreg.swap.failed": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ fell short on every set and there is no load to take off. A different exercise may fit better."
