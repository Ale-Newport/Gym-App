    "program.regenerate.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Locked exercises and your whole history are kept. The split, the sessions and every exercise you have not locked are chosen again from your goals, schedule and equipment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los ejercicios fijados y todo tu historial se mantienen. El split, las sesiones y todos los ejercicios que no hayas fijado se vuelven a elegir con tus objetivos, tu horario y tu material."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les exercices verrouillés et tout ton historique sont conservés. Le split, les séances et chaque exercice non verrouillé sont choisis à nouveau à partir de tes objectifs, de ton emploi du temps et de ton matériel."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक की गई एक्सरसाइज़ और आपकी पूरी हिस्ट्री बनी रहेगी। स्प्लिट, सेशन और हर वह एक्सरसाइज़ जो लॉक नहीं है, आपके लक्ष्यों, शेड्यूल और इक्विपमेंट से दोबारा चुनी जाएगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli esercizi bloccati e tutta la tua cronologia vengono mantenuti. Lo split, le sessioni e ogni esercizio non bloccato vengono scelti di nuovo dai tuoi obiettivi, impegni e attrezzatura."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠근 운동과 전체 기록은 그대로예요. 분할과 세션, 잠그지 않은 운동은 목표와 일정, 장비를 바탕으로 다시 골라요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowane ćwiczenia i cała Twoja historia zostają. Split, sesje i każde niezablokowane ćwiczenie dobieramy na nowo z Twoich celów, grafiku i sprzętu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitlediğin egzersizler ve tüm geçmişin korunur. Split, seanslar ve kilitlemediğin her egzersiz; hedeflerine, takvimine ve ekipmanına göre yeniden seçilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "锁定的动作和你的全部历史都会保留。分化、训练课以及所有未锁定的动作，都会依据你的目标、日程和器械重新挑选。"
          }
        }
      }
    },
