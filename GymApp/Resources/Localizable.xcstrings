    "program.settings.autoProgression.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each session's load is set from what you logged last time."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La carga de cada sesión se fija con lo que registraste la vez anterior."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La charge de chaque séance est fixée d’après ce que tu as enregistré la fois précédente."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सेशन का लोड पिछली बार आपने जो दर्ज किया उससे तय होता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il carico di ogni sessione viene impostato da quello che hai registrato la volta prima."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지난번 기록을 바탕으로 각 세션의 중량을 정해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ciężar na każdą sesję wynika z tego, co zapisałeś ostatnim razem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her seansın ağırlığı, geçen sefer kaydettiklerinden belirlenir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每节训练课的负重根据你上次的记录设定。"
          }
        }
      }
    },
    "program.settings.blockLength": {
      "extractionState": "manual",
      "localizations": {
