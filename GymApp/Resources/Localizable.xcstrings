    "onboarding.summary.nutritionOff": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No daily target is set, so the nutrition tab stays hidden."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ningún objetivo diario fijado, así que la pestaña de nutrición queda oculta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun objectif quotidien n’est défini, l’onglet nutrition reste donc masqué."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई दैनिक लक्ष्य तय नहीं है, इसलिए न्यूट्रिशन टैब छिपा रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è impostato nessun obiettivo giornaliero, quindi la scheda nutrizione resta nascosta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "하루 목표가 없어서 식단 탭은 보이지 않아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie ustawiono dziennego celu, więc zakładka diety pozostaje ukryta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlük hedef belirlenmedi, bu yüzden beslenme sekmesi gizli kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有设定每日目标，因此饮食标签页保持隐藏。"
          }
        }
      }
    },
