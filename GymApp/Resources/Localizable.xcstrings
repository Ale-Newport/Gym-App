        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ağırlığı %@ değerinden %@ değerine çıkarıldı; %@ seans boyunca %@ setin tamamını en az %@ tekrarla ve en az %@ tekrar yedekte bırakarak tamamladın."
