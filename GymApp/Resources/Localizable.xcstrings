    "onboarding.availability.activity.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Life outside the gym. It moves your energy estimate more than training does."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu vida fuera del gimnasio. Mueve tu estimación de energía más que el propio entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta vie en dehors de la salle. Elle pèse plus sur ton estimation énergétique que l’entraînement lui-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जिम के बाहर की ज़िंदगी। यह आपके एनर्जी अनुमान को ट्रेनिंग से भी ज़्यादा बदलती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La vita fuori dalla palestra. Sposta la stima energetica più dell'allenamento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체육관 밖의 생활이에요. 운동보다 열량 추정에 더 크게 작용해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Życie poza siłownią. Przesuwa Twój szacunek energii mocniej niż sam trening."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Salon dışındaki hayatın. Enerji tahminini antrenmandan daha çok etkiler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健身房之外的生活。它对热量估算的影响比训练还大。"
          }
        }
      }
    },
