    "nutritionLog.noTarget.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calories and macros are estimated from your height, weight, age, activity and goal. You can change any of them afterwards."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las calorías y los macros se estiman a partir de tu altura, tu peso, tu edad, tu actividad y tu objetivo. Después puedes cambiar lo que quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calories et les macros sont estimées à partir de ta taille, ton poids, ton âge, ton activité et ton objectif. Tu peux tout modifier ensuite."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलोरी और मैक्रो आपकी लंबाई, वज़न, उम्र, गतिविधि और लक्ष्य से अनुमानित होते हैं। बाद में आप इनमें कुछ भी बदल सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Calorie e macro sono stimate da altezza, peso, età, attività e obiettivo. Puoi cambiarli tutti in seguito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칼로리와 매크로는 키와 체중, 나이, 활동량, 목표로 추정해요. 나중에 무엇이든 바꿀 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorie i makro szacujemy z Twojego wzrostu, wagi, wieku, aktywności i celu. Wszystko możesz potem zmienić."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalori ve makrolar; boyundan, kilondan, yaşından, aktivitenden ve hedefinden tahmin edilir. Sonradan hepsini değiştirebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热量和宏量营养素会根据你的身高、体重、年龄、活动量和目标估算。之后任何一项都能改。"
          }
        }
      }
    },
