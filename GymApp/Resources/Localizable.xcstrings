    "program.session.lockNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A locked exercise is kept whenever this program is rebuilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Un ejercicio fijado se conserva cada vez que se reconstruye este programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un exercice verrouillé est conservé à chaque reconstruction de ce programme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लॉक की गई एक्सरसाइज़ प्रोग्राम दोबारा बनने पर भी बनी रहती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un esercizio bloccato viene mantenuto ogni volta che il programma viene ricostruito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠근 운동은 프로그램을 다시 만들어도 그대로 유지돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zablokowane ćwiczenie zostaje przy każdej przebudowie tego programu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kilitli bir egzersiz, program her yeniden kurulduğunda korunur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "重新生成这份计划时，锁定的动作会被保留。"
          }
        }
      }
    },
