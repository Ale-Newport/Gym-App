    "nutritionLibrary.meals.emptyEditorMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the foods this meal is made of, with the amounts you actually eat."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade los alimentos que componen esta comida, con las cantidades que comes de verdad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoute les aliments qui composent ce repas, avec les quantités que tu manges vraiment."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस मील में जो फ़ूड शामिल हैं उन्हें उतनी मात्रा के साथ जोड़ें जितना आप सचमुच खाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi gli alimenti di cui è fatto questo pasto, con le quantità che mangi davvero."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 식사를 이루는 음식을 실제로 먹는 양만큼 추가해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj produkty, z których składa się ten posiłek, w ilościach, jakie naprawdę jesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu öğünü oluşturan besinleri, gerçekten yediğin miktarlarla ekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把这一餐用到的食物按你实际吃的分量加进来。"
          }
        }
      }
    },
