    "program.versions.readOnly": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This is a record of what your plan looked like at the time. It cannot be edited, and nothing here changes the program you are following now."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto es el registro de cómo era tu plan entonces. No se puede editar, y nada de aquí cambia el programa que sigues ahora."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ceci est un instantané de ton plan à l’époque. Il ne peut pas être modifié, et rien ici ne change le programme que tu suis aujourd’hui."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह उस समय आपके प्लान का रिकॉर्ड है। इसे एडिट नहीं किया जा सकता, और यहाँ की किसी बात से आपका मौजूदा प्रोग्राम नहीं बदलता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo è il resoconto di com'era il tuo piano allora. Non si può modificare e nulla di ciò che c'è qui cambia il programma che stai seguendo ora."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "그때의 계획을 남긴 기록이에요. 수정할 수 없고, 지금 따르는 프로그램에도 영향을 주지 않아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To zapis tego, jak wyglądał wtedy Twój plan. Nie da się go edytować i nic tutaj nie zmienia programu, według którego trenujesz teraz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, planının o zamanki hâlinin bir kaydıdır. Düzenlenemez ve buradaki hiçbir şey şu an izlediğin programı değiştirmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是你的计划在当时的记录。它无法编辑，这里的内容也不会影响你正在执行的计划。"
          }
        }
      }
    },
