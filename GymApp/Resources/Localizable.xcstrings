    "program.session.regenerateMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge chooses a fresh set of exercises for this session. Anything you locked stays, and the rest of your program is untouched."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge escoge un conjunto nuevo de ejercicios para esta sesión. Lo que hayas fijado se queda, y el resto de tu programa no se toca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge choisit une nouvelle sélection d’exercices pour cette séance. Ce que tu as verrouillé reste, et le reste de ton programme n’est pas touché."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge इस सेशन के लिए एक्सरसाइज़ का नया सेट चुनेगा। आपकी लॉक की हुई चीज़ें बनी रहेंगी और बाकी प्रोग्राम अछूता रहेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge sceglie una nuova serie di esercizi per questa sessione. Quello che hai bloccato resta e il resto del programma non viene toccato."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge가 이 세션의 운동을 새로 골라요. 잠근 것은 유지되고, 프로그램의 나머지는 그대로예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge dobierze do tej sesji świeży zestaw ćwiczeń. To, co zablokowałeś, zostaje, a reszta programu pozostaje nietknięta."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge bu seans için yeni bir egzersiz seti seçer. Kilitlediklerin kalır, programının geri kalanına dokunulmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge 会为这节训练课挑选一组新动作。你锁定的内容保留，计划的其余部分不受影响。"
          }
        }
      }
    },
