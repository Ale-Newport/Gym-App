    "nutritionLibrary.food.noServings": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No servings yet. You can still log this food by weight."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no hay raciones. Puedes registrar este alimento por peso igualmente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pas encore de portions. Tu peux quand même enregistrer cet aliment au poids."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई सर्विंग नहीं। आप इस फ़ूड को वज़न से भी दर्ज कर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ancora nessuna porzione. Puoi comunque registrare questo alimento a peso."
