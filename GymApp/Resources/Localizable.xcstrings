    "settings.legal.privacy.local": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Everything you log — profile, programs, workouts, weigh-ins and food — is stored only on this device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todo lo que registras —perfil, programas, entrenamientos, pesajes y comida— se guarda solo en este dispositivo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout ce que tu enregistres — profil, programmes, séances, pesées et alimentation — est stocké uniquement sur cet appareil."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका दर्ज किया सब कुछ — प्रोफ़ाइल, प्रोग्राम, वर्कआउट, वज़न रिकॉर्ड और खाना — सिर्फ़ इसी डिवाइस पर रखा जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutto ciò che registri — profilo, programmi, allenamenti, pesate e alimenti — è salvato solo su questo dispositivo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydettiğin her şey — profil, programlar, antrenmanlar, tartımlar ve besinler — yalnızca bu cihazda saklanır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你记录的一切，包括个人资料、训练计划、训练、体重和饮食，都只保存在这台设备上。"
          }
        }
      }
    },
    "settings.legal.privacy.network": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge makes one kind of outbound request, and only when you ask for it: a food lookup on Open Food Facts, carrying just your search term or the barcode."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge hace un único tipo de petición hacia fuera, y solo cuando tú se lo pides: una consulta de alimento en Open Food Facts, que lleva únicamente tu término de búsqueda o el código de barras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge n’effectue qu’un seul type de requête sortante, et seulement quand tu le demandes : une recherche d’aliment sur Open Food Facts, ne transportant que ton terme de recherche ou le code-barres."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge बाहर सिर्फ़ एक तरह का अनुरोध भेजता है, और वह भी तभी जब आप कहें: Open Food Facts पर फ़ूड की खोज, जिसमें सिर्फ़ आपका खोज शब्द या बारकोड जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge fa un solo tipo di richiesta verso l'esterno, e solo quando sei tu a chiederlo: la ricerca di un alimento su Open Food Facts, che porta con sé soltanto il tuo termine di ricerca o il codice a barre."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge yalnızca tek tür dışa istek yapar ve bunu yalnızca sen istediğinde yapar: Open Food Facts üzerinde bir besin sorgusu; yanında yalnızca arama terimin ya da barkod gider."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge 只会发出一种对外请求，而且只在你主动发起时：在 Open Food Facts 上查询食物，只携带你的搜索词或条形码。"
          }
        }
      }
    },
    "settings.legal.privacy.noAccount": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no account, no login and no sync service. Nothing is uploaded."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay cuenta, ni inicio de sesión, ni servicio de sincronización. No se sube nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a ni compte, ni connexion, ni service de synchronisation. Rien n’est envoyé en ligne."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न कोई अकाउंट है, न लॉगिन और न कोई सिंक सेवा। कुछ भी अपलोड नहीं होता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è nessun account, nessun accesso e nessun servizio di sincronizzazione. Non viene caricato nulla."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hesap, giriş ve eşitleme servisi yoktur. Hiçbir şey yüklenmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有账号、没有登录、没有同步服务。不上传任何内容。"
          }
        }
      }
    },
    "settings.legal.privacy.noAnalytics": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There is no analytics, no crash reporting, no advertising identifier and no third-party framework of any kind."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay analítica, ni informes de fallos, ni identificador publicitario, ni ningún framework de terceros."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a aucune analyse d’usage, aucun rapport de plantage, aucun identifiant publicitaire et aucun framework tiers, quel qu’il soit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "न कोई एनालिटिक्स है, न क्रैश रिपोर्टिंग, न विज्ञापन पहचानकर्ता और न किसी तरह का थर्ड-पार्टी फ़्रेमवर्क।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non c'è nessuna analisi d'uso, nessun report di crash, nessun identificativo pubblicitario e nessun framework di terze parti di alcun tipo."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiçbir analiz, çökme raporu, reklam kimliği ya da üçüncü taraf çatı yoktur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有数据分析、没有崩溃上报、没有广告标识符，也没有任何第三方框架。"
          }
        }
      }
    },
    "settings.legal.privacy.notMedical": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge estimates readiness, suggests loads and calculates energy and macronutrient targets. These are estimates from documented formulas — not measurements, diagnoses or medical advice."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge estima la preparación, sugiere cargas y calcula objetivos de energía y macronutrientes. Son estimaciones a partir de fórmulas documentadas: no son mediciones, ni diagnósticos, ni consejo médico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge estime ta forme, suggère des charges et calcule des objectifs énergétiques et de macronutriments. Ce sont des estimations issues de formules documentées — pas des mesures, ni des diagnostics, ni un avis médical."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge तैयारी का अनुमान लगाता है, लोड सुझाता है और एनर्जी व मैक्रोन्यूट्रिएंट लक्ष्य निकालता है। ये दस्तावेज़ी फ़ॉर्मूलों से लगाए अनुमान हैं — न माप, न निदान, न मेडिकल सलाह।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge stima la prontezza, propone carichi e calcola obiettivi di energia e macronutrienti. Sono stime ricavate da formule documentate, non misurazioni, diagnosi o consigli medici."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge hazırlık düzeyini tahmin eder, ağırlık önerir, enerji ve makro besin hedefleri hesaplar. Bunlar belgelenmiş formüllerden çıkan tahminlerdir — ölçüm, teşhis ya da tıbbi tavsiye değildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge 会估算身体状态、建议负重，并计算热量和宏量营养素目标。这些是依据公开公式得出的估算，不是测量、诊断或医疗建议。"
          }
        }
      }
    },
    "settings.legal.privacy.optIn": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health, the camera and notifications are each off until you turn them on, and every feature works without them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Salud, la cámara y las notificaciones están desactivadas hasta que tú las actives, y todas las funciones sirven sin ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Santé, l’appareil photo et les notifications sont désactivés tant que tu ne les actives pas, et chaque fonction marche sans eux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Health, कैमरा और नोटिफ़िकेशन तब तक बंद रहते हैं जब तक आप उन्हें चालू न करें, और हर सुविधा उनके बिना भी काम करती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salute, la fotocamera e le notifiche restano disattivate finché non le attivi tu, e ogni funzione lavora anche senza."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlık, kamera ve bildirimler sen açana kadar kapalıdır ve her özellik bunlar olmadan da çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康、相机和通知都默认关闭，直到你开启为止；没有它们，每项功能也都能用。"
          }
        }
      }
    },
    "settings.legal.privacy.yourData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You can export everything, restore a backup or delete the lot under Settings, in Data."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes exportarlo todo, restaurar una copia o borrarlo entero en Ajustes, dentro de Datos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu peux tout exporter, restaurer une sauvegarde ou tout supprimer depuis les Réglages, dans Données."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप Settings में Data के तहत सब कुछ एक्सपोर्ट कर सकते हैं, बैकअप वापस ला सकते हैं या पूरा डेटा मिटा सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi esportare tutto, ripristinare un backup o cancellare ogni cosa dalle Impostazioni, in Dati."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şeyi dışa aktarabilir, bir yedeği geri yükleyebilir ya da tümünü Ayarlar'daki Veriler bölümünden silebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在设置的数据中导出全部内容、恢复备份或删除所有数据。"
          }
        }
      }
    },
    "settings.legal.section.dataset": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Exercise data"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de los ejercicios"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données d’exercices"
          }
        },
