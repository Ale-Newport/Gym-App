    "nutritionLibrary.meals.fromDayMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn a meal already in your diary into one you can log again in a tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Convierte una comida que ya está en tu diario en una que puedas registrar con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transforme un repas déjà dans ton journal en repas que tu pourras noter d’un geste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी डायरी में पहले से मौजूद किसी मील को ऐसा बना लें कि आगे एक टैप में दर्ज हो जाए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trasforma un pasto già nel tuo diario in uno che puoi registrare di nuovo con un tocco."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이미 기록해 둔 식사를 한 번에 다시 기록할 수 있는 식사로 만들어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamień posiłek z dziennika w taki, który zapiszesz ponownie jednym dotknięciem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlüğündeki bir öğünü, tek dokunuşla tekrar kaydedebileceğin bir öğüne dönüştür."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把日记里已有的一餐变成可以一键再次记录的餐食。"
          }
        }
      }
    },
