    "settings.equipment.incrementsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every load Forge suggests is rounded onto these, so it only ever asks for a weight you can actually make."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada carga que sugiere Forge se redondea a estos valores, así que nunca te pide un peso que no puedas montar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque charge que Forge propose est arrondie sur ces valeurs, pour ne jamais te demander un poids que tu ne peux pas composer."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge का सुझाया हर लोड इन्हीं पर गोल किया जाता है, ताकि वह सिर्फ़ वही वज़न माँगे जो आप सचमुच बना सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni carico che Forge propone viene arrotondato su questi valori, così ti chiede solo pesi che puoi davvero comporre."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge'un önerdiği her ağırlık bunlara yuvarlanır; böylece senden yalnızca gerçekten kurabileceğin bir ağırlık ister."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge 建议的每个负重都会按这些数值取整，因此它只会给出你真正能配出的重量。"
          }
        }
      }
    },
