    "settings.legal.opensInBrowser": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Opens in your browser"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre en tu navegador"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "S’ouvre dans ton navigateur"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके ब्राउज़र में खुलता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apre nel browser"
          }
        },
        "tr": {
