    "onboarding.experience.level.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This caps how demanding the exercises you are offered can be."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto limita lo exigentes que pueden ser los ejercicios que se te ofrecen."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela limite la difficulté des exercices qui te seront proposés."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे तय होता है कि आपको कितनी कठिन एक्सरसाइज़ तक दी जाएँगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Definisce quanto possono essere impegnativi gli esercizi che ti vengono proposti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "추천되는 운동의 난이도 상한을 정해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To ogranicza, jak wymagające ćwiczenia będziesz dostawać."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, sana sunulacak egzersizlerin zorluk üst sınırını belirler."
