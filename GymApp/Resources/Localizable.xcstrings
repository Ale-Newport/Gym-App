    "settings.nutrition.waterFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A rough guide rather than a rule. Warm days and long sessions ask for more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es una guía aproximada, no una regla. Los días calurosos y las sesiones largas piden más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un repère approximatif plutôt qu’une règle. Les journées chaudes et les longues séances en demandent plus."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह नियम नहीं, एक मोटा मार्गदर्शन है। गर्म दिन और लंबे सेशन ज़्यादा माँगते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'indicazione di massima più che una regola. Giornate calde e sessioni lunghe ne chiedono di più."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kesin bir kural değil, kaba bir rehber. Sıcak günler ve uzun seanslar daha fazlasını ister."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这是大致参考，不是硬性规定。天热和长时间训练都需要更多。"
          }
        }
      }
    },
