    "progress.strength.unestimable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This movement is not logged with a load and a rep count, so no one-rep max can be estimated from it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este movimiento no se registra con carga y repeticiones, así que no se puede estimar un máximo a una repetición."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce mouvement ne s’enregistre pas avec une charge et un nombre de répétitions : aucun 1RM ne peut en être estimé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह मूवमेंट लोड और रेप्स के साथ दर्ज नहीं होता, इसलिए इससे वन-रेप मैक्स का अनुमान नहीं लगाया जा सकता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo movimento non si registra con un carico e un numero di ripetizioni, quindi non se ne può stimare un massimale."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hareket ağırlık ve tekrar sayısıyla kaydedilmiyor, bu yüzden ondan tek tekrar maksimumu tahmin edilemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个动作不按负重和次数记录，因此无法据此推算 1RM。"
          }
        }
      }
    },
