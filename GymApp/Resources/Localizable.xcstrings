          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Depuis combien de temps, en gros, tu t’entraînes régulièrement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मोटे तौर पर आप कब से लगातार ट्रेनिंग कर रहे हैं।"
