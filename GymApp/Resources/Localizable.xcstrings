    "onboarding.experience.seeds.partial": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Fill in only the lifts you know. The rest are estimated from your first working sets."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Rellena solo los ejercicios que conozcas. El resto se estima con tus primeras series de trabajo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne remplis que les mouvements que tu connais. Les autres sont estimés à partir de tes premières séries de travail."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ वही लिफ़्ट भरें जो आप जानते हैं। बाकी आपके पहले वर्किंग सेट से अनुमानित हो जाएँगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Compila solo gli esercizi che conosci. Gli altri vengono stimati dalle tue prime serie di lavoro."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아는 종목만 채우면 돼요. 나머지는 첫 본세트에서 추정해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypełnij tylko te boje, które znasz. Resztę oszacujemy z Twoich pierwszych serii roboczych."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bildiğin hareketleri doldur. Kalanlar ilk çalışma setlerinden tahmin edilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只填你知道的动作。其余的会从你最初的正式组推算。"
          }
        }
      }
    },
