    "onboarding.step.nutrition.subtitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Turn it off and the nutrition tab stays out of your way."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Desactívalo y la pestaña de nutrición no te molestará."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Désactive-la et l’onglet nutrition reste hors de ton chemin."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। बंद कर दें तो न्यूट्रिशन टैब आपके रास्ते से हट जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Se la disattivi, la scheda nutrizione resta fuori dai piedi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 꺼 두면 식단 탭이 보이지 않아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Wyłącz, a zakładka diety zejdzie Ci z drogi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Kapatırsan beslenme sekmesi karşına çıkmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。关掉之后，饮食标签页就不会出现。"
          }
        }
      }
    },
