    "program.session.volumeFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weekly volume for the muscle groups this session trains. Changes you make here move it straight away."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Volumen semanal de los grupos musculares que entrena esta sesión. Los cambios que hagas aquí lo mueven al momento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume hebdomadaire des groupes musculaires que cette séance travaille. Tes modifications le font bouger immédiatement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस सेशन में जिन मसल ग्रुप की ट्रेनिंग होती है, उनका साप्ताहिक वॉल्यूम। यहाँ किए बदलाव इसे तुरंत बदल देते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Volume settimanale dei gruppi muscolari che questa sessione allena. Le modifiche che fai qui lo spostano subito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 세션이 자극하는 근육 그룹의 주간 볼륨이에요. 여기서 바꾸면 바로 반영돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tygodniowa objętość dla grup mięśniowych, które trenuje ta sesja. Twoje zmiany od razu ją przesuwają."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu seansın çalıştırdığı kas grupları için haftalık hacim. Burada yaptığın değişiklikler anında yansır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这节训练课涉及肌群的每周训练量。你在这里的修改会立即反映出来。"
          }
        }
      }
    },
