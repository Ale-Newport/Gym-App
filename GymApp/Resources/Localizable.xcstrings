    "settings.units.footer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Units change only what you see. Nothing you have logged is converted or rewritten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las unidades solo cambian lo que ves. Nada de lo que has registrado se convierte ni se reescribe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les unités ne changent que ce que tu vois. Rien de ce que tu as enregistré n’est converti ni réécrit."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इकाइयाँ सिर्फ़ यह बदलती हैं कि आपको क्या दिखे। आपका दर्ज किया कुछ भी बदला या दोबारा लिखा नहीं जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le unità cambiano solo quello che vedi. Nulla di ciò che hai registrato viene convertito o riscritto."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birimler yalnızca gördüğünü değiştirir. Kaydettiğin hiçbir şey dönüştürülmez ya da yeniden yazılmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "单位只影响显示。你记录过的内容不会被换算或改写。"
          }
        }
      }
    },
