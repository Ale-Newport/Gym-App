    "active.edit.routineAddedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has been added to today. Add it to this session in your routine as well?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ha añadido a hoy. ¿Lo añadimos también a esta sesión en tu rutina?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été ajouté à aujourd’hui. L’ajouter aussi à cette séance dans ta routine ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ आज में जुड़ गई है। क्या इसे आपकी रूटीन के इस सेशन में भी जोड़ दें?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato aggiunto a oggi. Vuoi aggiungerlo anche a questa sessione nella tua routine?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已加入今天的训练。是否也把它加入常规安排中的这节训练课？"
          }
        }
      }
    },
    "active.edit.routineRemovedMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ has been removed from today. Remove it from this session in your routine as well?"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ se ha quitado de hoy. ¿Lo quitamos también de esta sesión en tu rutina?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a été retiré d’aujourd’hui. Le retirer aussi de cette séance dans ta routine ?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ आज से हट गई है। क्या इसे आपकी रूटीन के इस सेशन से भी हटा दें?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ è stato tolto da oggi. Vuoi toglierlo anche da questa sessione nella tua routine?"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已从今天的训练中移除。是否也把它从常规安排中的这节训练课移除？"
          }
        }
      }
    },
