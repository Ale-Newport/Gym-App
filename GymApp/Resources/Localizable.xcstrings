    "nutritionLog.suggestions.noTarget": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set your targets to get suggestions that fit your day."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fija tus objetivos para recibir sugerencias que encajen con tu día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définis tes objectifs pour recevoir des suggestions adaptées à ta journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने लक्ष्य तय करें ताकि आपके दिन में फ़िट बैठने वाले सुझाव मिल सकें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta i tuoi obiettivi per ricevere proposte adatte alla tua giornata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표를 정하면 오늘 하루에 맞는 추천을 받을 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ustaw cele, żeby dostawać propozycje pasujące do Twojego dnia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gününe uyan öneriler için hedeflerini belirle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设定目标后，就能获得贴合你这一天的建议。"
          }
        }
      }
    },
