      }
    },
    "nutrition.adjust.tooSoon": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your targets changed %@ days ago. The app waits at least %@ days so the scale has time to show what that change did."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus objetivos cambiaron hace %@ días. La app espera al menos %@ días para que la báscula tenga tiempo de mostrar el efecto de ese cambio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes objectifs ont changé il y a %@ jours. L’app attend au moins %@ jours pour laisser à la balance le temps de montrer l’effet de ce changement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके लक्ष्य %@ दिन पहले बदले थे। ऐप कम से कम %@ दिन रुकता है, ताकि तराजू उस बदलाव का असर दिखा सके।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi obiettivi sono cambiati %@ giorni fa. L'app aspetta almeno %@ giorni perché la bilancia abbia il tempo di mostrare l'effetto di quel cambiamento."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "목표를 바꾼 지 %@일 됐어요. 그 변화가 체중에 나타날 시간을 주려고 최소 %@일은 기다려요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje cele zmieniły się %@ dni temu. Aplikacja czeka co najmniej %@ dni, żeby waga zdążyła pokazać efekt tej zmiany."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedeflerin %@ gün önce değişti. Tartının bu değişikliğin etkisini gösterebilmesi için uygulama en az %@ gün bekler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
