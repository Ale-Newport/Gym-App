    "nutritionLog.copyDay.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Once you have logged a few days, you can copy one across in a single tap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cuando hayas registrado unos cuantos días, podrás copiar uno entero con un toque."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dès que tu auras enregistré quelques journées, tu pourras en copier une d’un seul geste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुछ दिन दर्ज कर लेने के बाद आप किसी एक दिन को एक टैप में कॉपी कर सकेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quando avrai registrato qualche giorno, potrai copiarne uno con un solo tocco."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "며칠 기록하고 나면 한 번에 하루를 통째로 복사할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gdy zapiszesz kilka dni, przekopiujesz jeden z nich jednym dotknięciem."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Birkaç gün kaydettikten sonra, bir günü tek dokunuşla kopyalayabilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "记录几天之后，就可以一键把某一天复制过来。"
          }
        }
      }
    },
