    "onboarding.summary.program.empty.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your answers are saved, but nothing has been built from them yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus respuestas están guardadas, pero todavía no se ha montado nada con ellas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes réponses sont enregistrées, mais rien n’a encore été construit à partir d’elles."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके जवाब सेव हो गए हैं, पर उनसे अभी कुछ बनाया नहीं गया।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue risposte sono salvate, ma non è ancora stato costruito nulla da esse."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변은 저장됐지만, 아직 그것으로 만든 프로그램이 없어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje odpowiedzi są zapisane, ale nic jeszcze z nich nie powstało."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtların kaydedildi ama henüz onlardan bir şey kurulmadı."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的回答已保存，但还没有据此生成任何内容。"
          }
        }
      }
    },
