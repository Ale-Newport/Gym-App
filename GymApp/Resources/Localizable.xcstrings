    "nutritionLibrary.suggest.nothingToLog": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "None of these foods are in your library any more, so nothing was logged."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ninguno de estos alimentos sigue en tu biblioteca, así que no se ha registrado nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun de ces aliments n’est encore dans ta bibliothèque, rien n’a donc été enregistré."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इनमें से कोई फ़ूड अब आपकी लाइब्रेरी में नहीं है, इसलिए कुछ दर्ज नहीं हुआ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuno di questi alimenti è più nella tua libreria, quindi non è stato registrato nulla."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 음식들이 내 목록에 더 이상 없어서 아무것도 기록하지 않았어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żadnego z tych produktów nie ma już w Twojej bibliotece, więc nic nie zostało zapisane."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu besinlerin hiçbiri artık kütüphanende değil, bu yüzden hiçbir şey kaydedilmedi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这些食物都已不在你的食物库里，因此没有记录任何内容。"
          }
        }
      }
    },
    "nutritionLibrary.suggest.pieces": {
