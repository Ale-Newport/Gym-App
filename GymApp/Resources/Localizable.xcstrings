    "settings.training.limitationsFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge simply schedules around these. They stay on your device and are never treated as a diagnosis."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge simplemente los esquiva al programar. Se quedan en tu dispositivo y nunca se tratan como un diagnóstico."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge se contente de planifier autour. Ces choix restent sur ton appareil et ne sont jamais traités comme un diagnostic."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge बस इनके इर्द-गिर्द योजना बनाता है। ये आपके डिवाइस पर ही रहते हैं और इन्हें कभी निदान की तरह नहीं लिया जाता।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge si limita a programmare aggirandoli. Restano sul tuo dispositivo e non vengono mai trattati come una diagnosi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge planlarını yalnızca bunların etrafından kurar. Bunlar cihazında kalır ve asla teşhis olarak ele alınmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge 只是绕开这些内容。它们保存在你的设备上，也不会被当作诊断。"
          }
        }
      }
    },
    "settings.training.limitationsNone": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
