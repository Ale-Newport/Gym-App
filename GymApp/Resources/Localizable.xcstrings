    "import.strategy.replace.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Delete everything on this device first, then restore the backup exactly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Borra primero todo lo que hay en este dispositivo y luego restaura la copia tal cual."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprime d’abord tout ce qui est sur cet appareil, puis restaure la sauvegarde à l’identique."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले इस डिवाइस का सब कुछ मिटाएँ, फिर बैकअप हूबहू वापस लाएँ।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimina prima tutto quello che c'è su questo dispositivo, poi ripristina il backup esattamente com'è."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 데이터를 모두 지운 뒤 백업을 그대로 복원해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw usuń wszystko z tego urządzenia, potem odtwórz kopię dokładnie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce bu cihazdaki her şeyi sil, sonra yedeği olduğu gibi geri yükle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先清空本机全部内容，再完整恢复这份备份。"
          }
        }
      }
    },
