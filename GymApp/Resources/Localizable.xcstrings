          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten szablon nie zawiera żadnych ćwiczeń."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu şablonda hiç egzersiz yok."
          }
        },
        "zh-Hans": {
