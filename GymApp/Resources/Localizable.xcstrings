    "onboarding.equipment.fineTune.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tick everything you can reach, and untick anything you cannot."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Marca todo a lo que llegues y desmarca lo que no tengas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Coche tout ce que tu peux utiliser, et décoche le reste."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो कुछ आपकी पहुँच में है उसे चुनें, और जो नहीं है उसे हटा दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Spunta tutto ciò a cui arrivi e togli la spunta a ciò che non hai."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓸 수 있는 건 모두 체크하고, 없는 건 체크를 해제해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaznacz wszystko, do czego masz dostęp, i odznacz to, czego nie masz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ulaşabildiğin her şeyi işaretle, ulaşamadıklarının işaretini kaldır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "勾选你能用到的，取消勾选用不到的。"
          }
        }
      }
    },
    "onboarding.equipment.increments": {
