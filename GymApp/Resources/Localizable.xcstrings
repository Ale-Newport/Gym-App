    "nutritionLibrary.targets.macroMismatch": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your protein, carbs and fat add up to %@, which does not match the %@ you entered."
