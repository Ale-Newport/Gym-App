          "stringUnit": {
            "state": "translated",
            "value": "लोड गोल करने के लिए Forge को यहाँ कम से कम एक वज़न चाहिए।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "A Forge serve almeno un peso qui su cui arrotondare i carichi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge'un ağırlıkları yuvarlayabilmesi için burada en az bir ağırlık gerekir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge 至少需要这里有一个重量，才能对负重取整。"
          }
        }
      }
    },
