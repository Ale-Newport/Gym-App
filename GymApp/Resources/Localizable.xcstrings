    "nutritionLog.disabled.message": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Turn it on to track calories, macros and micronutrients alongside your training."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Actívala para llevar la cuenta de calorías, macros y micronutrientes junto a tu entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Active-la pour suivre tes calories, tes macros et tes micronutriments en parallèle de ton entraînement."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे चालू करें और ट्रेनिंग के साथ-साथ कैलोरी, मैक्रो और माइक्रोन्यूट्रिएंट भी ट्रैक करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attivala per seguire calorie, macro e micronutrienti insieme ai tuoi allenamenti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "켜면 운동과 함께 칼로리, 매크로, 미량 영양소를 기록할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz ją, żeby obok treningu śledzić kalorie, makro i mikroskładniki."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaloriyi, makroları ve mikro besinleri antrenmanınla birlikte takip etmek için aç."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开之后，可以在训练之外记录热量、宏量营养素和微量营养素。"
          }
        }
      }
    },
