    "intents.error.storeUnavailable": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge could not open its data. Open the app once and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge no ha podido abrir sus datos. Abre la app una vez y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge n’a pas pu ouvrir ses données. Ouvre l’app une fois puis réessaie."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge अपना डेटा नहीं खोल सका। ऐप एक बार खोलकर फिर कोशिश करें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Forge non è riuscita ad aprire i suoi dati. Apri l'app una volta e riprova."
          }
        },
        "zh-Hans": {
