    "nutritionLibrary.micros.referenceNote": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Reference intakes are general adult figures from published guidance, not targets set for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las ingestas de referencia son cifras generales para adultos tomadas de guías publicadas, no objetivos fijados para ti."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les apports de référence sont des valeurs générales pour un adulte, issues de recommandations publiées, et non des objectifs fixés pour toi."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "संदर्भ मात्राएँ प्रकाशित दिशानिर्देशों के सामान्य वयस्क आँकड़े हैं, आपके लिए तय किए गए लक्ष्य नहीं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le assunzioni di riferimento sono valori generali per adulti presi da linee guida pubblicate, non obiettivi calcolati su di te."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기준 섭취량은 공개된 지침의 일반 성인 수치이고, 개인에게 맞춘 목표는 아니에요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Spożycie referencyjne to ogólne wartości dla dorosłych z opublikowanych wytycznych, a nie cele ustawione dla Ciebie."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Referans alımlar, yayımlanmış kılavuzlardan alınan genel yetişkin değerleridir; sana özel hedefler değildir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "参考摄入量取自公开指南中的一般成人数值，不是为你设定的目标。"
          }
        }
      }
    },
