    "settings.about.rerunOnboarding.confirmMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your workouts, personal records and food log are all kept. You only answer the setup questions again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus entrenamientos, tus récords personales y tu registro de comidas se conservan. Solo vuelves a responder las preguntas iniciales."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tes séances, tes records personnels et ton journal alimentaire sont tous conservés. Tu réponds simplement à nouveau aux questions de configuration."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके वर्कआउट, पर्सनल रिकॉर्ड और फ़ूड लॉग सब बने रहेंगे। आप सिर्फ़ सेटअप के सवालों के जवाब फिर से देंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I tuoi allenamenti, i record personali e il diario alimentare restano tutti. Rispondi soltanto di nuovo alle domande iniziali."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Antrenmanların, kişisel rekorların ve besin günlüğün korunur. Yalnızca kurulum sorularını tekrar yanıtlarsın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的训练、个人纪录和饮食记录都会保留。你只需要重新回答设置问题。"
          }
        }
      }
    },
