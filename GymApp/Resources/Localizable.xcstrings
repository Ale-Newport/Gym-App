          }
        }
      }
    },
    "program.settings.blockLength.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The last week of each block is planned lighter on purpose, and a new block starts fresh after it. This takes effect the next time your program is rebuilt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La última semana de cada bloque se planifica más suave a propósito, y después empieza un bloque nuevo desde cero. Esto se aplica la próxima vez que se reconstruya tu programa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dernière semaine de chaque bloc est volontairement plus légère, et un nouveau bloc repart à neuf ensuite. Cela prendra effet à la prochaine reconstruction de ton programme."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर ब्लॉक का आखिरी हफ़्ता जानबूझकर हल्का रखा जाता है, और उसके बाद नया ब्लॉक ताज़ा शुरू होता है। यह अगली बार प्रोग्राम बनने पर लागू होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'ultima settimana di ogni blocco è pianificata più leggera di proposito, e dopo di essa parte un blocco nuovo. Ha effetto la prossima volta che il programma viene ricostruito."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 블록의 마지막 주는 일부러 가볍게 계획하고, 그다음 블록은 새로 시작해요. 다음에 프로그램을 다시 만들 때 적용돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ostatni tydzień każdego bloku jest celowo zaplanowany lżej, a po nim zaczyna się świeży blok. Zadziała to przy najbliższej przebudowie programu."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her bloğun son haftası bilerek daha hafif planlanır ve ardından yeni bir blok sıfırdan başlar. Bu, programın bir sonraki kurulumunda geçerli olur."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每个周期的最后一周会有意安排得更轻，之后新的周期重新开始。这会在下次重新生成计划时生效。"
          }
        }
      }
    },
