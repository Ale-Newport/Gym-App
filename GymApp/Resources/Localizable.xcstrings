    "workoutHub.reschedule.nextWeek": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ waits until next %@ — this week has no training days left."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ espera al %@ que viene: esta semana ya no quedan días de entrenamiento."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ attend jusqu’à %@ prochain — il ne reste plus de jour d’entraînement cette semaine."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ अगले %@ तक इंतज़ार करेगा — इस हफ़्ते कोई ट्रेनिंग दिन नहीं बचा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ aspetta %@ prossimo: questa settimana non restano giorni di allenamento."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 要等到下个%@，本周已经没有剩余的训练日。"
          }
        }
      }
    },
    "workoutHub.reschedule.noChangeNeeded": {
      "extractionState": "manual",
      "localizations": {
        "en": {
