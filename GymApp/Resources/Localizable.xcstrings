    "settings.profile.birthDateExplainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your age sharpens the energy estimate. Without it, Forge falls back to a wider default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu edad afina la estimación de energía. Sin ella, Forge recurre a un valor por defecto más amplio."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ton âge affine l’estimation énergétique. Sans lui, Forge s’appuie sur une valeur par défaut plus large."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी उम्र से एनर्जी का अनुमान और सटीक होता है। इसके बिना Forge एक व्यापक डिफ़ॉल्ट पर चला जाता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua età rende più precisa la stima energetica. Senza, Forge ripiega su un valore predefinito più generico."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yaşın enerji tahminini netleştirir. Olmadan Forge daha geniş bir varsayıma düşer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "年龄能让热量估算更准确。没有它，Forge 会退回到更宽泛的默认值。"
          }
        }
      }
    },
    "settings.profile.bodyExplainer": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Weight can be %@ and height %@. Both feed your energy target and every load estimate."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El peso puede ser %@ y la altura %@. Ambos alimentan tu objetivo de energía y todas las estimaciones de carga."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le poids peut être en %@ et la taille en %@. Les deux alimentent ton objectif énergétique et chaque estimation de charge."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वज़न %@ में और लंबाई %@ में रखी जा सकती है। दोनों आपके एनर्जी लक्ष्य और हर लोड अनुमान में जाते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il peso può essere in %@ e l'altezza in %@. Entrambi alimentano il tuo obiettivo energetico e ogni stima di carico."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ağırlık %@, boy ise %@ olarak girilebilir. İkisi de enerji hedefini ve her ağırlık tahminini besler."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体重可以用 %@，身高可以用 %@。两者都会影响你的热量目标和每一次负重估算。"
          }
        }
      }
    },
