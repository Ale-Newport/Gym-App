    "nutritionLog.recipes.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Build a recipe once and log a serving of it whenever you cook it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crea una receta una vez y registra una ración cada vez que la cocines."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Construis une recette une fois et enregistre-en une portion à chaque fois que tu la cuisines."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रेसिपी एक बार बनाएँ और जब भी पकाएँ, उसकी एक सर्विंग दर्ज कर दें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Costruisci una ricetta una volta e registrane una porzione ogni volta che la cucini."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "레시피를 한 번 만들어 두면 요리할 때마다 1회분씩 기록할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zbuduj przepis raz i zapisuj jego porcję za każdym razem, gdy go ugotujesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarifi bir kez oluştur, her pişirdiğinde bir porsiyonunu kaydet."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "食谱建一次，之后每次做的时候按份记录就行。"
          }
        }
      }
    },
