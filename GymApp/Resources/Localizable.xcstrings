    "nutritionLibrary.micros.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Micronutrients are added up from what you log, so this fills in as the day goes on."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los micronutrientes se suman a partir de lo que registras, así que esto se irá rellenando a lo largo del día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les micronutriments s’additionnent à partir de ce que tu enregistres : cela se remplit donc au fil de la journée."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "माइक्रोन्यूट्रिएंट आपकी दर्ज की गई चीज़ों से जुड़ते हैं, इसलिए दिन बढ़ने के साथ यह भरता जाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I micronutrienti si sommano da ciò che registri, quindi questa schermata si riempie man mano che passa la giornata."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미량 영양소는 기록한 음식에서 합산되기 때문에 하루가 지나면서 채워져요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikroskładniki sumują się z tego, co zapisujesz, więc będą się tu pojawiać w ciągu dnia."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikro besinler kaydettiklerinden toplanır, yani gün ilerledikçe burası dolar."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "微量营养素是从你记录的内容累加出来的，随着一天进行会逐渐填满。"
          }
        }
      }
    },
    "nutritionLibrary.micros.emptyTitle": {
      "extractionState": "manual",
      "localizations": {
        "en": {
