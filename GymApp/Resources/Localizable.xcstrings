    "nutritionLog.savedMeals.emptyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Save a meal you eat often and you can log the whole thing at once."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarda una comida que hagas a menudo y podrás registrarla entera de una vez."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistre un repas que tu manges souvent et tu pourras le noter en entier d’un coup."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जो मील आप अक्सर खाते हैं उसे सेव कर लें, फिर पूरा मील एक साथ दर्ज कर सकेंगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salva un pasto che fai spesso e potrai registrarlo tutto in una volta."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자주 먹는 식사를 저장해 두면 한 번에 전체를 기록할 수 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz posiłek, który jesz często, a dodasz całość naraz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sık yediğin bir öğünü kaydet; tamamını tek seferde kaydedebilesin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把常吃的一餐存起来，以后可以一次记录整份。"
          }
        }
      }
    },
