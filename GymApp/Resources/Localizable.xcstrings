    "onboarding.generate.manual.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You get an empty week with the right number of days, ready to fill in whenever you like."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Te queda una semana vacía con el número de días correcto, lista para rellenarla cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu obtiens une semaine vide avec le bon nombre de jours, prête à être remplie quand tu veux."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपको सही संख्या में दिनों वाला खाली हफ़्ता मिलेगा, जिसे आप जब चाहें भर सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevi una settimana vuota con il giusto numero di giorni, pronta da riempire quando vuoi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요일 수만 맞춘 빈 한 주를 받아, 원할 때 채우면 돼요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dostaniesz pusty tydzień z właściwą liczbą dni, gotowy do wypełnienia, kiedy zechcesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Doğru sayıda güne sahip boş bir hafta alırsın; istediğin zaman doldurursun."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你会得到一份天数正确的空白周计划，随时可以自己填。"
          }
        }
      }
    },
    "onboarding.generate.manualExplanation": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are building this program yourself, so there is nothing for the app to explain yet. Add exercises to each day whenever you are ready."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás montando este programa tú mismo, así que todavía no hay nada que la app pueda explicar. Añade ejercicios a cada día cuando quieras."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu construis ce programme toi-même : il n’y a donc rien que l’app puisse expliquer pour l’instant. Ajoute des exercices à chaque jour quand tu es prêt."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह प्रोग्राम आप खुद बना रहे हैं, इसलिए ऐप के पास अभी समझाने को कुछ नहीं है। जब तैयार हों, हर दिन में एक्सरसाइज़ जोड़ें।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai costruendo tu questo programma, quindi non c'è ancora nulla che l'app possa spiegare. Aggiungi esercizi a ogni giornata quando vuoi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 프로그램은 직접 만들고 있어서 앱이 설명할 내용이 아직 없어요. 준비되면 각 요일에 운동을 추가해 주세요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten program budujesz sam, więc aplikacja nie ma jeszcze czego wyjaśniać. Dodawaj ćwiczenia do kolejnych dni, kiedy będziesz gotowy."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu programı kendin kuruyorsun, dolayısıyla uygulamanın açıklayacağı bir şey yok. Hazır olduğunda her güne egzersiz ekle."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这份训练计划由你自己安排，因此暂时没有需要 App 解释的内容。你可以随时为每天添加动作。"
          }
        }
      }
    },
    "onboarding.generate.patience": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This takes a moment. Every exercise in the library is scored against your answers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esto tarda un momento. Cada ejercicio de la biblioteca se puntúa según tus respuestas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cela prend un instant. Chaque exercice de la bibliothèque est évalué au regard de tes réponses."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसमें एक पल लगता है। लाइब्रेरी की हर एक्सरसाइज़ आपके जवाबों पर परखी जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ci vuole un attimo. Ogni esercizio della libreria viene valutato sulle tue risposte."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠시 걸려요. 목록의 모든 운동을 답변과 대조해 점수를 매기고 있어요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To chwilę potrwa. Każde ćwiczenie z biblioteki jest oceniane względem Twoich odpowiedzi."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu biraz sürer. Kütüphanedeki her egzersiz, yanıtlarına göre puanlanıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这需要一点时间。动作库里的每个动作都会按你的回答打分。"
          }
        }
      }
    },
