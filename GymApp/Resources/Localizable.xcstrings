        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przyrost około %@ kg tygodniowo oznacza jedzenie około %@ kcal dziennie, czyli mniej więcej %@ kcal powyżej podtrzymania."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada yaklaşık %@ kg almak, günde yaklaşık %@ kcal yemek demek; bu da idamenin kabaca %@ kcal üstü."
