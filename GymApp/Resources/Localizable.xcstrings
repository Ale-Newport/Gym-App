    "onboarding.nutrition.budget.currency": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "In your own currency. It is only ever compared against itself."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu propia moneda. Solo se compara consigo mismo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans ta propre monnaie. Il n’est jamais comparé qu’à lui-même."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी अपनी मुद्रा में। इसकी तुलना सिर्फ़ अपने आप से ही की जाती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella tua valuta. Viene confrontato solo con se stesso."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "쓰는 통화 그대로예요. 서로 비교하는 데에만 써요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W Twojej własnej walucie. Porównujemy go zawsze tylko z nim samym."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kendi para biriminle. Yalnızca kendi içinde karşılaştırılır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用你自己的货币。它只会和自身比较。"
          }
        }
      }
    },
    "onboarding.nutrition.budget.detail": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Optional. Cheaper suggestions are preferred when you set one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcional. Si lo fijas, se dará preferencia a las sugerencias más baratas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Facultatif. Les suggestions les moins chères sont privilégiées si tu en définis un."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक। बजट तय करने पर सस्ते सुझावों को प्राथमिकता मिलती है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Facoltativo. Se lo imposti, le proposte più economiche vengono preferite."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "선택 사항이에요. 설정하면 더 저렴한 추천을 우선해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opcjonalne. Kiedy go ustawisz, wybieramy tańsze propozycje."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İsteğe bağlı. Bütçe belirlersen daha uygun fiyatlı öneriler tercih edilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可选。设定之后，会优先推荐更便宜的选择。"
          }
        }
      }
    },
