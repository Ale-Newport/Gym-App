    "program.split.applyHint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rebuilds your week around this split"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruye tu semana con este split"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Reconstruit ta semaine autour de ce split"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस स्प्लिट पर आपका हफ़्ता दोबारा बनाता है"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricostruisce la settimana su questo split"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 분할에 맞춰 한 주를 다시 짜요"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przebudowuje Twój tydzień wokół tego splitu"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftanı bu split'e göre yeniden kurar"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按这种分化重新生成你的一周"
          }
        }
      }
    },
    "program.split.applyMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your week is rebuilt around this structure. Locked exercises are kept, and your history stays as it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu semana se reconstruye con esta estructura. Los ejercicios fijados se mantienen y tu historial se queda como está."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta semaine est reconstruite autour de cette structure. Les exercices verrouillés sont conservés et ton historique reste intact."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका हफ़्ता इसी ढाँचे पर दोबारा बनेगा। लॉक की गई एक्सरसाइज़ बनी रहेंगी और आपकी हिस्ट्री वैसी ही रहेगी।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua settimana viene ricostruita su questa struttura. Gli esercizi bloccati restano e la tua cronologia non cambia."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 구성에 맞춰 한 주가 다시 짜여요. 잠근 운동은 유지되고 기록도 그대로예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twój tydzień zostanie przebudowany wokół tej struktury. Zablokowane ćwiczenia zostają, a historia pozostaje bez zmian."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftan bu yapıya göre yeniden kurulur. Kilitli egzersizler korunur, geçmişin olduğu gibi kalır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的一周会按这个结构重新生成。锁定的动作会保留，历史记录保持不变。"
          }
        }
      }
    },
