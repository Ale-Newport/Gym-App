            "value": "Picking new exercises affects this session only. Anything you locked stays where it is."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elegir ejercicios nuevos afecta solo a esta sesión. Lo que hayas fijado se queda donde está."
