    "progression.explain.extendDuration": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ moves up to %@ to %@ seconds a set. You held %@ seconds on every set last session."
          }
