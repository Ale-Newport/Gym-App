    "settings.health.connectionFooter": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS asks you about each data type separately, and you can change any answer later."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS te pregunta por cada tipo de dato por separado, y puedes cambiar cualquier respuesta después."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS te demande son accord pour chaque type de donnée séparément, et tu peux changer chaque réponse plus tard."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS हर डेटा प्रकार के लिए अलग से पूछता है, और आप कोई भी जवाब बाद में बदल सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS ti chiede il permesso per ogni tipo di dato separatamente, e puoi cambiare ogni risposta in seguito."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS her veri türünü sana ayrı ayrı sorar ve verdiğin her yanıtı sonradan değiştirebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "iOS 会逐项询问每种数据类型，之后你随时可以更改任何一项。"
          }
        }
      }
    },
    "settings.health.denied": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health access was declined. You can change it in iOS Settings, under Health."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se ha denegado el acceso a Salud. Puedes cambiarlo en Ajustes de iOS, dentro de Salud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’accès à Santé a été refusé. Tu peux le changer dans les Réglages iOS, sous Santé."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Health की अनुमति नहीं मिली। आप इसे iOS Settings में Health के तहत बदल सकते हैं।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'accesso a Salute è stato rifiutato. Puoi cambiarlo nelle Impostazioni di iOS, in Salute."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sağlık erişimi reddedildi. iOS Ayarları'nda, Sağlık altından değiştirebilirsin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康 App 权限被拒绝。你可以在 iOS 设置的健康中修改。"
          }
        }
      }
    },
