    "nutrition.adjust.approval": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nothing changes until you accept it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No cambia nada hasta que lo aceptes."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rien ne change tant que tu n’as pas accepté."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जब तक आप मंज़ूरी न दें, कुछ नहीं बदलेगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non cambia nulla finché non accetti."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "받아들이기 전에는 아무것도 바뀌지 않아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nic się nie zmieni, dopóki tego nie zaakceptujesz."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sen kabul etmeden hiçbir şey değişmez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在你接受之前，什么都不会改变。"
          }
        }
      }
    },
    "nutrition.adjust.ceilingReached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calories are already at %@ kcal, well above maintenance, so the app will not add any more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las calorías ya están en %@ kcal, bastante por encima del mantenimiento, así que la app no va a añadir más."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calories sont déjà à %@ kcal, bien au-dessus du maintien : l’app n’en ajoutera pas davantage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलोरी पहले ही %@ kcal पर हैं, जो मेंटेनेंस से काफ़ी ऊपर है, इसलिए ऐप और नहीं बढ़ाएगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calorie sono già a %@ kcal, ben sopra il mantenimento, quindi l'app non ne aggiungerà altre."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칼로리가 이미 유지 칼로리보다 한참 높은 %@ kcal이라 더 늘리지 않을게요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorie są już na poziomie %@ kcal, sporo powyżej podtrzymania, więc aplikacja nie doda więcej."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorin zaten %@ kcal, yani idamenin epey üstünde; uygulama daha fazlasını eklemez."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热量已经是 %@ kcal，远高于维持水平，App 不会再往上加。"
          }
        }
      }
    },
    "nutrition.adjust.decrease": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are changing about %@ kg a week against a target of %@ kg, so taking off %@ kcal a day should bring you back on track."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás cambiando unos %@ kg por semana frente a un objetivo de %@ kg, así que quitar %@ kcal al día debería devolverte al ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu évolues d’environ %@ kg par semaine pour un objectif de %@ kg : retirer %@ kcal par jour devrait te remettre sur les rails."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वज़न हर हफ़्ते करीब %@ kg बदल रहा है, जबकि लक्ष्य %@ kg है, इसलिए रोज़ %@ kcal घटाने से आप वापस पटरी पर आ जाएँगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai cambiando di circa %@ kg a settimana contro un obiettivo di %@ kg, quindi togliere %@ kcal al giorno dovrebbe rimetterti in linea."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주당 약 %@ kg씩 변하고 있고 목표는 %@ kg이에요. 하루 %@ kcal을 줄이면 다시 궤도에 오를 거예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniasz się o około %@ kg tygodniowo przy celu %@ kg, więc odjęcie %@ kcal dziennie powinno wrócić Cię na właściwy tor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada yaklaşık %@ kg değişiyorsun, hedef ise %@ kg; günde %@ kcal düşmek seni rotaya geri getirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你每周变化约 %@ kg，目标是 %@ kg，因此每天减少 %@ kcal 应该能回到正轨。"
          }
        }
      }
    },
    "nutrition.adjust.floorReached": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calories are already at %@ kcal, the lowest this app will recommend for you. Moving more is the better lever from here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las calorías ya están en %@ kcal, lo más bajo que esta app te recomendará. A partir de aquí, moverte más es la mejor palanca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les calories sont déjà à %@ kcal, le plus bas que cette app te recommandera. Bouger plus est le meilleur levier à partir d’ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कैलोरी पहले ही %@ kcal पर हैं, जो इस ऐप की आपके लिए सबसे कम सलाह है। यहाँ से ज़्यादा चलना-फिरना बेहतर रास्ता है।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le calorie sono già a %@ kcal, il minimo che quest'app ti consiglia. Da qui la leva migliore è muoverti di più."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "칼로리가 이미 앱이 권장하는 하한인 %@ kcal이에요. 여기서부터는 활동량을 늘리는 쪽이 더 나아요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorie są już na poziomie %@ kcal — najniższym, jaki ta aplikacja Ci poleci. Lepszą dźwignią jest teraz większy ruch."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalorin zaten %@ kcal; bu, uygulamanın senin için önereceği en düşük düzey. Buradan sonrası için daha çok hareket etmek daha iyi bir yol."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "热量已经是 %@ kcal，这是本 App 为你建议的下限。从这里开始，多活动才是更好的方向。"
          }
        }
      }
    },
    "nutrition.adjust.increase": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You are changing about %@ kg a week against a target of %@ kg, so adding %@ kcal a day should bring you back on track."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás cambiando unos %@ kg por semana frente a un objetivo de %@ kg, así que añadir %@ kcal al día debería devolverte al ritmo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu évolues d’environ %@ kg par semaine pour un objectif de %@ kg : ajouter %@ kcal par jour devrait te remettre sur les rails."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका वज़न हर हफ़्ते करीब %@ kg बदल रहा है, जबकि लक्ष्य %@ kg है, इसलिए रोज़ %@ kcal बढ़ाने से आप वापस पटरी पर आ जाएँगे।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Stai cambiando di circa %@ kg a settimana contro un obiettivo di %@ kg, quindi aggiungere %@ kcal al giorno dovrebbe rimetterti in linea."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주당 약 %@ kg씩 변하고 있고 목표는 %@ kg이에요. 하루 %@ kcal을 더하면 다시 궤도에 오를 거예요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zmieniasz się o około %@ kg tygodniowo przy celu %@ kg, więc dodanie %@ kcal dziennie powinno wrócić Cię na właściwy tor."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Haftada yaklaşık %@ kg değişiyorsun, hedef ise %@ kg; günde %@ kcal eklemek seni rotaya geri getirir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你每周变化约 %@ kg，目标是 %@ kg，因此每天增加 %@ kcal 应该能回到正轨。"
          }
        }
      }
    },
    "nutrition.adjust.insufficientData": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "There are not enough weigh-ins yet. About %@ readings across %@ days are needed before the app can tell a real trend from day-to-day noise."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no hay pesajes suficientes. Hacen falta unas %@ mediciones repartidas en %@ días para que la app distinga una tendencia real del ruido del día a día."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il n’y a pas encore assez de pesées. Il en faut environ %@ réparties sur %@ jours pour que l’app distingue une vraie tendance des variations quotidiennes."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी पर्याप्त वज़न रिकॉर्ड नहीं हैं। रोज़मर्रा के उतार-चढ़ाव और असली ट्रेंड में फ़र्क करने के लिए ऐप को करीब %@ रीडिंग चाहिए, %@ दिनों में फैली हुई।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non ci sono ancora abbastanza pesate. Ne servono circa %@ nell'arco di %@ giorni prima che l'app possa distinguere una vera tendenza dalle oscillazioni quotidiane."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체중 기록이 아직 부족해요. 하루하루의 흔들림과 진짜 추세를 구분하려면 약 %@회의 기록이 %@일에 걸쳐 필요해요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ważeń jest jeszcze za mało. Potrzeba około %@ pomiarów w ciągu %@ dni, żeby aplikacja odróżniła prawdziwy trend od codziennych wahań."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz yeterli tartım yok. Uygulamanın gerçek bir trendi günlük dalgalanmadan ayırabilmesi için yaklaşık %@ ölçüm ve %@ gün gerekiyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "体重记录还不够。大约需要 %@ 次记录、跨越 %@ 天，App 才能把真实趋势和日常波动区分开。"
          }
        }
      }
    },
    "nutrition.adjust.lowAdherence": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only about %@ of days were logged, so the trend cannot fairly be put down to your targets yet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se registró en torno al %@ de los días, así que todavía no es justo atribuir la tendencia a tus objetivos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seulement %@ des jours environ ont été enregistrés : la tendance ne peut pas encore être honnêtement attribuée à tes objectifs."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ करीब %@ दिन दर्ज हुए हैं, इसलिए इस ट्रेंड का श्रेय अभी आपके लक्ष्यों को देना ठीक नहीं होगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Hai registrato solo circa %@ dei giorni, quindi la tendenza non può ancora essere attribuita ai tuoi obiettivi."
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기록한 날이 약 %@뿐이라, 이 추세를 목표 때문이라고 보기는 아직 일러요."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisanych zostało tylko około %@ dni, więc trendu nie da się jeszcze uczciwie przypisać Twoim celom."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlerin yalnızca yaklaşık %@ kadarı kaydedilmiş; bu yüzden trendi hedeflerine bağlamak şimdilik doğru olmaz."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有约 %@ 的天数有记录，还不能把趋势归因于你的目标。"
          }
        }
      }
    },
    "nutrition.adjust.lowConfidence": {
      "extractionState": "manual",
      "localizations": {
