    "workoutHub.quickStart.noTemplatesMessage": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You have no program yet, so there is nothing to choose. An empty session works in the meantime."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todavía no tienes programa, así que no hay nada que elegir. Mientras tanto, una sesión vacía sirve."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu n’as pas encore de programme, il n’y a donc rien à choisir. Une séance vide fait l’affaire en attendant."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके पास अभी कोई प्रोग्राम नहीं है, इसलिए चुनने को कुछ नहीं। तब तक एक खाली सेशन काम चला देगा।"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non hai ancora un programma, quindi non c'è nulla da scegliere. Nel frattempo una sessione vuota va benissimo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你还没有训练计划，因此没有可选的内容。先用空白训练课也可以。"
          }
        }
      }
    },
